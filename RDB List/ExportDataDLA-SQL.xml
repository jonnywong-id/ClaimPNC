<pyBrowseSQL>select b.claimno AS "CaseID", b.nopolis AS "NoKTP", b.businessname AS "ClaimID",
b.qqname AS "ClaimNo",
a.nodla AS "Conveyance", to_char(a.tgldla,'dd/mm/yyyy') AS "Country", a. dlareinsurer AS "CountryID", 
a.noaksep AS "District", 
a.nilaidla as "Province", 
b.coinsname AS "Email",
to_char(b.dateofloss,'dd/mm/yyyy') as "RefNo",
to_char(b.registerdate,'dd/mm/yyyy') AS "Remark",
b.picteknik AS "RW",
a.revisi AS "NIK",
to_char(tgldla,'MM') as "Location",
A.NOAKSEP as "ContractNo",
(select to_char(tglakseptasi,'dd/mm/yyyy') from t_claim_adjustment where claimid=a.claimid and objectid=a.objectid and adjustmentid=a.adjustmentid)  AS "DistrictID"
from t_dlalist a, t_claim_pnc b
where a.claimid=b.claimid
and trunc(a.tgldla)&gt;=to_date ({TempLaporan.AnalystTransferDate},'dd/mm/yyyy') 
and trunc(a.tgldla)&lt;=to_date ({TempLaporan.DateOfLoss},'dd/mm/yyyy') 
{ASIS:TempLaporan.UserTeknis}
order by a.tgldla ASC</pyBrowseSQL>

<pyBrowseSQL>SELECT 
    A.pyID as "pyID",
    SUBSTR(A.PNCCASEID, INSTR(A.PNCCASEID, ' ') + 1) AS "CoverID",
    TO_DATE(TO_CHAR(A.PXCREATEDATETIME, 'dd/mm/yyyy'), 'DD/MM/YYYY') AS "TglKomite",
    A.PXCREATEDATETIME as "CreateDateTime",
    TRUNC(SYSDATE) - TO_DATE(TO_CHAR(A.PXCREATEDATETIME, 'dd/mm/yyyy'), 'DD/MM/YYYY') AS "AgingKomite",
    A.POLICYNO AS "NoPolis",
    A.pzInskey AS "pzInsKey",
    A.pyStatusWork AS "WorkStatus",
    A.BUSINESSNAME AS "NamaBisnis",  
    A.PNCCASEID AS "CoverInsKey",
    A.GROUPPANEL_1,
    A.SOBNAME AS "NamaSumbis",
    A.BRANCHNAME AS "BranchName",
    A.QQName AS "NamaTertanggung",
    AI.RESULTAI as "HasilAI",
    AI.NOTETERIMA as "NoteAITerima",
    AI.NOTETOLAK as "NoteAITolak"
FROM
    DATAPEGA.PC_ASM_FW_GCNMFW_Work A,
    DATAPEGA.pc_assign_worklist B,
    POOLDATA.T_CLAIM_DATA_RESULTS_AI AI
WHERE
    B."PXREFOBJECTKEY" = A."PZINSKEY"
    AND A."PXOBJCLASS" = 'ASM-FW-GCNMFW-Work-Komite'
    AND B."PXOBJCLASS" = 'Assign-Worklist'
    AND A.pyID = AI.KOMITE(+)
    AND B."PXASSIGNEDOPERATORID" ={TempKomite.RCLComment}
    AND A."PYSTATUSWORK" &lt;&gt; 'Resolved-Completed'
ORDER BY 
    "AgingKomite" DESC</pyBrowseSQL>

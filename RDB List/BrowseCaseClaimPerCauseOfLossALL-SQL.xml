<pyBrowseSQL>select lgb_note AS "SOBNAME", COL_DESC AS "REGISTERID",
SUM(
        CASE
        WHEN (stsklaim is not null ) 
        THEN 1
        ELSE 0
        END
       )
       AS "OLDPOLICYNO",
    SUM (
        CASE 
        WHEN (stsklaim = '3') 
        THEN 1
        ELSE 0
        END
        )
       AS "PRODKE",
    SUM (
        CASE
        WHEN (stsklaim = '1')
        THEN 1
        ELSE 0
        END
    ) AS "GROUPPANEL",
        SUM (
        CASE
        WHEN (stsklaim not in ('1','2','3'))
        THEN 1
        ELSE 0
        END
    ) AS "MARKETINGNAME",
    SUM (
        CASE
        WHEN (stsklaim = '3')
        THEN (ttlos)
        ELSE 0
        END)
       AS "FLAGEDMBATAL",
    SUM (
        CASE
        WHEN (stsklaim = '1')
        THEN (TTLAKSEP) 
        ELSE 0
        END)
       AS "BRANCHNAME",
    SUM (
        CASE
        WHEN (stsklaim not in ('1','2','3'))
        THEN (TTLOS)
        ELSE 0
        END)
       AS "EDMNO",
    SUM (
        CASE
        WHEN (stsklaim = '1')
        THEN ((TTLAKSEP+TTLOS)+(TTLOS-TTLAKSEP))
        WHEN (stsklaim not in ('1','2','3'))
        THEN (TTLAKSEP+TTLOS)
        ELSE 0 
        END)
       AS "FOLLOWEDPOLICY"                      
from POOLDATA.PEGA_DASHBOARDPNC
where 
{ASIS:TempData.ClaimNo}
{ASIS:TempPeriode.AnaylstRemarks}
and COL_DESC IS NOT NULL
GROUP BY COL_DESC, lgb_note
ORDER BY lgb_note ASC</pyBrowseSQL>

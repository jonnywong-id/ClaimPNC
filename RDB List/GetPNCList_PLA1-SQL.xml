<pyBrowseSQL>SELECT b.claimid AS "TSI",
         b.claimno AS "BRANCH_CODE",
         to_char(b.registerdate,'dd/mm/yyyy') AS "BUSINESS_NAME",
         to_char(b.dateofloss,'dd/mm/yyyy') AS "CURRENCY",  
         b.qqname AS "pyNote",
         b.nopolis AS "POLICY_NO",
         b.businessname AS "MARKETING",
         (select statusclaim_1 from datapega.pc_asm_fw_gcnmfw_work  where pzinskey=b.claimid) as "pyLabel",
         b.picteknik as "BRANCH_NAME",
         b.closeclaimnote as "CaseID",
         (select nopla from t_plalist  where b.claimid=claimid and 
          reinscode = (select reinsurerid from pooldata.t_reinsurer where login={OperatorID.pyUserIdentifier} order by reinsurerid desc fetch next 1 row only) order by revisi desc fetch next 1 row only) as "BUSINESS_CODE"
    FROM t_claim_pnc b
   WHERE   b.grouppanel not in('002','005')
         and b.STATUSWORK NOT IN ('Resolved-Completed', 'Resolved-Rejected')
         {ASIS:TempPLA.TSI}
         and exists ( select * from t_plalist a where a.claimid=b.claimid and a.iskirim='1' 
         and a.tglkirim is not null and a.emailpla is not null        
         and  not exists (select * from t_dlalist c where b.claimid=c.claimid 
         and c.tglkirim is not null and c.emaildla is not null
         and c.iskirim='1' and c.reinscode = (select reinsurerid from pooldata.t_reinsurer where login={OperatorID.pyUserIdentifier} order by reinsurerid desc fetch next 1 row only)) 
         and a.reinscode = (select reinsurerid from pooldata.t_reinsurer where login={OperatorID.pyUserIdentifier} order by reinsurerid desc fetch next 1 row only)
         )
order by b.claimno asc</pyBrowseSQL>

<pyBrowseSQL>select b.* 
from (select a.*, 
        rownum rn 
        from (SELECT A.PYID AS "CaseID",
       A.PZINSKEY AS "ClaimNo",
       A.POLICYNO AS "City",
       A.QQNAME AS "CityID",
       A.BUSINESSNAME AS "Country",
       A.SOBNAME AS "CountryID",
       A.BRANCHNAME AS "District",
       A.PXCREATEOPNAME AS "DistrictID",
       TO_CHAR (A.PXCREATEDATETIME, 'dd/mm/yyyy') AS "Province"
  FROM DATAPEGA.PC_ASSIGN_WORKLIST b, DATAPEGA.PC_ASM_FW_GCNMFW_WORK A
 WHERE     a.pxinsname = b.PXREFOBJECTINSNAME
       AND b.PXASSIGNEDOPERATORID = 'ServicePNC'
       AND A.PXOBJCLASS = 'ASM-FW-GCNMFW-Work-PNC'
      AND A.USERTEKNIS_1 IS NULL
      AND A.POLICYNO IS NOT NULL
{ASIS:TempCari.AlasanKlaim}) a 
) b 
where rn&gt;={ASIS:Pagination.FirstRow} and rn&lt;={ASIS:Pagination.LastRow}</pyBrowseSQL>

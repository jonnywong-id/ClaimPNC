<pyBrowseSQL>SELECT a.pic AS "PIC",
    count(a.noklaim) as "NOKLAIM",
    (select count(id_update) from pooldata.GCNM_PROGRESS_CLAIM c, pooldata.PEGA_DASHBOARDPNC b 
        where c.pnccaseid = b.noklaim and b.pic = c.USER_INPUT and b.pic = a.pic and c.USER_INPUT= a.pic  and upper(c.keterangan) not like 'AUTO%' {ASIS:TempBisnis.NOAKSEP}) as "NOAKSEP",
    (select count(c.next_followup) from pooldata.GCNM_PROGRESS_CLAIM c, pooldata.PEGA_DASHBOARDPNC b 
        where c.pnccaseid = b.noklaim  and b.pic = c.USER_INPUT and b.pic = a.pic and c.USER_INPUT=a.pic and b.stsklaim NOT IN ('1','2','3') AND b.stsklaim NOT IN ('1', '2', '3') and UPPER(c.keterangan) not like 'AUTO%' 
        {ASIS:TempBisnis.NOAKSEP} and to_char(c.next_followup, 'dd/mm/yyyy') = to_char(sysdate, 'dd/mm/yyyy') AND c.id_update = (SELECT MAX (r.id_update)
                                     FROM pooldata.GCNM_PROGRESS_CLAIM r
                                    WHERE c.pnccaseid = r.pnccaseid)) as "REINSURER",
    (select count(t.next_followup) from pooldata.GCNM_PROGRESS_CLAIM t, pooldata.PEGA_DASHBOARDPNC b 
        where t.pnccaseid = b.noklaim and b.pic = T.USER_INPUT and a.pic = b.pic and T.USER_INPUT=a.pic and upper(t.keterangan) not like 'AUTO%' {ASIS:TempBisnis.NOAKSEP} AND trunc(t.next_followup)+1 &gt;= (case when (SELECT (CASE
                                    WHEN TRUNC (rt.tgl_input) IS NOT NULL
                                    THEN
                                       rt.tgl_input
                                    ELSE
                                       TRUNC (SYSDATE)
                                 END)
                           FROM pooldata.gcnm_progress_claim rt
                          WHERE     rt.pnccaseid = t.pnccaseid
                                AND rt.id_update = t.id_update+1 ) is null then t.next_followup
                                else 
                                (SELECT (CASE
                                    WHEN TRUNC (rt.tgl_input) IS NOT NULL
                                    THEN
                                       rt.tgl_input
                                    ELSE
                                       TRUNC (SYSDATE)
                                 END)
                           FROM pooldata.gcnm_progress_claim rt
                          WHERE     rt.pnccaseid = t.pnccaseid
                                AND rt.id_update = t.id_update+1 ) end)) as "STSKLAIM",
    (select count(next_followup) from pooldata.GCNM_PROGRESS_CLAIM t, pooldata.PEGA_DASHBOARDPNC b 
        where t.pnccaseid = b.noklaim and b.pic = T.USER_INPUT and b.pic = a.pic and T.USER_INPUT=a.pic and upper(t.keterangan) not like 'AUTO%' {ASIS:TempBisnis.NOAKSEP} AND trunc(t.next_followup)+1 &lt; (select 
                                                (case
                                                    when trunc(rt.tgl_input) is not null
                                                    then rt.tgl_input
                                                    else trunc(sysdate)
                                                end) from pooldata.gcnm_progress_claim rt where rt.pnccaseid=t.pnccaseid and rt.id_update=t.id_update+1)) as "NOPOLIS"
FROM pooldata.PEGA_DASHBOARDPNC a
WHERE a.pic IS NOT NULL
and a.stsklaim NOT IN ('1','2','3')
and A.PIC in (select OPERATOR_ID from MST_USER_TEKNIK where TYPE_BUSINESS={TempBisnis.LGB_NOTE} and STS_AKTIF='1')
and a.pic !='ASNET'
{ASIS:TempBisnis.GROUP_PANEL}
{ASIS:TempBisnis.NOAKSEP}
{ASIS:TempBisnis.PIC}
GROUP BY a.pic</pyBrowseSQL>

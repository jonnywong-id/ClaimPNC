<pyBrowseSQL>select 
Sum(case when (B.STSTRANSFER = '3' 
        or B.STSTRANSFER = '5') then 1 else 0 end)  AS "CityID",
Sum(case when (B.STSTRANSFER = '4') then 1 else 0 end)  AS "Email",
Sum(case when (B.STSTRANSFER = '1') then 1 else 0 end)  AS "ClaimNo",
Sum(case when (B.STSTRANSFER in ('1', '6')) then 1 else 0 end)  AS "City",
Sum(case when (B.STSTRANSFER in ('7') and B.PIC={TempClaimAttach.UserAdmin}) then 1 else 0 end)  AS "EmailBroker"
 from POOLDATA.PNC_SALVAGE B
 where STSTRANSFER !='100'</pyBrowseSQL>

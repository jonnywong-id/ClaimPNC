<pyBrowseSQL>select b.* from (
select a.*, ROWNUM rn from (SELECT pzinskey AS "StatusLock", pyid AS "RCVID", pnccaseid AS "PNCCaseID", BUSINESSNAME AS "Kurir",
POLICYNO AS "PolicyNo", qqname AS "QQName", BookNo_1 as "Sender", 
DATEOFLOSS_1 AS "TglKejadian", STATUSLOCK_1,
pxcreatedatetime AS "pxCreateDateTime", pxcreateoperator as "KodeCabang", DateForAging_1 AS "DateForAging",
(SELECT C.BRANCHNAME FROM pooldata.BRANCH C, DATAPEGA.PC_ASM_FW_GCNMFW_WORK e WHERE e.KODECABANG_1=C.ID and  e.pyid=a.pyid) AS "UserAdmin",
kodecabang_1 AS "StatusKomunikasi"
FROM datapega.pc_asm_fw_gcnmfw_work a ,pooldata.business c, pooldata.businessgroup d  
WHERE pnccaseid IS NOT NULL and pxobjclass = 'ASM-FW-GCNMFW-Work-ReceiveDocument'  AND statusLock_1 IS NOT NULL
AND A.BUSINESSCODE_1 = c.id AND c.businessgroupid = d.id
AND A.PYSTATUSWORK NOT IN ('Resolved-Completed', 'Resolved-Rejected')
{ASIS:tempQuery.NoKTP}
{ASIS:tempQuery.pyNote}
{ASIS:tempQuery.Remark}
ORDER BY DateForAging_1 DESC ) a ) b
{ASIS:TempContents.NoteKasir}</pyBrowseSQL>

<pyBrowseSQL>SELECT BUSINESSCODE AS "CityID",
       BUSINESSNAME AS "City",
       GROUPPANEL AS "DistrictID",
       SOBNAME AS "NoteKasir",
       ( SELECT agt.oldid FROM pooldata.agent agt
          WHERE agt.ID = gen.sourceofbusiness
            AND agt.IsAsuradur = '0' ) AS "ID_MST",
       TO_CHAR(gen.startdate,'DD/MM/RRRR') AS "LOGSEEN",
       TO_CHAR(gen.enddate,'DD/MM/RRRR') AS "LOGSEARCH"        
  FROM POOLDATA.T_GENERAL gen
 WHERE NOPOLIS = {TempServices.CabId} AND ROWNUM=1</pyBrowseSQL>

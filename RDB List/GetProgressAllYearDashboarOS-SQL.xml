<pyBrowseSQL>WITH progress
     AS (  SELECT b2.pnccaseid, MAX (c.sts_progress1) AS sts_progress1
             FROM pooldata.gcnm_progress_posisi_pnc e
                  JOIN pooldata.gcnm_progress_claim b2
                     ON e.caseid = b2.pnccaseid
                  JOIN pooldata.gcnm_mst_progress_klaim c
                     ON b2.status_progress1 = c.id_progress
            WHERE e.statusposisi = 'On Progress'
         GROUP BY b2.pnccaseid)
  SELECT p.sts_progress1 AS "ParamLogic2",
         DECODE (NVL (d.reinsurer, g.leader_member),
                 '1', 'LEADER',
                 'LEADER', 'LEADER',
                 '2', 'MEMBER',
                 'MEMBER', 'MEMBER',
                 'F', 'FAC-IN',
                 'FAC IN', 'FAC-IN')
            AS "ParamLogic3",
         COUNT (*) AS "ParamLogic4",
       {ASIS:tempQuery.OLD_OPERATOR_ID}
    FROM datapega.pc_asm_fw_gcnmfw_work a
         JOIN datapega.pc_assign_worklist b
            ON a.pzinskey = b.pxrefobjectkey
         JOIN pooldata.t_claim_pnc g
            ON g.claimid = a.pzinskey
         JOIN pooldata.business f
            ON a.businesscode_1 = f.id
         LEFT JOIN pooldata.t_claim_objectlist k
            ON k.claimid = a.pzinskey
         LEFT JOIN pooldata.PEGA_DASHBOARDPNC d
            ON a.pyid = d.noklaim
         JOIN progress p
            ON p.pnccaseid = a.pyid
   WHERE     a.pxobjclass = 'ASM-FW-GCNMFW-Work-PNC'
         AND b.pxflowname NOT IN ('FixCorrespondence', 'Register_Flow_1')
         AND b.pxtasklabel NOT IN ('FixCorrespondence')
         AND a.userteknis_1 IS NOT NULL
         AND NVL (d.reinsurer, g.leader_member) IS NOT NULL
         {ASIS:tempQuery.TEAM_GROUP}
         {ASIS:tempQuery.EMAIL}
 {ASIS:tempFilter.District}
 {ASIS:tempFilter.Currency}
GROUP BY p.sts_progress1,
         DECODE (NVL (d.reinsurer, g.leader_member),
                 '1', 'LEADER',
                 'LEADER', 'LEADER',
                 '2', 'MEMBER',
                 'MEMBER', 'MEMBER',
                 'F', 'FAC-IN',
                 'FAC IN', 'FAC-IN')
ORDER BY p.sts_progress1,
         DECODE (NVL (d.reinsurer, g.leader_member),
                 '1', 'LEADER',
                 'LEADER', 'LEADER',
                 '2', 'MEMBER',
                 'MEMBER', 'MEMBER',
                 'F', 'FAC-IN',
                 'FAC IN', 'FAC-IN')</pyBrowseSQL>

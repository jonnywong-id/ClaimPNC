<pyBrowseSQL>DECLARE 
  TIDMASTER NUMBER;
  TNAMAPRINCIPAL VARCHAR2(32767);
  TTAHUN VARCHAR2(32767);
  TNILAIKLAIM NUMBER;
  TNILAIRECOVERY NUMBER;
  TPEMBAYARAN NUMBER;
  TSISA NUMBER;
  TKETERANGAN VARCHAR2(32767);
  TPOSISI VARCHAR2(32767);
  TDOKUMENID VARCHAR2(32767);
  TNOVA VARCHAR2(32767);
  TUSERNAME VARCHAR2(32767);
  TCLIENTID VARCHAR2(32767);
  TNOHPLL VARCHAR2(32767);
  TNOPOLIS VARCHAR2(32767);
  TLBUID VARCHAR2(32767);
  TLDCID VARCHAR2(32767);
  TLAGAGENID VARCHAR2(32767);
  TLMOID VARCHAR2(32767);

BEGIN 
  TIDMASTER := {TempRecovery.TOTAL};
  TNAMAPRINCIPAL := {TempRecovery.NamaPrincipal};
  TTAHUN := {TempRecovery.TreatyYear};
  TNILAIKLAIM := {TempRecovery.ClaimAmountAdjust};
  TNILAIRECOVERY := {TempRecovery.NilaiDeductible};
  TPEMBAYARAN := {TempRecovery.TotalListClaimAmountIDR};
  TSISA := {TempRecovery.TPLAmount};
  TKETERANGAN := {TempRecovery.Remark};
  TPOSISI := {TempRecovery.NoKTPMasking};
  TDOKUMENID :={TempRecovery.CoverageID};
  TNOVA := {TempRecovery.VirtualAccountNumber};
  TUSERNAME := {TempRecovery.UserTeknis};
  TCLIENTID := {TempRecovery.ClientID};
 TNOHPLL := {TempRecovery.Idlogservice};
TNOPOLIS := {TempRecovery.PolicyNo};
TLBUID := {TempRecovery.BusinessID};
  TLDCID := {TempRecovery.BranchID};
  TLAGAGENID := {TempRecovery.AgentID};
 TLMOID := {TempRecovery.MarketingID};

  POOLDATA.INSERTMASTERRECOVERYKLAIM ( TIDMASTER, TNAMAPRINCIPAL, TTAHUN, TNILAIKLAIM, TNILAIRECOVERY, TPEMBAYARAN, TSISA, TKETERANGAN, TPOSISI, TDOKUMENID,TNOVA, TUSERNAME, TCLIENTID, {TempRecovery.RCV_ID},TNOHPLL ,TNOPOLIS ,TLBUID ,TLDCID,TLAGAGENID ,TLMOID , {TempRecovery.Notes OUT});
  COMMIT; 
END;</pyBrowseSQL>

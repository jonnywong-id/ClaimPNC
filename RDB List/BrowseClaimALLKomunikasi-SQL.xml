<pyBrowseSQL>select b.* from (
select a.*, ROWNUM rn from (SELECT *
    FROM (SELECT A.PYID AS "PNCCaseID",
                 A.PZINSKEY AS "TypeOfClaim",
                 A.POLICYNO AS "PolicyNo",
                 A.QQNAME AS "QQName",
                 A.REGISTERDATE_1 AS "ReceivedDate",
                 A.DATEOFLOSS_1 AS "TglKejadian",
                 A.pxCreateDateTime AS "pxCreateDateTime",
                 BUSINESSNAME AS "JenisDokumen",
                 A.SOBNAME AS "RCVID",
                 BRANCHNAME AS "NumberOfDocument",
                 A.PXCREATEOPERATOR AS "Keterangan",
                 B.PXFLOWNAME AS "Kurir",
                 A.KODECABANG_1 AS "StatusKomunikasi",
                 A.DateForAging_1 AS "DateForAging",
            (SELECT kom.replymessage from pooldata.m_komunikasi_pnc kom where a.PNCCASEID=kom.caseid AND kom.komunikasistatus={tempQuery.ClaimNo} 
                 {ASIS:tempQuery.CaseID} order by kom.createdatereply desc fetch next 1 rows only) as "EmailPengirim"
            FROM DATAPEGA.PC_ASM_FW_GCNMFW_WORK A,
                 DATAPEGA.PC_ASSIGN_WORKLIST B
           WHERE B.PXREFOBJECTINSNAME = A.PYID
                 AND A.pxobjclass = 'ASM-FW-GCNMFW-Work-PNC'
                 AND A.PYSTATUSWORK NOT IN
                        ('Resolved-Completed', 'Resolved-Rejected')
                 {ASIS:TempView.UserAdmin}
                 AND EXISTS
                        (SELECT *
                           FROM pooldata.m_komunikasi_pnc kom
                          WHERE A.PNCCASEID = kom.caseid
                              AND kom.komunikasistatus={tempQuery.ClaimNo}
                              {ASIS:tempQuery.CaseID})
          UNION
          SELECT A.PYID AS "PNCCaseID",
                 A.PZINSKEY AS "TypeOfClaim",
                 A.POLICYNO AS "PolicyNo",
                 A.QQNAME AS "QQName",
                 A.REGISTERDATE_1 AS "ReceivedDate",
                 A.DATEOFLOSS_1 AS "TglKejadian",
                 A.pxCreateDateTime AS "pxCreateDateTime",
                 BUSINESSNAME AS "JenisDokumen",
                 A.SOBNAME AS "RCVID",
                 BRANCHNAME AS "NumberOfDocument",
                 A.PXCREATEOPERATOR AS "Keterangan",
                 B.PXFLOWNAME AS "Kurir",
                 A.DateForAging_1 AS "DateForAging",
                  (SELECT kom.replymessage from pooldata.m_komunikasi_pnc kom where A.pyid=kom.caseid AND kom.komunikasistatus={tempQuery.ClaimNo}
                                {ASIS:tempQuery.CaseID} order by kom.createdatereply desc fetch next 1 rows only) as "EmailPengirim"
            FROM DATAPEGA.PC_ASM_FW_GCNMFW_WORK A,
                 DATAPEGA.PC_ASSIGN_WORKLIST B,
                 pooldata.business c,
                 pooldata.businessgroup d
           WHERE     B.PXREFOBJECTINSNAME = A.PYID
                 AND A.pxobjclass = 'ASM-FW-GCNMFW-Work-ReceiveDocument'
                 AND A.BUSINESSCODE_1 = c.id
                 AND c.businessgroupid = d.id
                 AND A.PYSTATUSWORK NOT IN
                        ('Resolved-Completed', 'Resolved-Rejected')
                 AND A.PNCCASEID IS NULL
                 AND A.STATUSLOCK_1 = '1'
                 {ASIS:TempView.pyNote}
                 {ASIS:TempView.Remark}
                 AND EXISTS
                        (SELECT *
                           FROM pooldata.m_komunikasi_pnc kom
                          WHERE A.pyid = kom.caseid
                                AND kom.komunikasistatus={tempQuery.ClaimNo}
                                {ASIS:tempQuery.CaseID})) z
ORDER BY z."DateForAging" DESC) a ) b
where rn&gt;={ASIS:Pagination.FirstRow} and rn&lt;={ASIS:Pagination.LastRow}</pyBrowseSQL>

<pyBrowseSQL>SELECT
         a.claimid AS "TSI",
         a.claimno AS "BRANCH_CODE",
         to_char(a.registerdate,'dd/mm/yyyy') AS "BUSINESS_NAME",
         to_char(a.dateofloss,'dd/mm/yyyy') AS "CURRENCY",  
         a.qqname AS "pyNote",
         a.nopolis AS "POLICY_NO",
         a.businessname AS "MARKETING",
         (select statusclaim_1 from datapega.pc_asm_fw_gcnmfw_work  where pzinskey=a.claimid) as "pyLabel",
         a.picteknik as "BRANCH_NAME",
         a.closeclaimnote as "CaseID",
         (select nopla from pooldata.t_plalist  where a.claimid=claimid and 
          reinscode = (select reinsurerid from pooldata.t_reinsurer where login={OperatorID.pyUserIdentifier}) order by revisi desc fetch next 1 row only) as "BUSINESS_CODE"
FROM pooldata.t_claim_pnc a
WHERE a.STATUSWORK NOT IN ('Resolved-Completed', 'Resolved-Rejected')
 AND EXISTS 
                 (SELECT *
                  from pooldata.m_komunikasi_pnc c
                 where a.claimid=c.caseid 
                 and c.KOMUNIKASISTATUS={TempView.DistrictID} 
                {ASIS:TempView.District} )
{ASIS:tempQuery.UserTeknisEmail}
order by a.registerdate desc</pyBrowseSQL>

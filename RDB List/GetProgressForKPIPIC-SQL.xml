<pxObjClass>Rule-Connect-SQL</pxObjClass>
<pyBrowseSQL>SELECT a.PIC as "PIC",count(C.ID_UPDATE) as "NOAKSEP",
       sum(CASE
              WHEN
                     (
                              SELECT   t.tgl_input
                              FROM     pooldata.gcnm_progress_claim t
                              WHERE    t.pnccaseid=c.pnccaseid
                              AND      t.id_update&gt;c.id_update
                              ORDER BY t.id_update ASC FETCH next 1 row only) IS NULL THEN 1
              ELSE
                     CASE
                            WHEN trunc(c.next_followup)+1 &gt;=
                                             (
                                                      SELECT   trunc(t.tgl_input)
                                                      FROM     pooldata.gcnm_progress_claim t
                                                      WHERE    t.pnccaseid=c.pnccaseid
                                                      AND      t.id_update&gt;c.id_update
                                                      ORDER BY t.id_update ASC FETCH next 1 row only) THEN 1
                            ELSE 0
                     END
       END) AS "STSKLAIM"
FROM   pooldata.gcnm_progress_claim c,
       pooldata.pega_dashboardpnc a
WHERE  c.pnccaseid = a.noklaim and A.STSKLAIM not in ('1','2','3')
AND    upper(c.keterangan) NOT LIKE '%AUTO%'
and upper(c.keterangan) NOT LIKE '%SYSTEM%'
AND    a.pic = c.user_input
{ASIS:TempBisnis.PIC}
AND    a.pic != 'ASNET'
{ASIS:TempBisnis.PROD_KE}
{ASIS:TempBisnis.GROUP_PANEL}
group by a.pic</pyBrowseSQL>

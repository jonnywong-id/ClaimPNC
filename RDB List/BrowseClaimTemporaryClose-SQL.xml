<pyBrowseSQL>SELECT z.*
          FROM (SELECT a.pyID as "ClaimNo",
       a.pzinskey as "CaseID",
       a.policyno as "District",
       a.qqname as "CountryID",
       A.BUSINESSNAME as "Country",
       a.sobname as "CityID",
       a.branchname as "City",
       a.pxcreateopname as "ReporterName",
       a.pxCreateDateTime as "pxCreateDateTime",
       a.dateofloss_1 as "DateOfLoss",
       a.statusclaim_1 as "StatusClaim",
       CASE 
            WHEN a.DateForAging_1 is null THEN a.pxCreateDateTime  
            WHEN a.DateForAging_1 is not null THEN a.DateForAging_1  
       END AS "DateForAging",
       (select leader_member from pooldata.t_claim_pnc where claimid=a.pzinskey) as "IsPLA",
	  ROW_NUMBER () OVER (ORDER BY a.pxcreatedatetime  desc) AS "rn"
  FROM datapega.pc_asm_fw_gcnmfw_work a
 WHERE     a.pxobjclass = 'ASM-FW-GCNMFW-Work-PNC'
       AND a.ISPENDINGCLOSE = 'true'
       AND a.userteknis_1 IN {ASIS:TempOperator.CityID}
       {ASIS:TempSearch.source}) z
 WHERE "rn" &gt;= {ASIS:Pagination.FirstRow}  AND "rn" &lt;=  {ASIS:Pagination.LastRow}</pyBrowseSQL>

<pyBrowseSQL>select b.* 
from (select a.*, rownum rn 
        from (SELECT a.PYID AS "CaseID",
         a.PZINSKEY AS "ClaimNo",
         a.POLICYNO AS "CityID",
         a.QQNAME AS "Country",
         a.REFNO_1 AS "Province",
         (select pyid from datapega.pc_asm_fw_gcnmfw_work where a.CASEID_1=pzinskey and pxobjclass='ASM-FW-GCNMFW-Work-PNC') AS "NamaDokterRCL",
         a.pxCreateDateTime AS "LossCoverage",
         a.SURVEYORNAME_1 AS "CountryID",
         a.USERTEKNIS_1 AS "District",
         a.RescheduleLocation_1 AS "DistrictID",
         a.AdjusterStatus_1 AS "ProvinceID",
         a.PYSTATUSWORK AS "NamaSurveyor",
         a.AdjusterPIC_1 as "City"
    FROM DATAPEGA.PC_ASM_FW_GCNMFW_WORK A
   WHERE     A.pxobjclass = 'ASM-FW-GCNMFW-Work-SurveyClaim'
         AND A.PYSTATUSWORK NOT IN ('Resolved-Completed', 'Resolved-Rejected')
         AND A.SURVEYORTYPE_1 = '2'       
         AND EXISTS
                (SELECT *
                 FROM datapega.pc_asm_fw_gcnmfw_work z,
                            datapega.pc_assign_worklist b,
                            pooldata.business c,
                            pooldata.businessgroup d
                 WHERE z.pxobjclass = 'ASM-FW-GCNMFW-Work-PNC'
                      AND z.pzInsKey = b.pxrefobjectkey
                      AND z.BUSINESSCODE_1 = c.id
                      AND c.businessgroupid = d.id
                      AND z.branchname!='ASNET'
                      AND b.pxflowname not in ('FixCorrespondence', 'Register_Flow_1') 
                      AND b.PXTASKLABEL not in ('FixCorrespondence')
                      AND a.caseid_1 = z.pzinskey
                     {ASIS:TempView.pyNote})  
         {ASIS:TempSearch.Province}
ORDER BY a.pxCreateDateTime ASC) a 
) b 
where rn&gt;={ASIS:Pagination.FirstRow} and rn&lt;={ASIS:Pagination.LastRow}</pyBrowseSQL>

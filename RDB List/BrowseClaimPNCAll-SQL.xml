<pyBrowseSQL>SELECT distinct pyid AS "ClaimNo", REFNO_1 as "RefNo", pzinskey AS "CaseID", dateofloss_1 AS "DateOfLoss", REGISTERDATE_1 AS "RegisterDate", 
policyno AS "ProvinceID", qqname AS "ReporterName", businessname AS "ReportAddress", branchname AS "ReportDescription", 
CASE
    WHEN pystatuswork = 'Resolved-Rejected' THEN 'Ditolak'
    WHEN adj.tglbayar is not null THEN 'Sudah Dibayar'
    ELSE 'Sedang Proses'
END AS "StatusClaim"
  FROM datapega.pc_asm_fw_gcnmfw_work pc left join pooldata.t_claim_adjustment adj
  ON pc.pzinskey = adj.claimid
 WHERE pxobjclass = 'ASM-FW-GCNMFW-Work-PNC' 
AND dateofloss_1 IS NOT NULL 
      AND policyno IS NOT NULL 
      AND REGISTERDATE_1 IS NOT NULL 
      AND qqname IS NOT NULL
      AND Businessname IS NOT NULL
{ASIS:TempSearch.Policy.OldPolicyNo}
{ASIS:TempSearch.Policy.SourcePolicyNo}</pyBrowseSQL>

<pyBrowseSQL>SELECT x.policyno AS "PolicyNo",
       x.accumulationcode as "AccumulationCode",
       x.treatyyear as "TreatyYear",
       x.reinsurancetypeid as "ReinsuranceTypeID",
       to_char(TO_DATE (x.adjustmentdate, 'DD-MM-YY'),'YYYYMMDD') AS "AdjusmentDate",
       to_char(TO_DATE (x.endaccumulationdate, 'DD-MM-YY'),'YYYYMMDD') AS "EndAccumulationDate",
       x.accumulationadjustment as "AccumulationAdjustment",
       x.outteradjustment as "OutterAdjustment",
       y.jsondata.AccumulationName as "AccumulationName",
       y.jsondata.Note as "Note",
       y.jsondata.ZipCode as "ZipCode",
       z.jsondata.CurrencyValue as "CurrencyValue",
       (select note from reinsurancetype where id = x.reinsurancetypeid) as "ReinsuranceTypeName"
  FROM POOLDATA.ACCUMULATION_ADJUSTLIST x,
       POOLDATA.m_accumulation y,
       POOLDATA.m_riskaccumulation z
 WHERE     x.accumulationcode = y.id
       AND z.accumulationcode = y.id
       AND x.accumulationcode = {InputData.AccumulationCode}
       AND z.treatyyear = x.treatyyear
       AND z.reinsurancetypeid = x.reinsurancetypeid</pyBrowseSQL>

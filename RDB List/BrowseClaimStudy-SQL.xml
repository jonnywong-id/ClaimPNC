<pyBrowseSQL>select A.NOPOLIS AS "NoKTP", A.NOKLAIM  AS "CaseID", A.THNREGIS AS "AnalystTransferDate" ,A.COL_DESC as "Country", 
A.CABANG as "AnalystRemaksInvestigator", to_char(A.DATEOFLOSS,'dd/mm/yyyy') AS "DateOfLoss",to_char(b.REGISTERDATE,'mm') as "Email",A.TSI as "AlasanDokterRejectRCL",
CASE when a.stsklaim = '0' then 'Claim On Progress' 
     when a.stsklaim = '1' then 'Accepted'
     when a.stsklaim = '3' then 'Ditolak'
     else '-'
end as "ClaimNo",
case when a.reinsurer='2' then 'Member' 
    when a.reinsurer='F' then 'Fac In' 
    when a.reinsurer='1' then 'Leader' 
    else '-'
end AS "AgingAmount", B.QQNAME  as "NamaSurveyor", B.SOBNAME as "CityID", 
B.REMARKRECOMENDATION as "AnaylstRemarks", D.NOTE as"City",b.KRONOLOGI as "LokasiSurveyor",
(select max(ASM_SHARE) from pooldata.t_claim_adjustment where claimid = b.claimid)as "AlasanTerlambat",
(select sum(TOTAL_CLAIM* CURRENCYVALUE) from pooldata.t_claim_adjustment where claimid = b.claimid )as "ComplianceRemark",
(select sum(GROSSVALUE* CURRENCYVALUE) from pooldata.t_claim_adjustment where claimid = b.claimid )as "Conveyance",
(select sum(INDIVIDUAL_RISK_VALUE* CURRENCYVALUE) from pooldata.t_claim_adjustment where claimid = b.claimid )as "CloseClaimNote",
(select sum((TOTAL_CLAIM* CURRENCYVALUE) * (ASM_SHARE/100)) from pooldata.t_claim_adjustment where claimid = b.claimid )as "CommentKomiteClosecase",
(select sum((nvl(LOC,0)/100)* TOTAL_CLAIM* CURRENCYVALUE) + sum(nvl(NILAI_SALVAGE_A* CURRENCYVALUE,0)) from pooldata.t_claim_adjustment where claimid = b.claimid )as "CompliancePosAuditByr",
(select sum(TOTAL_CLAIM* CURRENCYVALUE)-sum(INDIVIDUAL_RISK_VALUE* CURRENCYVALUE)-sum((nvl(LOC,0)/100)* TOTAL_CLAIM* CURRENCYVALUE) + sum(nvl(NILAI_SALVAGE_A* CURRENCYVALUE,0))-sum(GROSSVALUE*CURRENCYVALUE) from pooldata.t_claim_adjustment where claimid = b.claimid )as "UserName",
(select to_number(sum(TOTAL_CLAIM* CURRENCYVALUE)-sum(INDIVIDUAL_RISK_VALUE* CURRENCYVALUE)-sum((nvl(LOC,0)/100)* TOTAL_CLAIM* CURRENCYVALUE) + sum(nvl(NILAI_SALVAGE_A* CURRENCYVALUE,0))-sum(GROSSVALUE* CURRENCYVALUE)) * max(ASM_SHARE/100) from pooldata.t_claim_adjustment where claimid = b.claimid )as "UserTeknis"
from POOLDATA.PEGA_DASHBOARDPNC a, POOLDATA.T_CLAIM_PNC b, pooldata.business d
where EXISTS (select substr(claimid,20,29) from pooldata.t_claim_adjustment where total_claim*currencyvalue&gt;5000000000 and claimid=b.claimid) 
and A.THNREGIS
BETWEEN to_char(to_date({TempSearch.TelpTertanggung},'dd/mm/yyyy'), 'yyyy') 
AND to_char(to_date({TempSearch.UserTeknisEmail},'dd/mm/yyyy'),'yyyy')
and a.noklaim=b.claimno
and b.claimno IS NOT NULL
and B.BUSINESSCODE= D.ID
{ASIS:TempView.City} {ASIS:TempSearch.UserTeknis}</pyBrowseSQL>

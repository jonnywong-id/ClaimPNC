<pyBrowseSQL>SELECT SUM (maxTSI) AS HASIL1,
         SUM (sumPremi) AS HASIL2,
         SUM (sumDiscount) AS HASIL5
    FROM (  SELECT MAX (to_number(TSI)) AS maxTSI,
                   SUM (to_number(PREMIUM)) AS sumPremi,
                   SUM (to_number(DISCOUNT)) AS sumDiscount
              FROM POOLDATA.t_coveragelistperson
             WHERE idpega =  {InputData.CARI1} AND FLAGDELETE &lt;&gt; '1'
          GROUP BY INDEXOBJECT)</pyBrowseSQL>

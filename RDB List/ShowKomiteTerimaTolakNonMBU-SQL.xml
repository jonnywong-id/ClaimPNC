<pyBrowseSQL>SELECT 
    pyId AS "pyID",
    SUBSTR(PNCCASEID, INSTR(PNCCASEID, ' ') + 1) AS "NoKlaim",
     pzInsKey as "pzInsKey",
   PNCCASEID AS "CoverInsKey",
    	 POLICYNO AS "NoPolis",
    	   PYRESOLVEDTIMESTAMP as "TglKomite",
    	   BUSINESSNAME as "NamaBisnis",
    	   BRANCHNAME as "BranchName",
    	   SOBNAME  as "NamaSumbis",
    	   QQName as "NamaTertanggung",
(select BUSINESSGROUPNAME from pooldata.BUSINESSNEW where id=(select BUSINESSCODE from pooldata.T_CLAIM_PNC where claimid=PNCCASEID)) as "BUSINESSNAME",
       Case when (select max(TYPEKOMITE) from POOLDATA.T_CLAIM_KOMITE_LIST where KOMITE_ID=pyId)='2' then
       case when (select max(PAYMENTTYPE) from POOLDATA.T_CLAIM_KOMITE_LIST x where X.KOMITE_ID=pyId)=1 then 'Final'
             when (select max(PAYMENTTYPE) from POOLDATA.T_CLAIM_KOMITE_LIST x where X.KOMITE_ID=pyId)=2 then 'Interim'
             when (select max(PAYMENTTYPE) from POOLDATA.T_CLAIM_KOMITE_LIST x where X.KOMITE_ID=pyId)=3 then 'Salvage'
             when (select max(PAYMENTTYPE) from POOLDATA.T_CLAIM_KOMITE_LIST x where X.KOMITE_ID=pyId)=4 then 'Adjuster Fee'
             when (select max(PAYMENTTYPE) from POOLDATA.T_CLAIM_KOMITE_LIST x where X.KOMITE_ID=pyId)=5 then 'Adjustment'
             when (select max(PAYMENTTYPE) from POOLDATA.T_CLAIM_KOMITE_LIST x where X.KOMITE_ID=pyId)=6 then 'Tolak Klaim'
             else 'Collection Fee' end
        when (select max(TYPEKOMITE) from POOLDATA.T_CLAIM_KOMITE_LIST where KOMITE_ID=pyId)='1' then 'Survey Komite'
        when (select max(TYPEKOMITE) from POOLDATA.T_CLAIM_KOMITE_LIST where KOMITE_ID=pyId)='3' then 'Ex Gratia'
        when (select max(TYPEKOMITE) from POOLDATA.T_CLAIM_KOMITE_LIST where KOMITE_ID=pyId)='4' then 'Liable Klaim'
        when (select max(TYPEKOMITE) from POOLDATA.T_CLAIM_KOMITE_LIST where KOMITE_ID=pyId)='5' then 'Final'                     
       else 'Survey Komite' end
        as "StatusKlaim",
(select max(X.NOTEKOMITE) from POOLDATA.T_CLAIM_KOMITE_LIST x where X.KOMITE_ID=A.PYID and STATUSAPPROVE={TempKomiteInput.AlasanKlaim} and namakomite={TempKomite.RCLComment}) as "RejectedCode",
(select max(X.NILAIKLAIM) from POOLDATA.T_CLAIM_KOMITE_LIST x where X.KOMITE_ID=A.PYID)* (select max(X.SHAREASM) from POOLDATA.T_CLAIM_KOMITE_LIST x where X.KOMITE_ID=A.PYID)/100 as "IBNR",
(select max(X.NILAIKLAIM) from POOLDATA.T_CLAIM_KOMITE_LIST x where X.KOMITE_ID=A.PYID)*(select (PRSN_OR+PRSN_ORS+PRSN_PSRQS_OR+PRSN_FSPLNSOR+PRSN_PSPLNSOR+PRSN_PSPLNSOR) from POOLDATA.PEGA_DASHBOARDPNC pg where PG.NOKLAIM=SUBSTR (PNCCASEID, INSTR (PNCCASEID, ' ') + 1))/100 as "pyScore",
(select PICTEKNIK from POOLDATA.T_CLAIM_PNC where claimid=PNCCASEID) as "DraftWordingID"
FROM 
    DATAPEGA.PC_ASM_FW_GCNMFW_WORK a
WHERE 
pxobjclass='ASM-FW-GCNMFW-Work-Komite' and STATUSCASE_1={TempKomiteInput.AlasanKlaim} and
PYRESOLVEDUSERID={TempKomite.RCLComment}
{ASIS:TempKomiteInput.CauseOfLoss}</pyBrowseSQL>

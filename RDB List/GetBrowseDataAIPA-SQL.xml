<pyBrowseSQL>select idpega as "CaseID",nopolis as "PolicyNo",
(select QQNAME from T_CLAIM_PNC r where r.claimid=A.IDPEGA) as "City",
(select BUSINESSNAME from T_CLAIM_PNC r where r.claimid=A.IDPEGA) as "COB",TO_DATE(SUBSTR(DateOfLoss,1,8),'yyyymmdd') as "CityID",
(select to_char(startdate,'dd/mm/yyyy') from T_GENERAL y where y.nopolis = a.nopolis fetch next 1  row only) as "Country",
(select to_char(ENDDATE,'dd/mm/yyyy') from T_GENERAL y where y.nopolis = a.nopolis fetch next 1  row only)  as "CountryID",
ResultAI as "AlasanKlaim",
COVERAGE_AI_FINAL as "NoteKasir",CAUSE_OF_LOSS_AI as "FlagASO",CoverageKronologi as "CABANG",pyNote as "District",
case when pyLabel='1' then 'Note Terima' else 'Note Tolak' end as "DistrictID"
from pooldata.json_klaim a,
JSON_TABLE(A.DATA_JSONBLOB,'$' columns(Location varchar2 path '$.Location',DateOfLoss varchar2 path '$.DateOfLoss',ReportDescription varchar2 path '$.ReportDescription',
StartDateTime varchar2(2) path '$.PolicyData.StartDateTime',QQName varchar2(2) path '$.PolicyData.QQName',BusinessName varchar2(2) path '$.Policy.Quotation.BusinessName',
EndDateTime varchar2(2) path '$.PolicyData.EndDateTime',nested path '$.ObjectList[*]' columns(ObjectName varchar2 path '$.ObjectName',ObjectDateOfBirth varchar2 path '$.ObjectDateOfBirth', 
nested path '$.ObjectCoverageList[*]' columns(CoverageNote varchar2 path '$.CoverageNote',Remarks varchar2 path '$.Remarks',
nested path '$.AdjustmentList[*]' columns(AcceptanceStatus varchar2 path '$.AcceptanceStatus',
CAUSE_OF_LOSS_AI varchar2 path '$.CAUSE_OF_LOSS',ResultAI varchar2 path '$.ResultAI',COVERAGE_AI_FINAL varchar2 path '$.COVERAGE_AI_FINAL',
CoverageKronologi varchar2 path '$.CoverageKronologi',BatasLapor varchar2 path '$.BatasLapor',BatasUmur varchar2 path '$.BatasUmur',nested path '$.NotesAI[*]' columns(pyNote varchar2 path'$.pyNote',pyLabel varchar2 path '$.pyLabel')))))) where a.idpega in 
(select 'ASM-FW-GCNMFW-WORK '||case when serviceid like '%/%' then NVL(SUBSTR(serviceid, 0, INSTR(serviceid, '/')-1), serviceid) else serviceid end from POOLDATA.CLAIM_SERVICE_LOG where categoryservice='RESULT AI PA' ) order by A.IDPEGA desc</pyBrowseSQL>

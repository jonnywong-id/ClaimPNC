<pyBrowseSQL>SELECT BUSINESSID AS OLD_ID,
         DOCUMENT_TYPE_ID AS DOC_TYPE_ID,
         OBJECT_DOC_ID AS OBJ_DOC,
         DOC_TYPE_DT_ID AS ID,
         DETAIL_DOKUMEN AS DETAIL_DOCUMENT,
         CASE
            WHEN sts_wajib = '0'
            THEN
               'Tidak'
            WHEN sts_wajib = '1' AND (select count(a.coverageid) from pooldata.coverage_doc_business a where a.id=b.id and a.businessid=b.businessid and coverageid in ({ASIS:TempParam.BRANCH_NAME}))&gt;0
            THEN
               'Ya'
            WHEN     sts_wajib = '1' AND  (select count(a.coverageid) from pooldata.coverage_doc_business a where a.id=b.id and a.businessid=b.businessid and coverageid in ({ASIS:TempParam.BRANCH_NAME}))=0
            THEN
               'Tidak'
         END
            AS sts_wajib,
         0 AS RISK,
         MIN_DOC AS MIN_DOC
    FROM pooldata.lst_type_doc_business b
   WHERE     b.BUSINESSID = {TempParam.BUSINESS_CODE}
         AND (SELECT a.type_document
                FROM pooldata.v_lst_doc_type a
               WHERE a.id = b.DOCUMENT_TYPE_ID AND a.type_document = {TempParam.CURRENCY})
                IS NOT NULL
         AND (b.DETAIL_DOKUMEN != '-')
ORDER BY b.DETAIL_DOKUMEN ASC</pyBrowseSQL>

<pyBrowseSQL>SELECT TO_CHAR (A.CREATEDATETIME, 'YYYY-MM') AS "MARKETINGCODE",
         COUNT (A.COVERAGEID) AS "SOBNAME",
         SUM(B.GROSSVALUE) AS "POLICYDECLARATIONNO"
    FROM POOLDATA.T_CLAIM_OBJECTCOVERAGE A, POOLDATA.T_CLAIM_ADJUSTMENT B
   WHERE A.CLAIMID = B.CLAIMID AND A.COVERAGEID NOT in ('10003', '10004', '10005','10007')
         AND to_char(a.CREATEDATETIME, 'yyyy-mm') 
BETWEEN to_char(to_date({TempLaporan.TelpTertanggung},'dd/mm/yyyy'), 'yyyy-mm') 
AND to_char(to_date({TempLaporan.UserTeknisEmail},'dd/mm/yyyy'),'yyyy-mm')
GROUP BY TO_CHAR (A.CREATEDATETIME, 'YYYY-MM') ORDER BY TO_CHAR(A.CREATEDATETIME,'YYYY-MM')</pyBrowseSQL>

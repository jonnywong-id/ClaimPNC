<pyBrowseSQL>select b.* from (
select a.*, ROWNUM rn from (select a.pyid AS "RCVID", a.pzinskey AS "StatusLock", a.pnccaseid AS "PNCCaseID", a.policyno AS "PolicyNo", a.BUSINESSNAME AS "Kurir", 
a.qqname AS "QQName", b.dateofloss AS "TglKejadian", a.pxcreatedatetime as "pxCreateDateTime",
pxcreateoperator AS "KodeCabang", DateForAging_1 AS "DateForAging",
(SELECT C.BRANCHNAME FROM pooldata.BRANCH C, DATAPEGA.PC_ASM_FW_GCNMFW_WORK e WHERE e.KODECABANG_1=C.ID and  e.pyid=a.pyid) AS "UserAdmin",
a.kodecabang_1 AS "StatusKomunikasi"
from datapega.pc_asm_fw_gcnmfw_work a, pooldata.t_claim_pnc b, pooldata.business c, pooldata.businessgroup d   
where a.pxobjclass='ASM-FW-GCNMFW-Work-ReceiveDocument'
AND A.BUSINESSCODE_1 = c.id AND c.businessgroupid = d.id
and a.pnccaseid=b.claimno
and a.PNCCASEID IS NOT NULL
and b.statuswork='Resolved-Rejected'
{ASIS:tempQuery.NoKTP}
{ASIS:tempQuery.pyNote}
{ASIS:tempQuery.Remark}
ORDER BY a.DateForAging_1 DESC ) a ) b
{ASIS:TempContents.NoteKasir}</pyBrowseSQL>

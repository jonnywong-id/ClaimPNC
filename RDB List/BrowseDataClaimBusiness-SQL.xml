<pyBrowseSQL>SELECT noklaim AS "ClaimNo",
       a.nopolis AS "PolicyNo",
       TO_CHAR (begindate, 'dd/mm/yyyy') AS "City",
       TO_CHAR (enddate, 'dd/mm/yyyy') AS "CityID",
       TO_CHAR (tgl_proses, 'dd/mm/yyyy') AS "Country",
       TO_CHAR (dateofloss, 'dd/mm/yyyy') AS "CountryID",
       pic AS "UserTeknis",
       tsi AS "TKI",
       ttlos AS "CaseID",
       ttlaksep AS "RefNo",
       sobname as "SIM",
       CASE
            WHEN STSKLAIM='3' OR STSKLAIM='2'
                 THEN 'REJECT'
            WHEN STSKLAIM='1'
                 THEN 'CLOSE'
            WHEN STSKLAIM='0' OR STSKLAIM IS NULL
                 THEN 'OS'
       END AS "StatusClaim",
    (SELECT  c.TELFAXNUMBER FROM t_mclienttelfax c, JSON_POLIS d WHERE (c.CLIENTID = d.DATA_JSONBLOB.CIFData.Customer_P.ASMClientID 
        OR  c.CLIENTID = d.DATA_JSONBLOB.CIFData.Customer_C.ASMClientID)
    AND d.NOPOLIS =a.nopolis AND c.TELFAXTYPE ='4' AND replace(d.PRODKE,' ','') =replace(a.prod_ke,' ','')) as "NewTelpTertanggung",
    (SELECT  c.TELFAXNUMBER FROM t_mclienttelfax c, JSON_POLIS d WHERE (c.CLIENTID = d.DATA_JSONBLOB.CIFData.Customer_P.ASMClientID 
        OR  c.CLIENTID = d.DATA_JSONBLOB.CIFData.Customer_C.ASMClientID)
    AND d.NOPOLIS =a.nopolis AND c.TELFAXTYPE ='6' AND replace(d.PRODKE,' ','') =replace(a.prod_ke,' ','')) as "NewEmail"
FROM pooldata.pega_dashboardpnc a
where EXISTS
              (SELECT *
                 FROM pooldata.t_claim_pnc
                WHERE businesscode = {TempLaporan.CountryID} AND claimno = a.noklaim)</pyBrowseSQL>

<pyBrowseSQL>select  to_clob(DATA_JSONBLOB) as TSI, NOSPAK as BRANCH_CODE, a.PRODKE as BRANCH_NAME
from json_polis a, T_general b where a.nopolis =  {TempPolis.PolicyNo} and (b.EDMType not in ('1', '2') or b.edmtype is null) and a.nopolis = b.nopolis and a.prodke=b.prodke and a.prodke = {TempPolis.ProdKe} order by cast(a.prodke AS INT) desc fetch next 1 rows only</pyBrowseSQL>

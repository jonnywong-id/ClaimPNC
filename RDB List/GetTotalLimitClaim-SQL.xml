<pyBrowseSQL>SELECT SUM (c.nilaiakseptasi * c.currencyvalue) as "ClaimAmount"
  FROM pooldata.t_claim_pnc a,
       pooldata.t_claim_objectcoverage b,
       pooldata.t_claim_adjustment c
 WHERE     a.claimid = b.claimid
       AND b.claimid = c.claimid
       AND b.objectid = c.objectid
       AND b.objectcoverageid = c.objectcoverageid
       AND statusakseptasi IN ('0', '1')
       AND a.nopolis = {TempValueAdj.ObjectIndex}
       AND b.coverageid = {TempValueAdj.ObjectName}
       AND b.objectid = {TempValueAdj.IDObject}</pyBrowseSQL>

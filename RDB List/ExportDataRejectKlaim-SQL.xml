<pyBrowseSQL>SELECT d.claimno AS "CaseID",
         d.nopolis AS "NoKTP",
         d.qqname AS "ClaimID",
         d.businessname AS "ClaimNo",
         CLOSECLAIMNOTE AS "CityID",
         d.picteknik AS "Conveyance",
         d.businesscode AS "City",
         TO_CHAR (d.registerdate, 'dd/mm/yyyy') AS "Country",
         TO_CHAR (d.dateofloss, 'dd/mm/yyyy') AS "CountryID",
         TO_CHAR (d.closeclaimdate, 'dd/mm/yyyy') AS "Email",
         SUBSTR (d.closeclaimdate, 4, 3) AS "FlagASO",
         (SELECT SUM (X.ESTIMATIONVALUE * X.KURSVALUE)
            FROM T_CLAIM_ESTIMASI x
           WHERE X.CLAIMID = d.CLAIMID)
            AS "Resources",
         a.SHARE_ASM AS "ClaimAmount"
            ,(PRSN_OR+PRSN_ORS+PRSN_PSRQS_OR+PRSN_FSPLNSOR+PRSN_PSPLNSOR+PRSN_PSPLNSOR) AS "OwnRisk",
            a.own_retension AS "ExGratiaNote",
       a.coins AS "FlagReject",
       a.psrspl AS "InsuredRelationship",
       a.qs_ri AS "PolicyObjectLocationRWNote",
       a.er1 AS "IsBackCFS",
       a.er2 AS "IsCFS_PNC",
       a.surplus1 AS "isComplianceTransfer",
       a.surplus2 AS "IsTransferAnalisator",
       a.psrqs_ri AS "IsTransferPIC",
       a.psrqs_or AS "InsuredRelationshipOthers",
       a.ors AS "KomiteStatus",
       a.facultative AS "District",
       a.facobl AS "LokasiSurveyor",
       a.bppdan AS "LossCoverage",
       a.xl AS "NamaDokumen",
       a.pss AS "NamaSurveyor",
       a.prgbi AS "NIK",
       a.fespl AS "AnalystRemaksInvestigator",
       D.REPORTERNAME AS "ReceiverClaim",
       a.pfra AS "ProdKe",PRSN_FAC_OUT as "AlasanDokterRejectRCL"
    FROM pooldata.t_claim_pnc d, POOLDATA.PEGA_DASHBOARDPNC a
   WHERE     d.statuswork IN ('Resolved-Rejected')
and d.CLAIMNO = a.NOKLAIM
{ASIS:TempLaporan.UserTeknis}
and trunc(d.closeclaimdate)&gt;=to_date ({TempLaporan.AnalystTransferDate},'dd/mm/yyyy') 
and trunc(d.closeclaimdate)&lt;=to_date ({TempLaporan.DateOfLoss},'dd/mm/yyyy') 
order by closeclaimdate asc</pyBrowseSQL>

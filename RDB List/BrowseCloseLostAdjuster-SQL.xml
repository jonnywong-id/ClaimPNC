<pyBrowseSQL>SELECT z.*
          FROM (SELECT a.pzinskey AS "AlasanDokterRejectRCL",
       a.REFNO_1 AS "UserName",
       a.CASEID_1 AS "CaseID",
       a.POLICYNO AS "Country",
       a.QQNAME AS "AnalystDoctorRemaks",
       a.USERTEKNIS_1 AS "UserTeknis",
       a.ADJUSTERPIC_1 AS "AnaylstRemarks",
       a.DATEOFLOSS_1 AS "DateOfLoss",
       a.AdjusterStatus_1 AS "CauseOfLossID",
       a.pxcreatedatetime AS "CPLValidDate",
       a.pyid AS "City",
       a.RESCHEDULEDATE_1 AS "CityID",
       a.RESCHEDULELOCATION_1 AS "ClaimNo",
       a.DateForAging_1 AS "DateForAging",
       a.PXCREATEOPNAME AS "District",
       a.ASMSTATUS_1 AS "UserAdmin",
       (select b.BUSINESSNAME from datapega.PC_ASM_FW_GCNMFW_WORK b where a.CASEID_1 = B.PZINSKEY) as "KomiteStatus",
       a.RescheduleLocation_1 as "Location",
       (select causeofloss from pooldata.t_claim_objectcoverage where a.caseid_1=claimid fetch next 1 row only) as "CauseOfLoss",
			ROW_NUMBER () OVER (ORDER BY pxcreatedatetime  desc) AS "rn"
FROM DATAPEGA.PC_ASM_FW_GCNMFW_WORK a
WHERE  PXOBJCLASS = 'ASM-FW-GCNMFW-Work-SurveyClaim' 
AND PYSTATUSWORK = 'Resolved-Completed'
{ASIS:tempQuery.UserTeknisEmail}
{ASIS:TempSearch.source}) z
 WHERE "rn" &gt;= {ASIS:Pagination.FirstRow}  AND "rn" &lt;=  {ASIS:Pagination.LastRow}</pyBrowseSQL>

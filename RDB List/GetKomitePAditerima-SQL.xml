<pyBrowseSQL>select * from (SELECT 
    a.pyId AS "pyID",
    SUBSTR(PNCCASEID, INSTR(PNCCASEID, ' ') + 1) AS "ClaimID",
      a.pzInsKey as "pzInsKey",
    	  A.PNCCASEID AS "CoverInsKey",
    	  a.POLICYNO AS "NoPolis",
    	   a.PXCREATEDATETIME as "CreateDateTime",
    r.OBJECTNAME AS "NamaTertanggung",
   case when b.STATUSAPPROVE='1' then 'DITERIMA' else 'DITOLAK' end as "KomiteJawab",
    b.NOTEKOMITE AS "NoteKomite",
    r.TGLAI as "TanggalAI",
     b.tanggalkomite as "TglKomite",
    r.NOTETERIMA AS "NoteAITerima",
    r.NOTETOLAK AS "NoteAITolak",
    r.RESULTAI AS "JawabanAI",
r.COVERAGE_AI_FINAL AS "COVERAGE_AI_FINAL" ,
r.KATEGORI_KRONOLOGI AS "KATEGORI_KRONOLOGI",
rownum as "RN"
FROM 
    DATAPEGA.PC_ASM_FW_GCNMFW_WORK a,
    POOLDATA.T_CLAIM_DATA_RESULTS_AI  r,
 POOLDATA.T_CLAIM_KOMITE_LIST b
WHERE 
    a.pyId = r.KOMITE and 
    a.pxobjclass='ASM-FW-GCNMFW-Work-Komite' 
   and r.KOMITE=b.KOMITE_ID
    AND a.STATUSCASE_1={TempKomiteInput.AlasanKlaim}
    AND a.grouppanel_1={TempKomiteInput.BranchName}  
    AND a.PYRESOLVEDUSERID IN (SELECT OPERATOR_ID FROM POOLDATA.EMAILKOMITE WHERE TYPE_BUSINESS={TempKomiteInput.AreaClaimId}  AND limit_bottom&gt;={TempKomiteInput.ClaimAmountAdjust})
and
 PYID in (select x.KOMITE from POOLDATA.T_CLAIM_DATA_RESULTS_AI x )
{Asis:LaporanDataAIKlaim.NoteAITerima}
)
{Asis: TempLaporan.NoteKasir}</pyBrowseSQL>

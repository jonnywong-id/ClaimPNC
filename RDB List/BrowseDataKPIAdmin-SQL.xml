<pyBrowseSQL>SELECT a.noklaim as "UserTeknis", b.nopolis as "Remark", b.businessname as "Country", to_char(b.registerdate,'dd/mm/yyyy') as "ClaimNo", to_char(b.TRANSFERPIC_DATE,'dd/mm/yyyy') as "ClaimAmount", b.leader_member as "CountryID",
       datamining.get_working_hours@asmd.sinarmas.co.id(b.registerdate, b.TRANSFERPIC_DATE) / 28800 as "City"
  FROM pooldata.pega_dashboardpnc a,
       pooldata.t_claim_pnc b,
       datapega.pc_asm_fw_gcnmfw_work d
 WHERE     a.noklaim = b.claimno
       AND a.stsklaim &lt;&gt; '2'
       AND b.claimid = d.pzinskey
       AND pxcreateoperator IN ('SOPHIANOVITAEVELYN_1', 'SOPHIANOVITAEVELYN', 'RUTHCLARA')
       AND group_panel IN ('003', '004', '006')
       AND groupbisnisid NOT IN ('09', '11', '16', '25')
       {ASIS:TempLaporan.BranchID}</pyBrowseSQL>

<pyBrowseSQL>select lgb_note AS "BUSINESSTYPE",
    SUM(
        CASE
        WHEN (stsklaim is not null ) 
        THEN 1
        ELSE 0
        END
       )
       AS "BUSINESSNAME",
    SUM (
        CASE 
        WHEN (stsklaim = '3') 
        THEN 1
        ELSE 0
        END
        )
       AS "BUSINESSCODE",
    SUM (
        CASE
        WHEN (stsklaim = '1')
        THEN 1
        ELSE 0
        END
    ) AS "ACCUMCODE",
        SUM (
        CASE
        WHEN (stsklaim not in ('1','2','3'))
        THEN 1
        ELSE 0
        END)
         AS "BRANCHCODE",
        SUM (
        CASE
        WHEN (stsklaim = '3')
        THEN (ttlos)
        ELSE 0
        END)
       AS "MARKETINGCODE",
    SUM (
        CASE
        WHEN (stsklaim = '1')
        THEN (TTLAKSEP)
        ELSE 0
        END)
       AS "CLIENTID",
    SUM (
        CASE
        WHEN (stsklaim not in ('1','2','3'))
        THEN (TTLOS)
        ELSE 0
        END)
       AS "IDPEGA",
    SUM (
        CASE
        WHEN (stsklaim = '1')
        THEN ((TTLAKSEP+TTLOS)+(TTLOS-TTLAKSEP))
        WHEN (stsklaim not in ('1','2','3'))
        THEN (TTLAKSEP+TTLOS)
        ELSE 0
        END)
       AS "NOPOLIS"                     
from POOLDATA.PEGA_DASHBOARDPNC
where 
{ASIS:TempData.ClaimNo}
{ASIS:TempPeriode.AnaylstRemarks}
GROUP BY lgb_note</pyBrowseSQL>

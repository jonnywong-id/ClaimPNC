<pyBrowseSQL>SELECT SUM (
          CASE
             WHEN (    A.pxobjclass = 'ASM-FW-GCNMFW-Work-PNC'
                   AND b.pxtasklabel IN
                          ('Input Register', 'Input Estimasi', 'Estimation'))
             THEN
                1
             ELSE
                0
          END)
          AS "ClaimNo",
       SUM (
          CASE
             WHEN (    A.pxobjclass = 'ASM-FW-GCNMFW-Work-ReceiveDocument'
                   AND A.PNCCASEID IS NULL
                   AND A.STATUSLOCK_1 = '1'
                   AND (A.KURIR IS NULL OR A.KURIR != 'Auto Service'))
             THEN
                1
             ELSE
                0
          END)
          AS "Country",
       SUM (CASE
               WHEN (SELECT COUNT (1)
                       FROM pooldata.BUSINESSNEW c
                      WHERE  c.id = A.BUSINESSCODE_1
                            AND A.pxobjclass ='ASM-FW-GCNMFW-Work-ReceiveDocument'
                            AND A.PNCCASEID IS NULL
                            AND A.STATUSLOCK_1 = '1'
                            AND A.KURIR = 'Auto Service') &gt; 0
               THEN
                  1
               ELSE
                  0
            END)
          AS "RCV_ID",
       SUM (
          CASE
             WHEN (SELECT COUNT (1)
                     FROM pooldata.t_req_survey f
                    WHERE     f.claimid = a.pzinskey
                          AND REQUESTSURVEY_1 = '1'
                          AND b.pxassignedoperatorid = {TempOperator.City}
                          AND a.PYSTATUSWORK NOT IN
                                 ('Resolved-Completed', 'Resolved-Rejected')
                          AND NOT EXISTS
                                     (SELECT *
                                        FROM pooldata.t_claim_adjustment ad
                                       WHERE     ad.claimid = a.pzinskey
                                             AND ad.paymenttype != '3')) &gt; 0
             THEN
                1
             ELSE
                0
          END)
          AS "Currency",
       SUM (
          CASE
             WHEN (SELECT COUNT (1)
                     FROM pooldata.m_komunikasi_pnc kom
                    WHERE     kom.caseid = A.PNCCASEID
                          AND kom.KOMUNIKASISTATUS = '0'
                          AND kom.sender != {TempOperator.City}
                          AND A.pxobjclass = 'ASM-FW-GCNMFW-Work-PNC'
                          AND B.pxAssignedOperatorID = {TempOperator.City}) &gt; 0
             THEN
                1
             ELSE
                0
          END)
          AS "CaseID",
       SUM (
          CASE
             WHEN (SELECT COUNT (1)
                     FROM pooldata.m_komunikasi_pnc kom
                    WHERE     kom.caseid = A.PNCCASEID
                          AND kom.KOMUNIKASISTATUS = '0'
                          AND kom.sender = {TempOperator.City}
                          AND A.pxobjclass = 'ASM-FW-GCNMFW-Work-PNC'
                          AND B.pxAssignedOperatorID = {TempOperator.City}) &gt; 0
             THEN
                1
             ELSE
                0
          END)
          AS "City",
       SUM (
          CASE
             WHEN (SELECT COUNT (1)
                     FROM pooldata.m_komunikasi_pnc kom
                    WHERE     kom.caseid = A.PNCCASEID
                          AND kom.KOMUNIKASISTATUS = '1'
                          AND kom.sender = {TempOperator.City}
                          AND A.pxobjclass = 'ASM-FW-GCNMFW-Work-PNC'
                          AND B.pxAssignedOperatorID = {TempOperator.City}) &gt; 0
             THEN
                1
             ELSE
                0
          END)
          AS "District",
       SUM (CASE
               WHEN (SELECT COUNT (1)
                       FROM pooldata.t_claim_pnc e
                      WHERE     e.claimno = a.pyid
                            AND a.PXCREATEOPNAME = {TempOperator.City}
                            AND a.pyid IN
                                   (SELECT communicate_to
                                      FROM pooldata.m_komunikasi_pnc f
                                     WHERE     f.communicate_to = a.pyid
                                           AND komunikasistatus = '0')) &gt; 0
               THEN
                  1
               ELSE
                  0
            END)
          AS "BranchName",
       SUM (CASE
               WHEN (SELECT COUNT (1)
                       FROM pooldata.t_claim_pnc e
                      WHERE     e.CLAIMID = A.PZINSKEY
                            AND e.CLAIMID = B.PXREFOBJECTKEY
                            AND a.pxobjclass = 'ASM-FW-GCNMFW-Work-PNC'
                            AND a.pyStatusWork NOT IN
                                   ('Resolved-Completed', 'Resolved-Rejected')
                            AND a.PXCREATEOPNAME = {TempOperator.City}) &gt; 0
               THEN
                  1
               ELSE
                  0
            END)
          AS "BranchID"
  FROM DATAPEGA.PC_ASM_FW_GCNMFW_WORK A,
       DATAPEGA.PC_ASSIGN_WORKLIST B,
       POOLDATA.BUSINESSNEW c,
       pooldata.businessgroup d
 WHERE     B.PXREFOBJECTINSNAME = A.PYID
        AND A.BUSINESSCODE_1 = c.id
        AND c.businessgroupid = d.id
       AND A.PYSTATUSWORK NOT IN ('Resolved-Completed', 'Resolved-Rejected')
       AND b.pxflowname NOT LIKE '%FixCorrespondence%'
       AND a.branchname !='ASNET'
      {ASIS:tempQuery.Remark}
{ASIS:tempQuery.NoKTP}
{ASIS:tempQuery.pyNote}</pyBrowseSQL>

<pyBrowseSQL>SELECT
        a.noklaim AS "ClaimNo",
        a.nopolis AS "NoKTP",
        a.dateofloss AS "DateOfLoss",
        a.tglklaim AS "RegisterDate",
        c.qqname AS "NamaDokumen",
        to_date(to_char(sysdate,'dd/mm/yyyy'),'dd/mm/yyyy') - to_date(to_char(a.tglklaim,'dd/mm/yyyy'),'dd/mm/yyyy') AS "ProdKe",
        a.pic AS "City",
        a.cabang AS "CityID",
        a.lgb_note AS "AnaylstRemarks",
        a.sobname AS "AnalystDoctorRemaks",
        a.col_desc AS "CauseOfLoss",
        d.currency AS "Currency",
        b.grossvalue AS "Country",
        b.asm_share_value AS "CountryID",
        c.SURVEYORNAME_1 AS "Conveyance",
        c.adjusterpic_1 AS "District",
        z.DistrictID AS "DistrictID",
        z.ExGratiaNote AS "ExGratiaNote",
        z.CPLValidDate AS "CPLValidDate",
        z.DateReceived AS "DateReceived",
        z.FlagReject AS "FlagReject",
        x.Province AS "Province",
        x.ProvinceID AS "ProvinceID",
        z.POSISI AS "Email",
        (SELECT COUNT(ID_UPDATE) 
            FROM POOLDATA.GCNM_PROGRESS_CLAIM 
            WHERE pnccaseid=a.noklaim
            group by PNCCASEID) AS "DokumenLengkap"
from pooldata.pega_dashboardpnc a,
pooldata.t_claim_adjustment b,datapega.PC_ASM_FW_GCNMFW_WORK c, pooldata.currency d, 
    (SELECT 
            G.KETERANGAN as FlagReject,
            I.STS_PROGRESS1 as DistrictID, 
            H.STS_PROGRESS2 as ExGratiaNote, 
            G.TGL_INPUT as CPLValidDate, 
            G.NEXT_FOLLOWUP as DateReceived,
            y.noklaim as CaseID,
            j.posisi AS POSISI
            FROM POOLDATA.GCNM_PROGRESS_CLAIM G,POOLDATA.GCNM_MST_PROGRESS H , POOLDATA.GCNM_MST_PROGRESS_KLAIM I, 
            POOLDATA.GCNM_PROGRESS_POSISI_PNC j, pooldata.pega_dashboardpnc y
            WHERE G.STATUS_PROGRESS1 = I.ID_PROGRESS
        AND G.STATUS_PROGRESS2 = H.ID_MST
        AND G.PNCCASEID = y.NOKLAIM 
        and g.pnccaseid=j.caseid
        and G.STATUS_PROGRESS2 not in ('2','24','60')
        AND ID_UPDATE = (SELECT MAX(ID_UPDATE)FROM POOLDATA.GCNM_PROGRESS_CLAIM
        WHERE PNCCASEID = y.NOKLAIM 
        AND POSISIID = (SELECT MAX(POSISIID) FROM POOLDATA.GCNM_PROGRESS_CLAIM WHERE PNCCASEID = y.NOKLAIM ))) z,
    (select sum(Province) as Province, sum(ProvinceID) as ProvinceID, caseid
    from (
        select tgl_input,next_followup, pnccaseid as caseid,
            (case 
                when (trunc(next_followup)&lt; (select 
                                                (case
                                                    when trunc(tgl_input) is not null
                                                    then tgl_input
                                                    else trunc(sysdate)
                                                end) from pooldata.gcnm_progress_claim where pnccaseid=t.pnccaseid and id_update=t.id_update+1))
                then 1 
                else 0 
            end) as Province,
            (case 
                when (trunc(next_followup)&gt;= (select 
                                                (case
                                                    when trunc(tgl_input) is not null
                                                    then tgl_input
                                                    else trunc(sysdate)
                                                end) from pooldata.gcnm_progress_claim where pnccaseid=t.pnccaseid and id_update=t.id_update+1))
                then 1 
                else 0 
            end) as ProvinceID 
        from pooldata.gcnm_progress_claim t order by id_update) group by caseid) x
where substr(b.claimid,20,27)=a.noklaim
and substr(c.pzinskey,20,27)=a.noklaim
and c.pxobjclass='ASM-FW-GCNMFW-Work-PNC'
and z.CaseID=a.noklaim
and b.currency=d.id
and x.caseid=a.noklaim
and a.stsklaim NOT IN ('1','2','3')
and {ASIS:TipeBisnis.BUSINESSTYPE}</pyBrowseSQL>

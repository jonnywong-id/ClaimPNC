<pyBrowseSQL>SELECT z.*
          FROM (SELECT noklaim as "CaseID",
                       nopolis AS "ClaimNo",
                       lgb_note as "Country",
                       tglklaim as "DateForAging",
                       dateofloss AS "DateOfLoss",
                       pooldata.GET_POSISI_PROGRESS_PNC (noklaim, 'POSISI') as "City",
                       pooldata.GET_POSISI_PROGRESS_PNC (noklaim, 'sts_prg1') as "CityID",
                       pooldata.GET_POSISI_PROGRESS_PNC (noklaim, 'sts_prg2') as "CountryID",
                       pooldata.GET_POSISI_PROGRESS_PNC (noklaim, 'nextfu') as "AnalystTransferDate",
                       tgl_proses as "TanggalAnalystSendRCL",
                       nopolis as "NoKTP",
                       prod_ke as "ProdKe",
                       pic as "UserTeknis",
                       (SELECT next_followup FROM gcnm_progress_claim  where PNCCaseid = a.noklaim order by next_followup Asc fetch next 1 rows only) as "KomiteApproveDate",
                       (select QQNAME from POOLDATA.T_CLAIM_PNC where CLAIMNO= a.noklaim) as "District",
			ROW_NUMBER () OVER (ORDER BY tgl_proses ASC) AS "rn"
                  FROM pega_dashboardpnc a WHERE stsklaim NOT IN ('1','2','3') {ASIS:tempgetpic.MCL_NAME}
                  {ASIS:TempCabang.District}) z
 WHERE "rn" &gt;= {ASIS:Pagination.FirstRow}  AND "rn" &lt;=  {ASIS:Pagination.LastRow}</pyBrowseSQL>

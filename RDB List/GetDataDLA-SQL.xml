<pyBrowseSQL>SELECT NODLA AS "NO_DLA",
       NILAIDLA AS "DLAShare",
       DLAREINSURER AS "DLAReinsurer",
       REINSCODE AS "ReinsCode",
       TIPEDLA AS "DLAType",
       CURRENCY AS "Currency",
       CURRENCYPOLIS AS "CurrencyPolicy",
       SHARESPREADING AS "ShareSpreading",
       PERCENTDLA AS "PercentDLA",
       KLAIMAMOUNT AS "KlaimAmount",
       QSRI AS "QSRI",
       QS_PQS AS "pyNote",
       LOGIN AS "pyLabel",
       COUNTRY AS "Country",
       EMAILDLA AS "pyEmailAddress",
       REVISI AS "RevisiDLA",
       NOTES AS "RemarksDLA",
       ISDLA AS "IsDLA",
       ISKIRIM AS "IsKirim",
       NOAKSEP AS "DLAStream",
      TGLDLA as "Date",
      LOCATIONID as "LocationID"
  FROM POOLDATA.T_DLALIST
 WHERE     CLAIMID = {TempPLADLA2.Initial}
       AND OBJECTID = {TempPLADLA2.IDObject}
       AND OBJECTCOVERAGEID = {TempPLADLA2.IDCoverage}
       AND ADJUSTMENTID = {TempPLADLA2.IDAdjustClaim}
       AND (REVISI = '0' OR REVISI IS NULL)
     {ASIS:TempPLADLA2.RemarkAccepted}
       {ASIS:TempPLADLA2.Receiver}
ORDER BY TGLDLA ASC</pyBrowseSQL>

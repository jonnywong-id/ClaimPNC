<pyBrowseSQL>SELECT SUM (C.NILAIAKSEPTASI*C.CURRENCYVALUE) AS "Country"
  FROM POOLDATA.T_CLAIM_ADJUSTMENT c
 WHERE     (STATUSAKSEPTASI NOT IN ('2') OR STATUSAKSEPTASI IS NULL)
       AND (STATUSAKSEPTASILOD IS NULL OR STATUSAKSEPTASILOD != '0')
       AND claimid IN
              (SELECT a.claimid
                 FROM POOLDATA.T_CLAIM_OBJECTCOVERAGE a,
                      POOLDATA.T_CLAIM_PNC b
                WHERE (A.COVERAGEID = {TempCariAksep.District} AND B.NOPOLIS = {TempCariAksep.NPWP}) and a.claimid = b.claimid and A.OBJECTID = {TempCariAksep.Other})</pyBrowseSQL>

<pyBrowseSQL>SELECT a.PXREFOBJECTINSNAME AS CARI11,
       a.PZINSKEY           AS CARI10,
       a.PXCREATEOPNAME     AS CARI12,
        b.PXUPDATEOPERATOR                               AS CARI24,
       'Estimation'         AS CARI13,
       b.SOBNAME            AS CARI14,
       b.BUSINESSNAME       AS CARI15,
       b.CEDINGCONAME       AS CARI16,
       b.INSUREDNAME        AS CARI17,
       c.NOPOLIS            AS CARI18,
       b.MASTERID           AS CARI19,
       (trunc(sysdate)-trunc(b.PXCREATEDATETIME)) AS CARI20,
      c.data_json.DateOfLoss AS CARI22,
      c.data_json.IDMaster AS CARI23
   FROM DATAPEGA.pc_assign_worklist a, DATAPEGA.pc_ASM_FW_GCNMFW_Work b, pooldata.json_klaim c
  WHERE     a.PXREFOBJECTKEY = b.pzinskey AND a.PXREFOBJECTKEY = c.IDPEGA
       AND a.PXASSIGNEDOPERATORID = {Inputdata.CARI10} AND (a.PXREFOBJECTINSNAME LIKE 'CLMNP-%')</pyBrowseSQL>

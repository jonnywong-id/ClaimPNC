<pyBrowseSQL>SELECT 'ALL' AS "ACCUMCODE", 
        COUNT (case when {ASIS:TempLaporan.Conveyance} then 1 else null end ) AS "BRANCHNAME",
        COUNT (case when {ASIS:TempLaporan.Country} then 1 else null end ) AS "BUSINESSCODE",
        COUNT (case when stsklaim = '1' and {ASIS:TempLaporan.Conveyance} then 1 else null end ) AS "BUSINESSNAME",
        COUNT (case when stsklaim = '1' and {ASIS:TempLaporan.Country} then 1 else null end ) AS "CLIENTID",
        COUNT (case when stsklaim = '3' and {ASIS:TempLaporan.Conveyance} then 1 else null end ) AS "EDMNO",
        COUNT (case when stsklaim = '3' and {ASIS:TempLaporan.Country} then 1 else null end ) AS "FLAGEDMBATAL",
        COUNT (case when stsklaim NOT IN ('1', '2', '3') and {ASIS:TempLaporan.Conveyance} then 1 else null end ) AS "FOLLOWEDPOLICY",
        COUNT (case when stsklaim NOT IN ('1', '2', '3') and {ASIS:TempLaporan.Country} then 1 else null end ) AS "IDPEGA"
  FROM PEGA_DASHBOARDPNC
 WHERE pic IS NOT NULL
       {ASIS:TempLaporan.ClaimNo}
UNION ALL
select z.* from (
  SELECT pic AS "ACCUMCODE", 
        COUNT (case when {ASIS:TempLaporan.Conveyance} then 1 else null end ) AS "BRANCHNAME",
        COUNT (case when {ASIS:TempLaporan.Country} then 1 else null end ) AS "BUSINESSCODE",
        COUNT (case when stsklaim = '1' and {ASIS:TempLaporan.Conveyance} then 1 else null end ) AS "BUSINESSNAME",
        COUNT (case when stsklaim = '1' and {ASIS:TempLaporan.Country} then 1 else null end ) AS "CLIENTID",
        COUNT (case when stsklaim = '3' and {ASIS:TempLaporan.Conveyance} then 1 else null end ) AS "EDMNO",
        COUNT (case when stsklaim = '3' and {ASIS:TempLaporan.Country} then 1 else null end ) AS "FLAGEDMBATAL",
        COUNT (case when stsklaim NOT IN ('1', '2', '3') and {ASIS:TempLaporan.Conveyance} then 1 else null end ) AS "FOLLOWEDPOLICY",
        COUNT (case when stsklaim NOT IN ('1', '2', '3') and {ASIS:TempLaporan.Country} then 1 else null end ) AS "IDPEGA"
    FROM PEGA_DASHBOARDPNC
   WHERE pic IS NOT NULL
         {ASIS:TempLaporan.ClaimNo}
             GROUP BY pic 
) z where (BRANCHNAME + BUSINESSCODE + BUSINESSNAME + CLIENTID + EDMNO + FLAGEDMBATAL + FOLLOWEDPOLICY + IDPEGA)  != 0</pyBrowseSQL>

<pyBrowseSQL>select b.* 
from (select a.*, 
        rownum rn 
        from (select distinct a.pyid as "City",
                a.pzinskey as "CaseID", 
                'ASSIGN-WORKLIST ' || a.pzinskey || '!Register_Flow' AS "pyNote",
                statusclaim_1 as "StatusClaim", 
                policyno AS "Currency",
                qqname as "CityID", 
                businessname AS "District", 
                A.RECEIVEDDATE_1 as "pyEndTime",
                a.sobname as "DistrictID", 
                branchname AS "Country", 
                to_char(TRUNC(dateofloss_1),'dd-mm-yyyy') as "CountryID",
                a.pxCreateDateTime as "pxCreateDateTime", 
                userteknis_1 as "CauseOfLoss", 
                a.pxCreateOpName as "ClaimID" ,
                pooldata.GET_POSISI_PROGRESS_PNC (pyID, 'POSISI') as "ClaimNo",
                pooldata.GET_POSISI_PROGRESS_PNC (pyID, 'sts_prg2') as "CloseClaimNote"
                from datapega.pc_asm_fw_gcnmfw_work a,
                datapega.pc_assign_worklist b,
                pooldata.business c,
                pooldata.businessgroup d
                where a.pxobjclass = 'ASM-FW-GCNMFW-Work-PNC' 
                AND a.pzInsKey = b.pxrefobjectkey
                and a.pystatuswork != 'Resolved-Completed' 
                and a.pystatuswork != 'Resolved-Rejected' 
                AND a.BUSINESSCODE_1 = c.id
                AND c.businessgroupid = d.id
                AND a.branchname!='ASNET'
                AND b.pxflowname not in ('FixCorrespondence', 'Register_Flow_1') 
                AND b.PXTASKLABEL not in ('FixCorrespondence')
                {ASIS:TempFilter.CaseID}
                {ASIS:TempFilter.City}
                {ASIS:TempFilter.CityID}
                {ASIS:TempFilter.District}
                {ASIS:TempFilter.DistrictID}
                {ASIS:TempFilter.Country}
                order by a.pxcreatedatetime asc
        ) a 
) b 
where rn&gt;={ASIS:Pagination.FirstRow} and rn&lt;={ASIS:Pagination.LastRow}</pyBrowseSQL>

<pyBrowseSQL>WITH t AS (
    SELECT POOLDATA.GETSELISIHJAM(
               {ASIS:InputParam.CARI1},
               {ASIS:InputParam.CARI2}
           ) AS hours_diff
    FROM dual
)
SELECT CASE
         WHEN hours_diff &lt; 24 THEN
              TRUNC(hours_diff) || ' hours ago'
         ELSE
              FLOOR(hours_diff / 24) || ' days ' ||
              MOD(TRUNC(hours_diff), 24) || ' hours ago'
       END AS "Jawaban"
FROM t</pyBrowseSQL>

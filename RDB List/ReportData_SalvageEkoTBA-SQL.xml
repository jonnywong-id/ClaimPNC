<pyBrowseSQL>SELECT B.* 
FROM (SELECT A.*, ROWNUM RN 
      FROM (SELECT a.CLAIMNO AS "CaseID",
                   (SELECT objectname
                          FROM POOLDATA.T_CLAIM_OBJECTLIST c
                         WHERE c.claimid = a.claimid fetch next 1 row only ) as "Reason",
                   a.NOPOLIS AS "PolicyNo",
                   a.QQNAME AS "LOGIN",
                   a.DATEOFLOSS,
                   a.PICTEKNIK AS "UserTeknis",
                   a.BUSINESSNAME AS "Location",
                   TO_CHAR (a.DATEOFLOSS , 'dd/mm/yyyy') AS "DateOfLoss",  
                   a.STATUSWORK AS "Keterangan"
                  FROM POOLDATA.T_CLAIM_PNC A
                  WHERE     A.GROUPPANEL IN ('003', '004', '006', '009')
                       AND A.BUSINESSCODE NOT IN ('10145', '10168')
                       {ASIS:tempQuery.NewEmail}
)A
      )B</pyBrowseSQL>

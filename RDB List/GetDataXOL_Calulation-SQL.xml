<pyBrowseSQL>select 
    a.DOL as "ASMFull",
    CAUSEOFLOSS as "AcceptedNo",
    sum(OSVALUE) as "Currency",
    sum(AKSEPVALUE) as "CurrencyID"
from pooldata.XOL_TABLE_ALL_KLAIM a
where to_char(to_date(a.DOL,'dd/mm/yyyy'),'yyyy')= {TempMst.CurrencyName} and CAUSEOFLOSS in 
(select DESCRIPTION from POOLDATA.V_D_CAUSE_OF_LOSS)
and A.GROUPBUSINESS in ({ASIS:TempMst.CurrencyID})
group by a.DOL, CAUSEOFLOSS</pyBrowseSQL>

<pyBrowseSQL>SELECT c.branchname AS CABANG,
         c.sobname AS "Sources",
         CASE
            WHEN c.grouppanel = '002' THEN 'PA'
            WHEN c.grouppanel = '003' THEN 'Aneka'
            WHEN c.grouppanel = '004' THEN 'Marine Cargo'
            WHEN c.grouppanel = '005' THEN 'Travel'
            WHEN c.grouppanel = '006' THEN 'Fire'
            ELSE c.grouppanel
         END
            AS "BusinessName",
         c.nopolis AS "PolicyNo",
         c.claimno AS "ClaimNo",
         c.registerdate AS "RegisterDate",
         c.dateofloss AS "DateOfLoss",
         c.remarkrecomendation AS "RemarkRecommendation",
         NVL (e.reserves, 0) AS "EstimationValue",
         p.tgl_input AS "TanggalTerlambat",
         m1.sts_progress1 AS "StatusProgress1",
         m2.sts_progress2 AS "StatusProgress2",
         c.picteknik AS "PICRekanan",
         p.keterangan AS "Keterangan",
         TRUNC (SYSDATE) - TRUNC (c.registerdate) AS "AgingKlaim",
         c.branchcode,
         s.surveyor_name AS "NamaSurveyor",
         col.causeofloss AS "CauseOfLoss",
         c.kronologi AS "Kronologis"
    FROM pooldata.t_claim_pnc c
         JOIN datapega.pc_asm_fw_gcnmfw_work w
            ON     c.claimid = w.pzinskey
               AND w.pystatuswork NOT IN
                      ('Resolved-Rejected', 'Resolved-Completed')
               AND w.pxobjclass = 'ASM-FW-GCNMFW-Work-PNC'
LEFT JOIN (
    SELECT *
    FROM (
        SELECT p.pnccaseid,
               p.tgl_input,
               p.status_progress1,
               p.status_progress2,
               p.keterangan,
               ROW_NUMBER() OVER (
                   PARTITION BY p.pnccaseid
                   ORDER BY p.tgl_input DESC
               ) rn
        FROM POOLDATA.GCNM_PROGRESS_CLAIM p
        WHERE p.status_progress1 IS NOT NULL
    )
    WHERE rn = 1
) p
            ON p.pnccaseid = c.claimno
         LEFT JOIN (  SELECT id_progress, MAX (sts_progress1) AS sts_progress1
                        FROM POOLDATA.GCNM_MST_PROGRESS
                    GROUP BY id_progress) m1
            ON m1.id_progress = p.status_progress1
         LEFT JOIN (  SELECT id_mst, MAX (sts_progress2) AS sts_progress2
                        FROM POOLDATA.GCNM_MST_PROGRESS
                    GROUP BY id_mst) m2
            ON m2.id_mst = p.status_progress2
         LEFT JOIN (  SELECT claimid, SUM (estimationvalue) AS reserves
                        FROM pooldata.T_CLAIM_ESTIMASI
                    GROUP BY claimid) e
            ON e.claimid = c.claimid
         LEFT JOIN (  SELECT pnccaseid, MAX (surveyor_name) AS surveyor_name
                        FROM POOLDATA.T_SURVEYORLIST
                          WHERE SURVEYTYPE = '2'
                    GROUP BY pnccaseid) s
            ON s.pnccaseid = c.claimid
         LEFT JOIN (  SELECT claimid,
                             MAX (causeofloss)
                                KEEP (DENSE_RANK LAST ORDER BY createdatetime)
                                AS causeofloss
                        FROM POOLDATA.T_CLAIM_OBJECTCOVERAGE
                    GROUP BY claimid) col
            ON col.claimid = c.claimid
   WHERE c.registerdate IS NOT NULL
    AND c.branchcode = {OperatorID.pyTelephone}
ORDER BY "AgingKlaim" DESC</pyBrowseSQL>

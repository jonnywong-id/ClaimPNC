<pyBrowseSQL>SELECT TO_CHAR(SUM(cnt)) AS "QTY"
       FROM (  SELECT COUNT(1) AS cnt
                        FROM gl.t_all_payment
                       WHERE no_trans = {TempAnomaly.NoAkseptasi} 
                      UNION ALL
                      SELECT COUNT(1) AS cnt
                        FROM gl.t_request_kasir
                       WHERE no_trans = {TempAnomaly.NoAkseptasi}
                      UNION ALL
                      SELECT COUNT(1) AS cnt
                        FROM investasi.t_claim_spk
                       WHERE no_akseptasi = {TempAnomaly.NoAkseptasi} 
                      UNION ALL
                      SELECT COUNT(1) AS cnt
                        FROM gl.t_all_payment
                       WHERE no_trans = {TempAnomaly.PolicyNo} || {TempAnomaly.ContractNo}
                      UNION ALL
                      SELECT COUNT(1) AS cnt
                        FROM gl.t_request_kasir
                       WHERE no_trans = {TempAnomaly.PolicyNo} || {TempAnomaly.ContractNo}
                      UNION ALL
                      SELECT COUNT(1) AS cnt
                        FROM investasi.t_claim_spk
                       WHERE no_akseptasi = {TempAnomaly.PolicyNo} || {TempAnomaly.ContractNo} 
                       )</pyBrowseSQL>

<pyBrowseSQL>SELECT B.* 
FROM (SELECT A.*, ROWNUM RN 
      FROM (SELECT A.NOKLAIM AS "CaseID",
       A.TGLINPUT AS "DateOfLoss",
       A.JENISSALVAGE AS "NewEmail",
       A.QUANTITYSALVAGE AS "KomiteCount",
       A.ESTIMASINILAI AS "District",
       A.EMAIL AS "Email",
       ROWNUM AS "PostalCode",
       (CASE
           WHEN A.NILAIAKSEP IS NOT NULL AND A.NILAIAKSEP != 0 THEN 'Terjual'
           ELSE 'Belum Terjual'
        END)
          AS "TreatyName",
       A.PIC AS "UserTeknis",
       A.LOKASISALVAGE AS "Location",
       IDSALVAGE AS "ClaimNo",
       NOAKSEPTASI AS "NIK",
       A.REMARK AS "AlasanKlaim",
      A.STSTRANSFER as "Password"
  FROM POOLDATA.PNC_SALVAGE a, POOLDATA.T_CLAIM_PNC b
 WHERE b.claimid = 'ASM-FW-GCNMFW-WORK ' || a.noklaim
{ASIS:tempQuery.StatusClaim}
{ASIS:tempQuery.AlasanKlaim}
{ASIS:TempTes.BusinessName}
{ASIS:TempTes.AlasanKlaim}
{ASIS:TempTes.AlasanTerlambat}
{ASIS:TempTes.District}
order by a.tglinput desc)A
 )B 
{ASIS:tempQuery.AlasanTerlambat}</pyBrowseSQL>

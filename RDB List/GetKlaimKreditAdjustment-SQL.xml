<pyBrowseSQL>SELECT IDPEGA as "IDPEGA", upper(NOASURANSI) as "OLDPOLICYNO", BATCH as "ACCUMCODE", CURRENCY as "CLIENTID"  FROM POOLDATA.TMP_BATCH_CLAIM_KREDIT a  
WHERE NOPOLIS={InputData.CARI1}
AND TYPEKLAIM='KLAIM'
AND AGENID={inputcsv.SOBNAME}
AND TMP_MESSAGE='Sukses Klaim'
AND upper(NOASURANSI)={TempAdjustment.EDMNO}
AND BATCH = (SELECT MAX(TO_NUMBER(BATCH)) FROM POOLDATA.TMP_BATCH_CLAIM_KREDIT b 
                           WHERE a.NOPOLIS=b.NOPOLIS AND a.TYPEKLAIM=b.TYPEKLAIM AND a.AGENID=b.AGENID and a.NOASURANSI=b.NOASURANSI AND b.TMP_MESSAGE='Sukses Klaim')</pyBrowseSQL>

<pyBrowseSQL>SELECT a.NODLA AS "NO_DLA",
       a.NILAIDLA AS "DLAShare",
       a.DLAREINSURER AS "DLAReinsurer",
       a.REINSCODE AS "ReinsCode",
       a.TIPEDLA AS "DLAType",
       a.CURRENCY AS "Currency",
       a.CURRENCYPOLIS AS "CurrencyPolicy",
       a.SHARESPREADING AS "ShareSpreading",
       a.PERCENTDLA AS "PercentDLA",
       a.KLAIMAMOUNT AS "KlaimAmount",
       a.QSRI AS "QSRI",
       a.QS_PQS AS "pyNote",
       (SELECT LOGIN FROM POOLDATA.T_REINSURER WHERE REINSURERID = a.REINSCODE and substr(a.NODLA,0,1)=TYPE) AS "pyLabel",
       (SELECT COUNTRY FROM POOLDATA.T_REINSURER WHERE REINSURERID = a.REINSCODE and substr(a.NODLA,0,1)=TYPE) AS "Country",
       (SELECT EMAIL FROM POOLDATA.T_REINSURER WHERE REINSURERID = a.REINSCODE and substr(a.NODLA,0,1)=TYPE) AS "pyEmailAddress",
       a.REVISI AS "RevisiDLA",
       a.NOTES AS "RemarksDLA",
       a.ISDLA AS "IsDLA",
       a.ISKIRIM AS "IsKirim",
       a.NOAKSEP AS "DLAStream",
       a.OBJECTID AS "CaseID", 
       a.OBJECTCOVERAGEID AS "CoverID", 
       a.ADJUSTMENTID  AS "pyCountry",
       a.TGLDLA as "Date",
      a.LOCATIONID as "LocationID"
  FROM POOLDATA.T_PREDLALIST a
 WHERE     a.CLAIMID = {TempPLADLA2.Initial}
       AND a.OBJECTID = {TempPLADLA2.IDObject}
       AND a.OBJECTCOVERAGEID = {TempPLADLA2.IDCoverage}
       AND a.ADJUSTMENTID = {TempPLADLA2.IDAdjustClaim}
       AND (REVISI = '0' OR REVISI IS NULL)
      {ASIS:TempPLADLA2.RemarkAccepted}
      {ASIS:TempPLADLA2.Receiver}</pyBrowseSQL>

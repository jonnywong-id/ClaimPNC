<pyBrowseSQL>SELECT count(1) as "ref_no"
FROM datapega.PC_ASM_FW_GCNMFW_WORK a, datapega.pc_assign_worklist b, (SELECT BRANCHNAME
            FROM POOLDATA.BRANCH
           WHERE ID IN  {ASIS:tempQuery.CaseID}
          UNION
          SELECT BRANCHNAME
            FROM POOLDATA.V_D_SURVEYORS
           WHERE D_SURVEY_ID in  {ASIS:tempQuery.CaseID}) z
WHERE 
B.PXASSIGNEDOPERATORID = {OperatorID.pyUserIdentifier}
and a.pxobjclass = 'ASM-FW-GCNMFW-Work-SurveyClaim'
AND a.PYSTATUSWORK NOT IN ('Resolved-Completed', 'Resolved-Rejected')
and a.pzInsKey = b.pxrefobjectkey
 AND EXISTS 
                 (SELECT *
                  from pooldata.m_komunikasi_pnc c
                 where a.pzinskey=c.caseid 
                 and c.KOMUNIKASISTATUS={TempView.DistrictID} 
                {ASIS:TempView.District} )
{ASIS:tempQuery.UserTeknisEmail}
{ASIS:TempSearch.source}
order by a.pxcreatedatetime desc</pyBrowseSQL>

<pyBrowseSQL>SELECT TO_CHAR (b.tglinput, 'dd/mm/yyyy') AS "CityID",
         b.noklaim AS "ClaimID",
         b.pic AS "ResponseNote",
         b.estimasinilai AS "Resources",
         a.noakseptasi AS "RefNo",
         TO_CHAR (a.tglaksep, 'dd/mm/yyyy') AS "ClientID",
         a.nilaiakseptasi AS "CloseClaimNote",
         a.remark AS "ObjectID",
         a.namabarang AS "AccountName",
         a.pemenangsalvage AS "BranchName",
         (CASE
             WHEN a.statusterjual = '1' THEN 'Terjual'
             WHEN a.statusterjual = '0' THEN 'Tidak terjual'
             WHEN a.statusterjual = '2' THEN 'Waiting approval waive'
             WHEN a.statusterjual = '3' THEN 'Rejected waive'
             WHEN a.statusterjual IS NULL THEN 'Belum terjual'
             ELSE '-'
          END)
            AS "NPWP",
         COUNT (a.namabarang) || ' ' || a.satuan AS "City",
         a.note_item AS "ResponseMsg",
         (SELECT c.surveyor_name 
          FROM POOLDATA.T_SURVEYORLIST c
          WHERE SUBSTR(c.PNCCASEID, INSTR(c.PNCCASEID, ' ') + 1) = b.noklaim
          AND ROWNUM = 1) AS "NamaSurveyor",
max(trunc(a.TGLAKSEP)-trunc(b.TGLTRANSFERGA)) as "InsuredName"
    FROM    pooldata.pnc_salvage b
         LEFT JOIN
            pooldata.detail_pnc_salvage a
         ON a.idsalvage = b.idsalvage AND a.noklaim = b.noklaim
   WHERE b.STSTRANSFER != 100
{ASIS:TempLaporan.IDMaster}
GROUP BY a.noakseptasi,
         a.nilaiakseptasi,
         a.namabarang,
         a.remark,
         a.pemenangsalvage,
         a.statusterjual,
         b.noklaim,
         b.pic,
         b.estimasinilai,
         satuan,
         note_item,
         TO_CHAR (a.tglaksep, 'dd/mm/yyyy'),
         TO_CHAR (b.tglinput, 'dd/mm/yyyy')
ORDER BY b.noklaim, namabarang</pyBrowseSQL>

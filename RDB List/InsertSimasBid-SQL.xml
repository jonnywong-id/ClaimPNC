<pyBrowseSQL>SELECT NAMABARANG AS "NamaDokumen",
         COUNT (NAMABARANG) AS "BranchID",
         (CASE
             WHEN STSSIMASBID = '1' THEN 'Berhasil Kirim'
             ELSE 'Gagal Kirim'
          END)
            AS "Remark",
sum(HARGAITEM) as "CountryID"
    FROM POOLDATA.DETAIL_PNC_SALVAGE
   WHERE {ASIS:tempQuery.NewEmail} 
GROUP BY NAMABARANG, STSSIMASBID</pyBrowseSQL>

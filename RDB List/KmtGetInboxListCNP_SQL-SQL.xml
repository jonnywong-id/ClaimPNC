<pyOpenSQL>SELECT a.PXREFOBJECTINSNAME                           AS CARI11,
        a.PZINSKEY                                     AS CARI10, 
        a.PXCREATEOPNAME                               AS CARI12,
        b.PXUPDATEOPERATOR                               AS CARI22,
        'Estimation'                                   AS CARI13,
        b.SOBNAME                                      AS CARI14,
        b.BUSINESSNAME                                 AS CARI15,
        b.CEDINGCONAME                                 AS CARI16,
        b.INSUREDNAME                                  AS CARI17,
        b.NOPOLIS                                      AS CARI18,
        b.MASTERID                                     AS CARI19,
        (TRUNC (SYSDATE) - TRUNC (b.PXCREATEDATETIME)) AS CARI20,
        b.PXCREATEDATETIME                             AS CARI21
   FROM DATAPEGA.pc_assign_worklist a, DATAPEGA.pc_ASM_FW_GCNMFW_Work b
  WHERE     a.PXREFOBJECTKEY = b.pzinskey
  AND a.PXASSIGNEDOPERATORID = {OperatorID.pyUserIdentifier}
AND (a.PXREFOBJECTINSNAME LIKE 'KMTNP-%')</pyOpenSQL>

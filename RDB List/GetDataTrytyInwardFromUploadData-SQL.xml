<pyBrowseSQL>SELECT COUNT (distinct(A.COMPANYNAME)) AS "IsDLA",
         SUM (TO_NUMBER (REPLACE (REPLACE (CLAIMAMOUNT, '.', ''), ',', '.'))*POOLDATA.GETCURRENCYSTANDARD(A.CURRENCYID,to_date(A.DATEOFLOSS,'dd/mm/yyyy'))/POOLDATA.GETCURRENCYSTANDARD('10001',to_date(A.DATEOFLOSS,'dd/mm/yyyy')))
            AS "DLAShare",
         SUM (
            TO_NUMBER (
               REPLACE (REPLACE (PAIDCLAIMAMOUNTSHARE, '.', ''), ',', '.'))*POOLDATA.GETCURRENCYSTANDARD(A.CURRENCYID,to_date(A.DATEOFLOSS,'dd/mm/yyyy'))/POOLDATA.GETCURRENCYSTANDARD('10001',to_date(A.DATEOFLOSS,'dd/mm/yyyy')))
            AS "KlaimAmount",
         'Treaty Inward' AS "Country",
         a.DATEOFLOSS AS "DLAType"
    FROM POOLDATA.T_CLAIM_INWARD_XOL a
 WHERE     TO_CHAR (TO_DATE (a.dateofloss, 'dd/mm/yyyy'),'dd/mm/yyyy') = {TempMst.ObjectName}
       AND A.CAUSEOFLOSS = {TempMst.NameOfBank}
       group by  dateofloss</pyBrowseSQL>

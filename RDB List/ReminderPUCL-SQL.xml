<pyBrowseSQL>SELECT "PC0"."POLICYNO" AS "POLICY_NO",
         "PC0"."BUSINESSNAME" AS "Policy.Quotation.BusinessName",
         "PC0"."BRANCHNAME" AS "Policy.Quotation.BranchName",
         "PC0"."SOBNAME" AS "Policy.Quotation.SobName",
         "PC0"."PXCREATEDATETIME" AS "pxCreateDateTime",
         "PC0"."PZINSKEY" AS "pzInsKey",
         "PC0"."PYID" AS "pyID",
         "PC0"."QQNAME" AS "CABANG",
         "PC0"."USERTEKNIS_1" AS "ClaimData.UserTeknis",
         "PC0"."PYORIGUSERID" AS "pyOrigUserID",
         "PC0"."PXCREATEDATETIME" AS "pxCreateDateTime",
         "PC0"."PYSTATUSWORK" AS "pyStatusWork",
         "PC0"."PNCSTATUS_1" AS "ClaimData.PNCStatus",
         "PC0"."STATUSCLAIM_1" AS "ClaimData.StatusClaim",
         "PC0"."KOMENTARANALISATOR_1" AS "LOGSEARCH",
         "AssignBasket"."PXASSIGNEDOPERATORID" AS "pxAssignedOperatorID",
         "PC0"."KOMENTARPUCL_1" AS "ClaimData.PUCLStatus.Kome17L",
         Case
              when "PC0"."RCL_PUCL_1" = 1 then 'RCL'
              when "PC0"."RCL_PUCL_1" = 2 then 'PUCL'
          End AS "STS_AKTF",
         "PC0"."LAMAKLAIM_1" AS "MODUL",
         "PC0"."STATUSKLAIM_1" AS "STS_EMAIL",
         "PC0"."TANGGALSELESAIRAWATINAP_1" AS "ClaimData.TanggalSelesaiR21L",
         "PC0"."DATEOFLOSS_1" AS "ClaimData.DateOfLoss",
         "PC0"."TANGGALCETAKDOKUMENPUCL_1" AS "TglCetak",
         "PC0"."TANGGALKIRIMPUCL_1" AS "DateOfSendInputor",
         "PC0"."STATUSCASE_1" AS "ClaimData.PUCLStatus.Stat25L"
    FROM    DATAPEGA.pc_ASM_FW_GCNMFW_Work "PC0"
         INNER JOIN
            DATAPEGA.pc_assign_workbasket "AssignBasket"
         ON (    ("AssignBasket"."PXREFOBJECTKEY" = "PC0"."PZINSKEY")
             AND "AssignBasket"."PXOBJCLASS" = 'Assign-WorkBasket'
             AND "PC0"."PXOBJCLASS" = 'ASM-FW-GCNMFW-Work-PNC')
   WHERE (    "PC0"."PYSTATUSWORK" &lt;&gt; 'Resolved-Completed'
          AND "AssignBasket"."PXASSIGNEDOPERATORID" = 'RCLPUCL'
          AND "PC0"."TANGGALCETAKDOKUMENPUCL_1" IS NOT NULL
          AND "PC0"."PUCLAPPROVE_1" &lt;&gt; 1
          AND "PC0"."MSIG_1" IS NULL)
ORDER BY 5 DESC, 7 DESC</pyBrowseSQL>

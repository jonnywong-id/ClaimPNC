<pyBrowseSQL>select "PC0"."PYID" AS "CaseID",
"PC0"."PZINSKEY",
"PC0"."POLICYNO" AS "ProdKe",
"PC0"."QQNAME" AS "NamaSurveyor",
"PC0"."TANGGALKIRIMPUCL_1" AS "City",
"PC0"."KOMENTARANALISATOR_1" AS "CloseClaimNote",
"PC0"."TANGGALCETAKDOKUMENPUCL_1" AS "CityID",
"PC0"."RCL_PUCL_1" AS "StatusReceiver",
 "PC0"."STATUSCLAIM_1" AS "StatusClaim"
FROM    DATAPEGA.pc_ASM_FW_GCNMFW_Work "PC0"
         INNER JOIN
            DATAPEGA.pc_assign_workbasket "AssignBasket"
         ON (    ("AssignBasket"."PXREFOBJECTKEY" = "PC0"."PZINSKEY")
             AND "AssignBasket"."PXOBJCLASS" = 'Assign-WorkBasket'
             AND "PC0"."PXOBJCLASS" = 'ASM-FW-GCNMFW-Work-PNC')
   WHERE (    "AssignBasket"."PXASSIGNEDOPERATORID" = 'RCLPUCL'
          and trunc("PC0"."TANGGALKIRIMPUCL_1") &gt;= to_date({TempRCLPUCLReport.AlasanKlaim},'dd/mm/yyyy') AND TRUNC ("PC0"."TANGGALKIRIMPUCL_1") &lt;= TO_DATE ({TempRCLPUCLReport.NoteKasir}, 'dd/mm/yyyy'))
union          
select "PC0"."PYID" AS "CaseID",
"PC0"."PZINSKEY",
"PC0"."POLICYNO" AS "ProdKe",
"PC0"."QQNAME" AS "NamaSurveyor",
"PC0"."TANGGALKIRIMPUCL_1" AS "City",
"PC0"."KOMENTARANALISATOR_1" AS "CloseClaimNote",
"PC0"."TANGGALCETAKDOKUMENPUCL_1" AS "CityID",
"PC0"."RCL_PUCL_1" AS "StatusReceiver",
 "PC0"."STATUSCLAIM_1" AS "StatusClaim"
FROM    DATAPEGA.pc_ASM_FW_GCNMFW_Work "PC0" where "PC0"."GROUPPANEL_1" = '002' and "PC0"."PXOBJCLASS" = 'ASM-FW-GCNMFW-Work-PNC' 
 and trunc("PC0"."TANGGALKIRIMPUCL_1") &gt;= to_date({TempRCLPUCLReport.AlasanKlaim},'dd/mm/yyyy') AND TRUNC ("PC0"."TANGGALKIRIMPUCL_1") &lt;= TO_DATE ({TempRCLPUCLReport.NoteKasir}, 'dd/mm/yyyy')</pyBrowseSQL>

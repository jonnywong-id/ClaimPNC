<pyBrowseSQL>select a.policyno as "PolicyNo",
           a.pyID as "ClaimID",
           a.pzinskey as "ClaimNo",
           a.qqname as "NewTelpTertanggung",
           a.TANGGALKIRIMPUCL_1 as "pxCreateDateTime",
           a.KOMENTARANALISATOR_1 as "NoteKomite",
           case when a.RCL_PUCL_1 = '1' then 'RCL'
                      when a.RCL_PUCL_1 = '2' then 'PUCL' 
           End as "Status",
           a.TANGGALCETAKDOKUMENPUCL_1 as "TanggalCetakDLA",
           a.LAMAKLAIM_1 as "LOGSEEN",
           a.STATUSKLAIM_1 as "StsAcceptance"
from DATAPEGA.pc_ASM_FW_GCNMFW_Work a 
INNER JOIN
            DATAPEGA.pc_assign_workbasket b
         ON (    (b."PXREFOBJECTKEY" = a."PZINSKEY")
             AND b."PXOBJCLASS" = 'Assign-WorkBasket'
             AND a."PXOBJCLASS" = 'ASM-FW-GCNMFW-Work-PNC')
   WHERE (    a."PYSTATUSWORK" &lt;&gt; 'Resolved-Completed'
          AND b."PXASSIGNEDOPERATORID" = 'RCLPUCL'
          AND a."TANGGALCETAKDOKUMENPUCL_1" IS NOT NULL
          AND a."PUCLAPPROVE_1" &lt;&gt; '1'
          AND a."MSIG_1" IS NULL)
order by a.TANGGALKIRIMPUCL_1 desc</pyBrowseSQL>

<pyBrowseSQL>SELECT v.nopla AS "City",
         v.nilaipla AS "Amount",
         (SELECT A.POLICYNO
            FROM datapega.pc_asm_fw_gcnmfw_work a
           WHERE pzinskey = x.claimid)
            AS "AlasanKlaim",
         (SELECT A.QQNAME
            FROM datapega.pc_asm_fw_gcnmfw_work a
           WHERE pzinskey = claimid)
            AS "Keyword",
         TO_CHAR ( (SELECT A.DATEOFLOSS_1
                      FROM datapega.pc_asm_fw_gcnmfw_work a
                     WHERE pzinskey = claimid),
                  'dd/mm/yyy')
            AS "Other",
         plareinsurer AS "CityID",
         (SELECT pyid
            FROM datapega.pc_asm_fw_gcnmfw_work
           WHERE pzinskey = claimid)
            AS "CaseID",
         TO_CHAR (tglpla, 'dd/mm/yyyy') AS "District",
         TO_CHAR (tglkirim, 'dd/mm/yyyy') AS "DistrictID",
         TO_CHAR (tglterimapla, 'dd/mm/yyyy') AS "Country",
         CASE
            WHEN iskirim IS NULL THEN 'Belum Dikirim'
            WHEN iskirim = '1' THEN 'Sudah Dikirim'
         END
            AS "CountryID",
         (SELECT userteknis_1
            FROM datapega.pc_asm_fw_gcnmfw_work
           WHERE pzinskey = claimid)
            AS "UserTeknis"
    FROM POOLDATA.t_plalist x,POOLDATA.VIEW_PLALIST v 
   WHERE X.NOPLA=V.NOPLA
   and tglpla BETWEEN to_date ({TempLaporan.AnalystTransferDate},'dd/mm/yyyy')  and to_date ({TempLaporan.DateOfLoss},'dd/mm/yyyy') 
{ASIS:TempLaporan.UserTeknis}
order by tglpla ASC</pyBrowseSQL>

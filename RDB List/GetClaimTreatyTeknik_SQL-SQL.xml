<pyBrowseSQL>select a.PXREFOBJECTKEY AS CARI1,
       a.PXREFOBJECTINSNAME AS CARI2,
       a.PXASSIGNEDOPERATORID AS CARI3,
       a.PZINSKEY AS CARI4,
       B.NOPOLIS AS CARI5,
       JSON_VALUE (B.DATA_JSONBLOB, '$.QuotationData.BusinessName') AS CARI6,
       JSON_VALUE (B.DATA_JSONBLOB, '$.QuotationData.SobName') AS CARI7,
       JSON_VALUE (B.DATA_JSONBLOB, '$.QuotationData.CedingCoName') AS CARI8,
       JSON_VALUE (B.DATA_JSONBLOB, '$.InsuredName') AS CARI9,
       JSON_VALUE (B.DATA_JSONBLOB, '$.DateOfLoss') AS CARI13,
       JSON_VALUE (B.DATA_JSONBLOB, '$.IsSubjectivity') AS CARI14,
       JSON_VALUE (B.DATA_JSONBLOB, '$.IDMaster') AS CARI15
from DATAPEGA.pc_assign_workbasket a left join
     pooldata.json_klaim b on  a.PXREFOBJECTKEY=b.IDPEGA
where PXASSIGNEDOPERATORID='TreatyinPNCTeknik'
and a.PXREFOBJECTKEY LIKE '%CLMP%'</pyBrowseSQL>

<pyBrowseSQL>SELECT a.id AS IDPEGA,
         b.id AS BUSINESSCODE,
         b.note AS BUSINESSNAME,
         c.id AS ACCUMCODE,
         c.type_document AS BRANCHNAME,
         a.object_doc_id AS BUSINESSTYPE,
         e.id AS CLIENTID,
         e.detail_document AS EDMNO,
         a.sts_wajib AS EDMTYPE,
         a.min_doc AS FOLLOWEDPOLICY,
         a.user_edit AS MARKETINGCODE
    FROM LST_TYPE_DOC_BUSINESS a,
         BUSINESS b,
         v_LST_DOC_TYPE c,
         v_LST_DET_TYPE_DOC e
   WHERE     b.id = a.businessid
         AND c.id = a.document_type_id
         AND e.id = a.DOC_TYPE_DT_ID
         AND b.id = {InputID.BUSINESSID}
{Asis:TempStatusAktif.BranchName}
ORDER BY a.id ASC</pyBrowseSQL>

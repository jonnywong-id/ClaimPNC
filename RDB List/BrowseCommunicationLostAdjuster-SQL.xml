<pyBrowseSQL>SELECT z.*
          FROM (SELECT
 a.pzinskey AS "AlasanDokterRejectRCL",a.REFNO_1 as "UserName",
a.CASEID_1  AS "CaseID",a.POLICYNO AS "Country", a.ASMSTATUS_1 AS "UserAdmin",
a.QQNAME AS "AnalystDoctorRemaks",a.USERTEKNIS_1 as "UserTeknis" ,a.ADJUSTERPIC_1 AS "AnaylstRemarks",
a.DATEOFLOSS_1 AS "DateOfLoss",a.AdjusterStatus_1 AS "CauseOfLossID",
a.pxcreatedatetime as "CPLValidDate",a.pyid as "City",a.RESCHEDULEDATE_1 AS "CityID",
a.RESCHEDULELOCATION_1 AS "ClaimNo", DateForAging_1 AS "DateForAging",a.PXCREATEOPNAME AS "District",(select b.BUSINESSNAME from datapega.PC_ASM_FW_GCNMFW_WORK b where a.CASEID_1 = B.PZINSKEY) as "KomiteStatus",
         z.BRANCHNAME AS "Email",
			ROW_NUMBER () OVER (ORDER BY a.pxcreatedatetime  desc) AS "rn"
FROM datapega.PC_ASM_FW_GCNMFW_WORK a, datapega.pc_assign_worklist b, (SELECT BRANCHNAME
            FROM POOLDATA.BRANCH
           WHERE ID IN  {ASIS:tempQuery.CaseID}
          UNION
          SELECT BRANCHNAME
            FROM POOLDATA.V_D_SURVEYORS
           WHERE D_SURVEY_ID in  {ASIS:tempQuery.CaseID}) z
WHERE 
B.PXASSIGNEDOPERATORID = {OperatorID.pyUserIdentifier}
and a.pxobjclass = 'ASM-FW-GCNMFW-Work-SurveyClaim'
AND a.PYSTATUSWORK NOT IN ('Resolved-Completed', 'Resolved-Rejected')
and a.pzInsKey = b.pxrefobjectkey
 AND EXISTS 
                 (SELECT *
                  from pooldata.m_komunikasi_pnc c
                 where a.pzinskey=c.caseid 
                 and c.KOMUNIKASISTATUS={TempView.DistrictID} 
                {ASIS:TempView.District} )
{ASIS:tempQuery.UserTeknisEmail}
{ASIS:TempSearch.source}) z
 WHERE "rn" &gt;= {ASIS:Pagination.FirstRow}  AND "rn" &lt;=  {ASIS:Pagination.LastRow}</pyBrowseSQL>

<pyBrowseSQL>SELECT A.noklaim                                       AS "ClaimID",
         A.hargarequest                                  AS "Email",
         A.tglrequest                                    "TglTerimaSalvage",
         A.namabarang                                    "BranchName",
         A.alasanrequest                                 AS "BranchID",
         A.hargabarang                                   AS "AgentID",
         A.idsalvage                                     AS "ClaimNo",
         A.IDDETAILSALVAGE                               AS "ClientName",
         A.NAMAKOMITE                                    AS "NamaKomite",
         TRUNC (SYSDATE) - TRUNC (A.tglrequest) || ' days' AS "AgingAmount"
    FROM POOLDATA.T_CLAIM_CHEKER_SALVAGE A
   WHERE     A.IDDETAILSALVAGE IN
                 (SELECT iddetailsalvage FROM POOLDATA.DETAIL_PNC_SALVAGE)
         AND A.hargarequest IS NOT NULL
         AND A.TGLAPPROVE IS NULL
         AND A.NAMAKOMITE ={TempLaporan.BranchName}
{Asis:TempLaporan.NoteKasir}
{Asis:TempLaporan.NoteKomite}
ORDER BY "AgingAmount" DESC</pyBrowseSQL>

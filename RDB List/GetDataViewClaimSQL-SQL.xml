<pyBrowseSQL>SELECT (SELECT lsc_note
          FROM POOLDATA.v_sts_claim
         WHERE lsc_id = a.data_json.StatusClaim)
          AS HASIL1,
       a.data_json.UserTeknis AS HASIL2,
       (SELECT CLAIMNO
          FROM POOLDATA.t_claim_pnc x
         WHERE x.nopolis = a.nopolis AND x.CLAIMID = a.idpega) AS HASIL3,
       to_date(a.data_json.RegisterDate, 'yyyy/mm/dd') AS HASIL4,
       a.data_json.DateOfLoss AS HASIL5,
       a.data_json.ReportDescription AS HASIL6
  FROM POOLDATA.json_klaim a
 WHERE nopolis = {InputViewClaim.CARI1}</pyBrowseSQL>

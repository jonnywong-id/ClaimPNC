<pyBrowseSQL>DECLARE 
  FLAGS VARCHAR2(32767);
  TKOMITE_ID VARCHAR2(32767);
  TNO_KLAIM VARCHAR2(32767);
  TNAMAKOMITE VARCHAR2(32767);
  TSTATUSCASE VARCHAR2(32767);
  TSTATUSAPPROVE VARCHAR2(32767);
  TNOTEKOMITE VARCHAR2(32767);
  TGROUP_PANEL VARCHAR2(32767);
  TPOLICYNO VARCHAR2(32767);
  TBISNISNAME VARCHAR2(32767);
  TQQNAME VARCHAR2(32767);
  TUSER_TEKNIS VARCHAR2(32767);
  TSOBNAME VARCHAR2(32767);
  TBRANCHNAME VARCHAR2(32767);
  TDATEOFCOMMITE_CREATE DATE;
  tlistkomite VARCHAR2(32767);
  tTypeKomite  VARCHAR2(32767);
 TPAYMENTTYPE VARCHAR2(32767);
  TSHAREASM NUMBER;
  TNILAIKLAIM NUMBER;
  ERRMSG VARCHAR2(32767);

BEGIN
  FLAGS := {TempInput.FlagASO};
  TKOMITE_ID  := {TempInput.KomiteNo};
  TNO_KLAIM := {TempInput.NoClaim};
  TNAMAKOMITE := {TempInput.BranchName};
  TSTATUSCASE := {TempInput.Status};
  TSTATUSAPPROVE := {TempInput.TelpMasking};
  TNOTEKOMITE := {TempInput.BusinessName};
  TGROUP_PANEL:= {TempInput.CityID};
  TPOLICYNO := {TempInput.City};
  TBISNISNAME := {TempInput.BranchID};
  TQQNAME := {TempInput.BusinessID};
  TUSER_TEKNIS := {TempInput.UserAdmin};
  TSOBNAME := {TempInput.CountryID};
  TBRANCHNAME := {TempInput.Sources};
  TDATEOFCOMMITE_CREATE := {TempInput.DateOfLoss DateTime};
  tlistkomite :={TempInput.AgentID};
  tTypeKomite    :={TempInput.NoteKasir};
 TPAYMENTTYPE := {TempInput.PayableTo};
  TSHAREASM :={TempInput.ShareCeding};
  TNILAIKLAIM :={TempInput.ClaimAmountAdjust};

  POOLDATA.INSERTDATAKOMITELIST ( FLAGS, TKOMITE_ID, TNO_KLAIM, TNAMAKOMITE, TSTATUSCASE, TSTATUSAPPROVE, TNOTEKOMITE, TGROUP_PANEL, TPOLICYNO, TBISNISNAME, TQQNAME, TUSER_TEKNIS, TSOBNAME, TBRANCHNAME, TDATEOFCOMMITE_CREATE, TLISTKOMITE, TTYPEKOMITE, TPAYMENTTYPE, TSHAREASM, TNILAIKLAIM, {TempInput.pyNote out});
  COMMIT; 
END;</pyBrowseSQL>

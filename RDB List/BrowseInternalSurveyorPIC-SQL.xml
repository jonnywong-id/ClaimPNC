<pyBrowseSQL>SELECT z.*
          FROM (SELECT a.PYID AS "CaseID",
         a.PZINSKEY AS "ClaimNo",
         a.POLICYNO AS "District",
         a.QQNAME AS "CountryID",
         a.BUSINESSNAME as "Country",
         a.sobname as "CityID",
         a.branchname as "City",
         a.pxCreateDateTime AS "pxCreateDateTime",
         a.dateofloss_1 as "DateOfLoss",
      ROW_NUMBER () OVER (ORDER BY a.pxCreateDateTime desc) AS "rn"
    FROM DATAPEGA.PC_ASM_FW_GCNMFW_WORK a, DATAPEGA.PC_ASSIGN_WORKLIST B
   WHERE     B.PXREFOBJECTINSNAME = a.PYID
         AND a.pxobjclass = 'ASM-FW-GCNMFW-Work-PNC'
         AND a.pyStatusWork NOT IN ('Resolved-Completed', 'Resolved-Rejected')
         AND b.pxassignedoperatorid IN {ASIS:TempOperator.CityID}
         {ASIS:TempSearch.source}
         AND EXISTS
                (SELECT *
                   FROM DATAPEGA.PC_ASM_FW_GCNMFW_WORK
                  WHERE pxobjclass = 'ASM-FW-GCNMFW-Work-SurveyClaim'
                        AND CaseID_1=a.pzInsKey
                        AND pyStatusWork NOT IN
                               ('Resolved-Completed', 'Resolved-Rejected')
                        AND SURVEYORTYPE_1 = '1')
                        AND not exists (select * from pooldata.t_claim_adjustment where claimid=a.pzinskey AND paymenttype!='3')) z
 WHERE "rn" &gt;= {ASIS:Pagination.FirstRow}  AND "rn" &lt;=  {ASIS:Pagination.LastRow}</pyBrowseSQL>

<pxOriginalCreateOperator/>
<pyBrowseSQL>SELECT count(distinct(claimno)) as "IsDLA",
         SUM (os_value) AS "DLAShare",
         SUM (aksep_value) AS "KlaimAmount",
         (SELECT note
          FROM pooldata.businessgroup
         WHERE id = a.businessgroupid) as "Country", 
        to_char(dateofloss,'dd/mm/yyyy') as "DLAType",
        col_desc as "Currency",
       businessgroupid as "IsKirim"
    FROM pooldata.t_claim_xol a
   WHERE     TO_CHAR (a.dateofloss, 'dd/mm/yyyy') ={TempMst.ObjectName} and A.COL_DESC={TempMst.NameOfBank}
         AND a.businessgroupid IN ({ASIS:TempMst.CurrencyID})
GROUP BY TO_CHAR (dateofloss, 'dd/mm/yyyy'), col_desc,a.businessgroupid</pyBrowseSQL>

<pyBrowseSQL>SELECT STATUS_PROGRESS1 AS "BranchID",
         ID_UPDATE AS "City",listagg(BranchName, ',') within group (order by ID_UPDATE,STATUS_PROGRESS1) as "BranchName"
    FROM POOLDATA.GCNM_PROGRESS_CLAIM a,json_table(JSONSTATUS_PROGRESS2,'$' columns(nested path '$.ObjectList[*]' columns(BranchName varchar2 path '$.BranchName')))
   WHERE     PNCCASEID = {tempinsertprogress.CityID}
         AND POSISIID = '1'
         AND UPPER (KETERANGAN) NOT LIKE '%AUTO%' group by ID_UPDATE,STATUS_PROGRESS1
ORDER BY ID_UPDATE DESC</pyBrowseSQL>

<pyBrowseSQL>SELECT 'KLAIM PA' AS "UserTeknis",
       'YUNIARPAMORSUARI' AS "Remark",
       'KOORDINASI PA' AS "Country",
       '11908020' as "Email",
       total_klaim as "BusinessName",
       {TempLaporan.AnalystTransferDate}|| ' - ' || {TempLaporan.DateOfLoss} AS "ClaimNo",
       pembayaran_klaim_pa as "CountryID",
       regist_klaim_pa as "NoteKasir",total_pembayaran_pa as "ClientName",total_klaim as "ClientID", 
       CASE
          WHEN (regist_klaim_pa / total_klaim) * 100 &lt; 0.5
          THEN
             5
          WHEN (regist_klaim_pa / total_klaim) * 100 BETWEEN 0.5
                                                                     AND 1
          THEN
             4
          WHEN (regist_klaim_pa / total_klaim) * 100 = 1
          THEN
             3
          WHEN (regist_klaim_pa / total_klaim) * 100 BETWEEN 1
                                                                     AND 1.5
          THEN
             2
          WHEN (regist_klaim_pa / total_klaim) * 100 BETWEEN 1.5
                                                                     AND 2
          THEN
             1
          ELSE
             0
       END
          AS "City",
          CASE
          WHEN (pembayaran_klaim_pa / total_klaim) * 100 &lt; 0.5
          THEN
             5
          WHEN (pembayaran_klaim_pa / total_klaim) * 100 BETWEEN 0.5
                                                                     AND 1
          THEN
             4
          WHEN (pembayaran_klaim_pa / total_klaim) * 100 = 1
          THEN
             3
          WHEN (pembayaran_klaim_pa / total_klaim) * 100 BETWEEN 1
                                                                     AND 1.5
          THEN
             2
          WHEN (pembayaran_klaim_pa / total_klaim) * 100 BETWEEN 1.5
                                                                     AND 2
          THEN
             1
          ELSE
             0
       END
          AS "CityID"
from (
select 
(SELECT COUNT (CLAIMNO)
                  FROM (SELECT B.CLAIMNO,
                               b.receivedate AS tgl_terima_dokumen,
                               B.REGISTERDATE AS tgl_trf_ke_teknik,
                                 datamining.get_working_hours@asmd.sinarmas.co.id (
                                    b.receivedate,
                                    b.REGISTERDATE)
                               / 28800
                                  AS tat_regis
                         FROM pooldata.t_claim_pnc b,
                               datapega.pc_asm_fw_gcnmfw_work d
                         WHERE b.claimid = d.pzinskey and B.STATUSWORK !='Resolved-Rejected'
                               AND pxcreateoperator IN
                                      ('IRMANOPITAPURBA_1',
                                       'IRMANOPITAPURBA',
                                       'YUNIARPAMORSUARI')
                               AND B.GROUPPANEL IN
                                      ('002') {ASIS:TempLaporan.BranchID})where tat_regis &gt;0) as regist_klaim_pa,
(SELECT COUNT (distinct(CLAIMNO))
                  FROM (SELECT B.CLAIMNO,
                               C.RECEIVEDATELOD AS tgl_terima_dokumen,
                               C.TGLAKSEPTASI AS tgl_trf_ke_teknik,
                                 datamining.get_working_hours@asmd.sinarmas.co.id (
                                    c.RECEIVEDATELOD,
                                    c.TGLAKSEPTASI)
                               / 28800
                                  AS tat_pembayaran
                         FROM pooldata.t_claim_pnc b,POOLDATA.T_CLAIM_ADJUSTMENT c,
                               datapega.pc_asm_fw_gcnmfw_work d
                         WHERE B.CLAIMID =C.CLAIMID and b.claimid = d.pzinskey and B.STATUSWORK !='Resolved-Rejected' and C.NOAKSEPTASI is not null
                               AND pxcreateoperator IN
                                      ('IRMANOPITAPURBA_1',
                                       'IRMANOPITAPURBA',
                                       'YUNIARPAMORSUARI')
                               AND B.GROUPPANEL IN
                                      ('002')
 {ASIS:TempLaporan.BranchID} ) where tat_pembayaran &gt;0) as pembayaran_klaim_pa,
(SELECT LISTAGG(CLAIMNO, ',') WITHIN GROUP (ORDER BY CLAIMNO)
                  FROM (SELECT B.CLAIMNO
                         FROM pooldata.t_claim_pnc b,
                               datapega.pc_asm_fw_gcnmfw_work d
                         WHERE b.claimid = d.pzinskey
                               AND pxcreateoperator IN
                                      ('IRMANOPITAPURBA_1',
                                       'IRMANOPITAPURBA',
                                       'YUNIARPAMORSUARI')
                               AND B.GROUPPANEL IN
                                      ('002')  {ASIS:TempLaporan.BranchID}) group by claimno)  as Klaim_PA,
(SELECT COUNT (CLAIMNO)
                  FROM (SELECT B.CLAIMNO,
                               b.receivedate AS tgl_terima_dokumen,
                               B.REGISTERDATE AS tgl_trf_ke_teknik,
                                 datamining.get_working_hours@asmd.sinarmas.co.id (
                                    b.receivedate,
                                    b.REGISTERDATE)
                               / 28800
                                  AS tat_regis
                         FROM pooldata.t_claim_pnc b,
                               datapega.pc_asm_fw_gcnmfw_work d
                         WHERE b.claimid = d.pzinskey and B.STATUSWORK !='Resolved-Rejected'
                               AND pxcreateoperator IN
                                      ('IRMANOPITAPURBA_1',
                                       'IRMANOPITAPURBA',
                                       'YUNIARPAMORSUARI')
                               AND B.GROUPPANEL IN
                                      ('002')
                                {ASIS:TempLaporan.BranchID})) as total_klaim,
(SELECT COUNT (distinct(CLAIMNO))
                  FROM (SELECT B.CLAIMNO,
                               C.RECEIVEDATELOD AS tgl_terima_dokumen,
                               C.TGLAKSEPTASI AS tgl_trf_ke_teknik,
                                 datamining.get_working_hours@asmd.sinarmas.co.id (
                                    c.RECEIVEDATELOD,
                                    c.TGLAKSEPTASI)
                               / 28800
                                  AS tat_pembayaran
                         FROM pooldata.t_claim_pnc b,POOLDATA.T_CLAIM_ADJUSTMENT c,
                               datapega.pc_asm_fw_gcnmfw_work d
                         WHERE B.CLAIMID =C.CLAIMID and b.claimid = d.pzinskey and B.STATUSWORK !='Resolved-Rejected' and C.NOAKSEPTASI is not null
                               AND pxcreateoperator IN
                                      ('IRMANOPITAPURBA_1',
                                       'IRMANOPITAPURBA',
                                       'YUNIARPAMORSUARI')
                               AND B.GROUPPANEL IN
                                      ('002')
                               AND TRUNC (b.receivedate) BETWEEN TO_DATE (
                                                                     '01/01/2023',
                                                                     'dd/mm/yyyy')
                                                              AND TO_DATE (
                                                                     '10/11/2023',
                                                                     'dd/mm/yyyy')) where tat_pembayaran &gt;0) as total_pembayaran_pa from dual)</pyBrowseSQL>

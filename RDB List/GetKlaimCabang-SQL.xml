<pyBrowseSQL>select b.* from (
select a.*, ROWNUM rn from (SELECT A.PYID AS "PNCCaseID",
                 A.PZINSKEY AS "TypeOfClaim",
                 A.POLICYNO AS "PolicyNo",
                 'ASSIGN-WORKLIST '||trim(A.PZINSKEY)||'!'||trim(B.PXFLOWNAME) as "Sender",
                'pnc' as "pyNote",
                 A.QQNAME AS "QQName",
                 A.REPORTDATE_1 AS "ReceivedDate",
                 A.DATEOFLOSS_1 AS "TglKejadian",
                 A.pxCreateDateTime AS "pxCreateDateTime",
                 BUSINESSNAME AS "JenisDokumen",
                 A.SOBNAME AS "RCVID",
                 BRANCHNAME AS "NumberOfDocument",
                 A.PXCREATEOPERATOR AS "Keterangan",
                 B.PXFLOWNAME AS "Kurir",
                 e.insertdate AS "DateForAging",
                 A.KODECABANG_1 AS "StatusKomunikasi",
                 CASE
                            when FLAGBISNIS='OTO' or FLAGBISNIS='BFI' then
                                case  
                                    WHEN e.statuslod = '1' THEN 'Belum Upload'
                                    WHEN e.statuslod = '2' THEN 'Sudah Upload'
                                end
                            else 
                                case  
                                    WHEN e.statuslod = '0' THEN 'Belum Upload'
                                    WHEN e.statuslod = '1' THEN 'Sudah Upload'
                                end
                         END
                            AS "StatusWorkCase",
                 (SELECT C.BRANCHNAME FROM pooldata.BRANCH C, DATAPEGA.PC_ASM_FW_GCNMFW_WORK e WHERE e.KODECABANG_1=C.ID and  e.pyid=a.pyid) AS "UserAdmin",
                 CASE
                    WHEN a.pystatuswork = 'New' THEN 'On Progress'
                    WHEN a.pystatuswork = 'Resolved-Rejected' THEN 'Reject'
                    WHEN a.pystatuswork = 'Resolved-Completed' THEN 'Close'
                 END as "PosisiProgressID"   
            FROM DATAPEGA.PC_ASM_FW_GCNMFW_WORK A,
                 DATAPEGA.PC_ASSIGN_WORKLIST B,
                  pooldata.business c,
                 pooldata.businessgroup d,
                  POOLDATA.T_CLAIM_JOB_PERSONALACCIDENT e
           WHERE B.PXREFOBJECTINSNAME = A.PYID
                 AND E.CLAIMID = a.pzinskey
                 AND A.pxobjclass = 'ASM-FW-GCNMFW-Work-PNC'
                 AND A.BUSINESSCODE_1 = c.id
                 AND c.businessgroupid = d.id
                 and b.pxflowname not like '%FixCorrespondence%'
                AND (b.pxtasklabel='Input Register' or b.pxtasklabel='Input Estimasi'  or b.pxtasklabel='Estimation')
                AND (a.branchname != 'ASNET' or a.branchname is null)
                {ASIS:TempView.Remark}
               {ASIS:TempView.Currency}
               {ASIS:TempView.pyNote}
               {ASIS:TempContents.Keyword}
               {ASIS:TempView.Location}
 order by a.pystatuswork asc,a.pxcreatedatetime DESC) a)b
{ASIS:TempContents.NoteKasir}</pyBrowseSQL>

<pyBrowseSQL>WITH SHOWPERSON
     AS (  SELECT MergeJSONObjectToAdopt_PERSON (OBJECTDATA,
                                                 COVERAGEDATA,
                                                 HEIRDATA) 
                     AS HASIL1 , ROW_NUMBER () OVER (ORDER BY indexobject) AS RowN, indexobject
             FROM t_Personlist
            WHERE idpega = {BrowseObjEDM.CARI3}
         ORDER BY indexobject ASC)
  SELECT HASIL1 ,RowN ,indexobject
    FROM SHOWPERSON
  WHERE       RowN &gt;={ASIS:Pagination.FirstRow} 
AND       RowN &lt;= {ASIS:Pagination.LastRow}
 order by indexobject asc</pyBrowseSQL>

<pyBrowseSQL>SELECT noakseptasi as "AccountNo",
       nilaiakseptasi as "BranchCode",
       remark as "ObjectID",
       namabarang as "AccountName",
       pemenangsalvage as "BranchName",
      sum(HARGAITEM) as "NilaiOS",
       (CASE
           WHEN statusterjual = '1' THEN 'Terjual'
           WHEN statusterjual = '0' THEN 'Tidak terjual'
           WHEN statusterjual = '3' THEN 'Waiting approval'
           WHEN statusterjual IS NULL THEN 'Belum terjual'
           ELSE '-'
        END) as "CityID",
        count(namabarang) || ' ' || satuan as "City",
        satuan as "PLAID"
  FROM pooldata.detail_pnc_salvage
 WHERE noklaim = {TempSal.BranchID} AND idsalvage = {TempSal.AlasanKlaim}
 group by noakseptasi,nilaiakseptasi,namabarang,remark,pemenangsalvage,statusterjual,satuan
order by namabarang</pyBrowseSQL>

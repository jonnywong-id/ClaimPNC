<pyBrowseSQL>SELECT A.CLAIMNO AS "ClaimNo",                   
       A.NOPOLIS AS "PolicyNo",                     
       A.PICTEKNIK AS "PICRekanan",                 
       to_char(A.REGISTERDATE,'dd/MM/yyyy') AS "RegisterDate",             
       to_char(A.DATEOFLOSS,'dd/MM/yyyy') AS "DateOfLoss",                
       A.QQNAME AS "UserName",                       
       B.CAUSEOFLOSS AS "CauseOfLoss",              
       A.SOBNAME AS "BusinessName",                  
       (SELECT LOCATION_1 FROM DATAPEGA.PC_ASM_FW_GCNMFW_WORK WHERE A.CLAIMID=PZINSKEY) AS "Location",                                   
       (SELECT SUM(PRICE) FROM POOLDATA.T_CLAIM_TREATMENT WHERE A.CLAIMID=CLAIMID AND TREATMENTTYPE='1') AS "AlasanKlaim",      
       (SELECT AVG(DISKON) FROM POOLDATA.T_CLAIM_TREATMENT WHERE A.CLAIMID=CLAIMID AND TREATMENTTYPE='1') AS  "AlasanTerlambat",         
       (SELECT SUM(TREATMENTVALUE) FROM POOLDATA.T_CLAIM_TREATMENT WHERE A.CLAIMID=CLAIMID AND TREATMENTTYPE='1') AS  "City",                      
       (SELECT SUM(PRICE) FROM POOLDATA.T_CLAIM_TREATMENT WHERE A.CLAIMID=CLAIMID AND TREATMENTTYPE='2') AS "District",         
       (SELECT AVG(DISKON) FROM POOLDATA.T_CLAIM_TREATMENT WHERE A.CLAIMID=CLAIMID AND TREATMENTTYPE='2') AS "BranchName",               
       (SELECT SUM(TREATMENTVALUE) FROM POOLDATA.T_CLAIM_TREATMENT WHERE A.CLAIMID=CLAIMID AND TREATMENTTYPE='2') AS  "ConsultantName",           
       (SELECT NAMA_BENGKEL FROM POOLDATA.T_CLAIM_PENAWARAN WHERE CLAIMID=A.CLAIMID FETCH NEXT 1 ROW ONLY) AS "InsuredName",             
       (SELECT WILAYAH_BENGKEL FROM POOLDATA.T_CLAIM_PENAWARAN WHERE CLAIMID=A.CLAIMID FETCH NEXT 1 ROW ONLY) AS "NamaDokumen",          
       (SELECT SUPPLIERNAME FROM POOLDATA.T_CLAIM_PANEL WHERE CLAIMID=A.CLAIMID FETCH NEXT 1 ROW ONLY) AS "NamaSurveyor",                 
       (SELECT Z.OCCUPATIONNAME FROM POOLDATA.T_ANEKALIST Z WHERE A.NOPOLIS=Z.NOPOLIS AND A.PRODKE=Z.PRODKE AND B.OBJECTID=Z.INDEXOBJECT FETCH NEXT 1 ROW ONLY) AS "Occupation",   
       (SELECT MODELNAME FROM POOLDATA.T_CLAIM_OBJECTLIST C WHERE C.CLAIMID = A.CLAIMID AND B.OBJECTID=C.OBJECTID) AS "UserTeknis",       
       (SELECT BRANDNAME FROM POOLDATA.T_CLAIM_OBJECTLIST C WHERE C.CLAIMID = A.CLAIMID AND B.OBJECTID=C.OBJECTID) AS "UserTeknisEmail", 
       (SELECT MANUFACTUREYEAR FROM POOLDATA.T_CLAIM_OBJECTLIST C WHERE C.CLAIMID = A.CLAIMID AND B.OBJECTID=C.OBJECTID) AS "TreatyName", 
       (SELECT C.ENGINENUMBER FROM POOLDATA.T_CLAIM_OBJECTLIST C WHERE C.CLAIMID = A.CLAIMID AND B.OBJECTID=C.OBJECTID) AS "TreatyYear", 
       (SELECT C.CHASISSNUMBER FROM POOLDATA.T_CLAIM_OBJECTLIST C WHERE C.CLAIMID = A.CLAIMID AND B.OBJECTID=C.OBJECTID) AS "ClientName", 
       (SELECT SUM(CONVERTVALUE) FROM POOLDATA.T_CLAIM_ESTIMASI T WHERE T.CLAIMID = A.CLAIMID) AS "Remark",                              
       (SELECT SUM(X.TOTAL_CLAIM) FROM POOLDATA.T_CLAIM_ADJUSTMENT X WHERE X.CLAIMID = A.CLAIMID) AS "EmailTertanggung",                  
       (SELECT SUM(X.GROSSVALUE) FROM POOLDATA.T_CLAIM_ADJUSTMENT X WHERE X.CLAIMID = A.CLAIMID) AS "Province"                         
FROM T_CLAIM_PNC A, T_CLAIM_OBJECTCOVERAGE B
WHERE A.BUSINESSCODE='10043'
AND A.CLAIMID=B.CLAIMID
{ASIS:TempLaporan.AlasanKlaim}</pyBrowseSQL>

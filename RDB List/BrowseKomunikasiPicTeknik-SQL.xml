<pyBrowseSQL>SELECT z.*
          FROM (SELECT a.pyID AS "ClaimNo",
       a.pzinskey AS "CaseID",
       a.policyno AS "District",
       a.qqname AS "CountryID",
       a.BUSINESSNAME AS "Country",
       a.sobname AS "CityID",
       a.branchname AS "City",
       a.pxcreateopname AS "ReporterName",
       a.pxCreateDateTime AS "ReportDate",
       a.dateofloss_1 AS "DateOfLoss",
       a.statusclaim_1 AS "StatusClaim",
       a.pyStatusWork,
       CASE 
            WHEN a.DateForAging_1 is null THEN a.pxCreateDateTime  
            WHEN a.DateForAging_1 is not null THEN a.DateForAging_1  
       END AS "DateForAging",
       (select leader_member from pooldata.t_claim_pnc where claimid=a.pzinskey) as "IsPLA",
        (SELECT kom.replymessage from pooldata.m_komunikasi_pnc kom where (a.pnccaseid=kom.caseid OR a.caseid_1=kom.caseid) AND kom.komunikasistatus={TempView.ClaimNo}
                 {ASIS:TempView.CaseID} order by kom.createdatereply desc fetch next 1 rows only) as "LossCoverage",
	  ROW_NUMBER () OVER (ORDER BY a.pxCreateDateTime desc) AS "rn"
  FROM datapega.pc_asm_fw_gcnmfw_work a,
       datapega.pc_assign_worklist b
 WHERE     a.pxobjclass = 'ASM-FW-GCNMFW-Work-PNC'
       AND a.pzInsKey = b.pxrefobjectkey
       AND a.pyStatusWork NOT IN ('Resolved-Completed', 'Resolved-Rejected')
      {ASIS:TempSearch.source}
       AND EXISTS
                (SELECT *
                   FROM pooldata.m_komunikasi_pnc kom
                  WHERE (a.pnccaseid=kom.caseid OR a.caseid_1=kom.caseid or a.pzinskey=kom.caseid) 
                        AND kom.komunikasistatus={TempView.ClaimNo}
                        {ASIS:TempView.CaseID})
       AND b.pxassignedoperatorid IN {ASIS:TempOperator.CityID}) z
 WHERE "rn" &gt;= {ASIS:Pagination.FirstRow}  AND "rn" &lt;=  {ASIS:Pagination.LastRow}</pyBrowseSQL>

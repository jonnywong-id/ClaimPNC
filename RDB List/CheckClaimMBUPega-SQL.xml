<pyBrowseSQL>SELECT mke.mke_no_rangka AS "HASIL1",
       mke.mke_no_mesin AS "HASIL2",
       mkl.mkl_tgl_input AS "HASIL3",
       (CASE
           WHEN EXISTS
                   (SELECT 1
                      FROM mst_jn_klaim
                     WHERE mkl_no_spk = mkl.mkl_no_spk AND lkk_id = '01')
           THEN
              'STOLEN'
           WHEN EXISTS
                   (SELECT 1
                      FROM mst_jn_klaim
                     WHERE mkl_no_spk = mkl.mkl_no_spk AND lkk_id = '02')
           THEN
              'CTLO'
           WHEN EXISTS
                   (SELECT 1
                      FROM mst_jn_klaim
                     WHERE mkl_no_spk = mkl.mkl_no_spk AND lkk_id = '03')
           THEN
              'PARTIAL LOSS'
        END)
          "HASIL4",
       (SELECT mke_tgl_kjd
          FROM mst_kejadian
         WHERE mkl_no_spk = mkl.mkl_no_spk AND mke_id = '1')
          "HASIL5",
       (CASE WHEN mkl.lpm_id = '99' THEN '0' ELSE '1' END) "HASIL6",
       mkl.mkl_no_aksep "HASIL7",
       (CASE
           WHEN EXISTS
                   (SELECT 1
                      FROM mst_akseptasi
                     WHERE     mkl_no_spk = mkl.mkl_no_spk
                           AND mak_sts_lunas = 1
                           AND mak_no_cd IS NOT NULL)
           THEN
              'LUNAS / SUDAH BAYAR'
           ELSE
              'BELUM LUNAS / BELUM BAYAR'
        END)
          AS "HASIL8",
       (SELECT SUM (
                    A.mwo_ttl_rg
                  + A.mak_ttl_tjh
                  - (A.mak_or * A.mak_kali_or)
                  - A.mak_pph_jasa
                  + (  A.mak_ppn_jasa_od
                     + A.mak_ppn_material_od
                     + A.mak_ppn_jasa_tjh
                     + A.mak_ppn_material_tjh))
                  AS net_aksep
          FROM mst_akseptasi a
         WHERE     mkl_no_spk = mkl.mkl_no_spk
               AND mak_sts_lunas = 1
               AND mak_no_cd IS NOT NULL)
          AS "HASIL9"
  FROM mst_klaim mkl, mbu.mapping_klaim_pega mke
 WHERE     mkl.mnk_no_klaim = mke.no_klaim
       AND mkl.mke_no_id = mke.mke_no_id
       AND mkl.mkl_no_polis = {InputSearchClaim.CARI1}</pyBrowseSQL>

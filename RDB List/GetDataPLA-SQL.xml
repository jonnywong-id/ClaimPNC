<pyBrowseSQL>SELECT NOPLA AS "NoPLA",
       NILAIPLA AS "ResultPLA",
       PLAREINSURER AS "PLAReinsurer",
       REINSCODE AS "ReinsCode",
       TIPEPLA AS "TipePLA",
       CURRENCY AS "Currency",
       CURRENCYPOLIS AS "CurrencyPolicy",
       SHARESPREADING AS "SharePLA",
       PERCENTPLA AS "PercentPLA",
       ESTIMASI AS "EstimastionReserve",
       ESTIMASISHARE AS "EstimationValue",
       QSRI AS "EstimateNum",
       QSPQS AS "pyNote",
       LOGIN AS "pyLabel",
       COUNTRY AS "Country",
       EMAILPLA AS "pyEmailAddress",
       REVISI AS "Revisi",
       NOTES AS "PLARemarks",
       ISPLA AS "IsPLA",
       ISKIRIM AS "IsKirim",
       TGLPLA AS "Date",
       OBJECTCOVERAGEID AS "CoverageID",
       OBJECTID AS "ObjectID",
        JSON_PLA AS "pyID",
       LOCATIONID as "LocationID"
  FROM POOLDATA.T_PLALIST
 WHERE CLAIMID = {TempPLADLA2.Initial}
       AND OBJECTID = {TempPLADLA2.IDObject}
       AND OBJECTCOVERAGEID = {TempPLADLA2.IDCoverage}
      {ASIS:TempPLADLA2.RemarkAccepted}
       {ASIS:TempPLADLA2.Receiver}
       {ASIS:TempPLADLA2.Remarks}
ORDER BY TGLPLA ASC</pyBrowseSQL>

<pyBrowseSQL>SELECT z.*
          FROM (SELECT a.PYID AS "CaseID",
         a.PZINSKEY AS "ClaimNo",
         a.POLICYNO AS "AlasanTerlambat",
         a.QQNAME AS "AnalystDoctorRemaks",
         a.pxCreateDateTime AS "pxCreateDateTime",
         c.REFNO_1 AS "UserName",
         c.AdjusterPIC_1 AS "NoKTP",
         c.USERTEKNIS_1 AS "UserTeknis",
         c.AdjusterStatus_1 AS "CauseOfLoss",
         C.SURVEYORNAME_1 AS "AnaylstRemarks",
         CASE 
            WHEN a.DateForAging_1 is null THEN a.pxCreateDateTime  
            WHEN a.DateForAging_1 is not null THEN a.DateForAging_1  
       END AS "DateForAging",
       (select leader_member from pooldata.t_claim_pnc where claimid=a.pzinskey) as "City",
	  ROW_NUMBER () OVER (ORDER BY a.pxCreateDateTime desc) AS "rn"
    FROM DATAPEGA.PC_ASM_FW_GCNMFW_WORK a, DATAPEGA.PC_ASSIGN_WORKLIST B, DATAPEGA.PC_ASM_FW_GCNMFW_WORK C
   WHERE     B.PXREFOBJECTINSNAME = a.PYID
         AND a.pxobjclass = 'ASM-FW-GCNMFW-Work-PNC'
         AND C.PXOBJCLASS='ASM-FW-GCNMFW-Work-SurveyClaim'
         and c.CaseID_1 = a.pzinskey
         AND a.pyStatusWork NOT IN ('Resolved-Completed', 'Resolved-Rejected')
         AND b.pxassignedoperatorid IN {ASIS:TempOperator.CityID}
        {ASIS:TempSearch.source}
         AND C.SURVEYORTYPE_1 = '2'
                        AND C.PYSTATUSWORK not in ('Resolved-Completed','Resolved-Rejected') ) z
 WHERE "rn" &gt;= {ASIS:Pagination.FirstRow}  AND "rn" &lt;=  {ASIS:Pagination.LastRow}</pyBrowseSQL>

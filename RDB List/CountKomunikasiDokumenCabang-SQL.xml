<pyBrowseSQL>SELECT  count(1) as "ref_no"
  FROM datapega.pc_asm_fw_gcnmfw_work a,
       datapega.pc_assign_worklist b
 WHERE     a.pxobjclass = 'ASM-FW-GCNMFW-Work-PNC'
       AND a.pyid = b.PXREFOBJECTINSNAME
       AND a.pyStatusWork NOT IN ('Resolved-Completed', 'Resolved-Rejected')
       AND EXISTS
                (SELECT *
                   FROM pooldata.t_claim_pnc c, pooldata.m_komunikasi_pnc kom
                  WHERE (c.claimno=a.pyid) 
                        AND komunikasistatus={TempView.ClaimNo}
                        and kom.sender!={TempOperator.CityID})
                        and a.pyid in (select communicate_to from pooldata.m_komunikasi_pnc kom where kom.communicate_to=a.pyid)
                        AND b.pxassignedoperatorid IN {ASIS:TempOperator.CityID}
                        {ASIS:TempSearch.source}</pyBrowseSQL>

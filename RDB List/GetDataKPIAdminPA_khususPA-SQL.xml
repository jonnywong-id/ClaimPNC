<pyBrowseSQL>select * from (SELECT B.CLAIMNO AS "AnaylstRemarks",
'KLAIM PA' as "Country",
'Regist Klaim PA' as "CountryID",
B.NOPOLIS as "AreaClaimId",
(select TO_CHAR(g.STARTDATE, 'dd/mm/yyyy') from POOLDATA.T_GENERAL g where g.nopolis=B.NOPOLIS and G.PRODKE=B.PRODKE) as "BusinessID",
(select TO_CHAR(G.ENDDATE, 'dd/mm/yyyy') from POOLDATA.T_GENERAL g where g.nopolis=b.NOPOLIS and G.PRODKE=B.PRODKE) as "BusinessName",
       d.pxcreateoperator as "UserAdmin",
       TO_CHAR (B.RECEIVEDATE, 'dd/mm/yyyy') AS "City",
       TO_CHAR (b.registerdate, 'dd/mm/yyyy') AS "CityID",
       case when C.RECEIVEDATELOD is not null then TO_CHAR (C.RECEIVEDATELOD, 'dd/mm/yyyy')
       else TO_CHAR (C.TGLAKSEPTASI, 'dd/mm/yyyy') end AS "BranchID",
       TO_CHAR (C.TGLAKSEPTASI, 'dd/mm/yyyy') AS "BranchName",
         datamining.get_working_hours@asmd.sinarmas.co.id (b.RECEIVEDATE,
                                                           b.registerdate)
       / 28800
          AS "NIK",
         datamining.get_working_hours@asmd.sinarmas.co.id (case when C.RECEIVEDATELOD is not null then c.RECEIVEDATELOD else c.TGLAKSEPTASI end,
                                                           c.TGLAKSEPTASI)
       / 28800
          AS "ClientID", 
         case when datamining.get_working_hours@asmd.sinarmas.co.id (b.RECEIVEDATE,
                                                           b.registerdate)
       / 28800&gt;1 then 'TIDAK SLA' else 'SLA' end as "NPWP",
       case when datamining.get_working_hours@asmd.sinarmas.co.id (case when C.RECEIVEDATELOD is not null then c.RECEIVEDATELOD else c.TGLAKSEPTASI end,
                                                           c.TGLAKSEPTASI)
       / 28800&gt;1 then 'TIDAK SLA' else 'SLA' end as "ClientName",
       Case when d.pystatuswork='Resolved-Rejected' then 'Rejected' when D.PYSTATUSWORK='Resolved-Completed' then 'Close' else 'Outstanding' end as "STS_NOTELP",
rownum as "RN"
  FROM pooldata.t_claim_pnc b,
       POOLDATA.T_CLAIM_ADJUSTMENT c,
       datapega.pc_asm_fw_gcnmfw_work d
 WHERE     B.CLAIMID = C.CLAIMID
       AND b.claimid = d.pzinskey
       AND pxcreateoperator IN
              ('IRMANOPITAPURBA_1', 'IRMANOPITAPURBA', 'YUNIARPAMORSUARI')
       AND B.GROUPPANEL IN ('002')
{ASIS:TempLaporan.Remark}
) {ASIS:TempLaporan.NoteKasir}</pyBrowseSQL>

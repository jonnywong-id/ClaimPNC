<pyBrowseSQL>select agenid AS "LSC_ID" , batch AS "OLD_LSC_ID" from pooldata.tmp_batch_claim_kredit a  where idpega is null and (progress is null or progress='0') 
{ASIS:TempGroup.District}
 AND (
        NOT EXISTS (
            SELECT 1 
            FROM pooldata.TMP_BATCH_CLAIM_KREDIT_H h
            WHERE h.agenid = a.agenid
              AND h.batch = a.batch
        )
        OR
        EXISTS (
            SELECT 1
            FROM pooldata.TMP_BATCH_CLAIM_KREDIT_H h
            WHERE h.agenid = a.agenid
              AND h.batch = a.batch
              AND h.sts_approve = '1'
        )
      )
GROUP BY a.agenid, a.batch
FETCH FIRST 1 ROW ONLY</pyBrowseSQL>

<pyBrowseSQL>SELECT b.*
  FROM (SELECT a.*, ROWNUM rn
          FROM (  SELECT b.claimid AS "SubjectEmail",
                         a.pyid AS "PNCCaseID",
                         b.surveyor AS "RCVID",
                         b.branch AS "Keterangan",
                         a.BranchName AS "Kurir",
                         SUBSTR (b.surveyid, 20, 30) AS "UserAdmin",
                         TO_CHAR (b.inputdate, 'dd/mm/yyyy') AS "StatusKomunikasi",
                         a.policyno AS "PolicyNo",
                         a.userteknis_1 AS "Resource",
                         B.LOCATION as "LokasiKejadian",
                         B.NOTELP as "TelpPengirim",
                         TO_CHAR (B.DATE_SURVEY, 'dd/mm/yyyy') as "PICRekanan",
                         B.OBJECTNAME as "KronologisKejadian",
                         B.QQNAME as "QQName",
                         B.REQ_NAME as "RincianKerusakan"
                    FROM datapega.pc_asm_fw_gcnmfw_work a,
                         pooldata.t_req_survey b,
                         DATAPEGA.PC_ASSIGN_WORKLIST c
                   WHERE     REQUESTSURVEY_1 = '1'
                         AND a.pzinskey = b.claimid
                         AND b.claimid = c.PXREFOBJECTKEY
                         AND a.PYSTATUSWORK NOT IN ('Resolved-Completed', 'Resolved-Rejected')
                         AND c.pxassignedoperatorid = {OperatorID.pyUserIdentifier}
                         AND not exists (select * from pooldata.t_claim_adjustment where claimid=a.pzinskey AND paymenttype!='3')
                         {ASIS:TempView.Currency}
                         {ASIS:TempContents.Keyword}
                ORDER BY b.inputdate DESC) a) b
                         {ASIS:TempContents.NoteKasir}</pyBrowseSQL>

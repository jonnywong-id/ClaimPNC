<pyBrowseSQL>SELECT BUSINESSGROUPID AS "CurrencyID", BUSINESSGROUPNAME AS "KomiteComment"
    FROM pooldata.business
   WHERE BUSINESSGROUPID IN
             (SELECT ID
                FROM pooldata.BUSINESSGROUP
               WHERE TOPID IN (SELECT DISTINCT TREATYGROUPID
                                 FROM POOLDATA.proportionalarrg {Asis:TempXOL.AgentID}
                               ))
GROUP BY BUSINESSGROUPID, BUSINESSGROUPNAME</pyBrowseSQL>

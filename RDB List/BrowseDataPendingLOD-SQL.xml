<pyBrowseSQL>SELECT b.nopolis AS "PolicyNo",
       b.claimno AS "ClaimNo",
       b.picteknik AS "UserTeknis",
       b.qqname AS "InsuredName",
       b.leader_member AS "Status",
       (SELECT CURRENCY FROM pooldata.CURRENCY WHERE ID = A.CURRENCY) AS "Currency",
       a.propose_value AS "ClientID",
       a.grossvalue AS "ClientName",
       individual_risk_value AS "CloseClaimNote",
       TO_CHAR (a.printlod_date, 'dd/mm/yyyy') AS "City",
       TO_CHAR (b.dateofloss, 'dd/mm/yyyy') AS "CityID"
  FROM pooldata.t_claim_adjustment a,
       pooldata.t_claim_pnc b,
       pooldata.pega_dashboardpnc c,
       datapega.pc_asm_fw_gcnmfw_work d
 WHERE     STATUSAKSEPTASI IN ('0', '1')
       AND STATUSAKSEPTASILOD IS NULL
       AND paymenttype IN ('1', '2')
       AND a.claimid = b.claimid
       AND b.claimno = c.noklaim
       AND b.claimid = d.pzinskey
       AND (   d.pystatuswork NOT IN
                  ('Resolved-Completed', 'Resolved-Rejected')
            OR d.ISPENDINGCLOSE = 'true')
       AND a.noakseptasi IS NULL
       AND b.branchname != 'ASNET'
       AND GROSSVALUE IS NOT NULL
{ASIS:TempLaporan.UserTeknis}
{ASIS:TempLaporan.ClaimID}
ORDER BY REGISTERDATE DESC</pyBrowseSQL>

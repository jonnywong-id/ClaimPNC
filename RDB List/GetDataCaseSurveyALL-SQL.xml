<pyBrowseSQL>SELECT pzinskey AS "ClaimNo"
   FROM datapega.pc_asm_fw_gcnmfw_work
   WHERE  pxobjclass='ASM-FW-GCNMFW-Work-SurveyClaim' 
   and ADJUSTERSTATUS_1 not in ('Final Report','Close Case','Invoice Fee')
   {ASIS:TempAdjuster.UserTeknis}
    AND SURVEYORTYPE_1  = '2'
    AND SURVEYORNAME_1 IS NOT NULL
    AND (ASMSTATUS_1!='MEMBER' OR ASMSTATUS_1 IS NULL)
    AND PYSTATUSWORK!='Resolved-Rejected'
UNION ALL
SELECT pzinskey AS "ClaimNo"
   FROM datapega.pc_asm_fw_gcnmfw_work
   WHERE  pxobjclass='ASM-FW-GCNMFW-Work-SurveyClaim' 

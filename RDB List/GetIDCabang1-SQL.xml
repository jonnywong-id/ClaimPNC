<pyBrowseSQL>select id AS "KodeCabang" from branch a, hrdasm.v_hrd_mst@asmd.sinarmas.co.id c, lst_user_asuransi@asmd.sinarmas.co.id b
where c.login_aplikasi = {TempCabang.UserAdmin}
and c.nik=b.nik
and b.cab_id=a.oldid
union 
select D_SURVEY_ID AS "KodeCabang" from V_D_SURVEYORS
where m_survey_id in ('1002','1004','1001')
and login_aplikasi  = {TempCabang.UserAdmin}</pyBrowseSQL>

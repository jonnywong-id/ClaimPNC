<pyBrowseSQL>SELECT z.*
          FROM (SELECT b.claimid AS BRANCH_NAME,
       b.nopolis AS POLICY_NO,
       b.qqname AS CUSTOMER,
       b.claimno AS BRANCH_CODE,
       b.registerdate AS START_DATE,
       b.dateofloss AS END_DATE,
       b.picteknik as BUSINESS_NAME,
      (select x.TGLDLA from t_predlalist x where B.CLAIMID = X.CLAIMID and x.iskirim IS NULL order by x.TGLDLA desc fetch next 1 row only) as "pyCreateDate",
			ROW_NUMBER () OVER (ORDER BY b.registerdate ASC) AS "rn"
  FROM t_claim_pnc b
 WHERE     EXISTS
              (SELECT *
                 FROM t_predlalist
                WHERE claimid = b.claimid AND noaksep IS NULL
                        {ASIS:TempPLA.CURRENCY})
       AND b.grouppanel != '002'
       AND b.grouppanel != '005'
{ASIS:TempPLA.ASMSurveyor}) z
 WHERE "rn" &gt;= {ASIS:Pagination.FirstRow}  AND "rn" &lt;=  {ASIS:Pagination.LastRow}</pyBrowseSQL>

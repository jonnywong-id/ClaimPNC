<pyBrowseSQL>SELECT a.CLAIMID AS "IDPEGA", a.NOPOLIS, a.CLAIMNO AS "EDMNO", a.QQNAME, b.FullName as "SOBLEADER1", to_date(b.ASMDateOfBirth, 'dd/mm/yyyy') as "EDMDATE", 
a.DATEOFLOSS AS "STARTDATE" , a.BUSINESSNAME, a.BRANCHNAME, STATUSWORK AS "STATUSBUSINESS", 
(select c.lsc_note from v_sts_claim c where a.StatusClaim = c.LSC_ID) as "THEINSURED", 
a.CLOSECLAIMDATE AS "ENDDATE", a.CLOSECLAIMNOTE AS "FLAGEDMBATAL", PICTEKNIK AS "SOBNAME"
FROM pooldata.T_CLAIM_PNC a, pooldata.t_person b, pooldata.t_claim_objectlist d
where a.nopolis = b.nopolis and a.claimid=d.claimid and d.objectid=to_char(b.indexcount)
and trunc(b.ASMDateOfBirth) = to_date({InputData.CARI4},'dd/mm/yyyy') {ASIS:InputData.CARI103}</pyBrowseSQL>

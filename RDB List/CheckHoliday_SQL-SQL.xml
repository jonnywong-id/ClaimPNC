<pyDescription/>
<pyBrowseSQL>SELECT COUNT (1) as "DOCID"
     FROM general.hrd_lbr@ASMD.SINARMAS.CO.ID
    WHERE     tanggal &gt;= to_date({InputCheckDate.ID_PERIHAL DateTime},'dd/mm/yyyy')
          AND tanggal &lt;= to_date({InputCheckDate.PERIHAL_NAME DateTime},'dd/mm/yyyy')
          AND TRIM(TO_CHAR (tanggal, 'DAY')) NOT IN ('SABTU','MINGGU','SATURDAY','SUNDAY')</pyBrowseSQL>

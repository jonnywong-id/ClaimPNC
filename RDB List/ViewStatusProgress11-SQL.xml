<pyBrowseSQL>SELECT 
A.TGL_INPUT AS "DateOfBirth",
A.PNCCASEID AS "ClaimID",
A.USER_INPUT AS "Email",
A.STATUS AS "AcceptedNo", 
A.KETERANGAN AS "BranchCode", 
A.NEXT_FOLLOWUP AS "Date",
B.STS_PROGRESS1 AS "Comment",
C.STS_PROGRESS2 AS "sts_progress2",
a.id_update,
POOLDATA.GET_POSISI_PROGRESS2(A.PNCCASEID,A.ID_UPDATE,A.JSONSTATUS_PROGRESS2 ) AS "IdCompliance"
FROM POOLDATA.GCNM_PROGRESS_CLAIM A,POOLDATA.GCNM_MST_PROGRESS_KLAIM B,POOLDATA.GCNM_MST_PROGRESS C
WHERE A.PNCCASEID={tempSearchProgress.CaseID}
AND  POSISIID = {tempSearchProgress.City}
AND A.STATUS_PROGRESS1= B.ID_PROGRESS
AND A.STATUS_PROGRESS2= C.ID_MST
AND B.ID_PROGRESS=C.ID_PROGRESS
ORDER BY A.TGL_INPUT ASC</pyBrowseSQL>

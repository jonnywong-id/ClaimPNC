<pyBrowseSQL>SELECT (CASE 
        WHEN (JSON_VALUE ("DATA_JSON" FORMAT JSON, '$.PolicyData.CIFData.Customer_P.ASMClientID' RETURNING VARCHAR2(4000) NULL ON ERROR)&lt;&gt;''
            OR JSON_VALUE("DATA_JSON" FORMAT JSON , '$.PolicyData.CIFData.Customer_P.ASMClientID' ) IS NOT NULL) 
        THEN JSON_VALUE("DATA_JSON" FORMAT JSON , '$.PolicyData.CIFData.Customer_P.pyFirstName' )||' '||JSON_VALUE("DATA_JSON" FORMAT JSON , '$.PolicyData.CIFData.Customer_P.pyLastName' ) 
        WHEN (JSON_VALUE("DATA_JSON" FORMAT JSON , '$.PolicyData.CIFData.Customer_C.pyCompany' ) IS NOT NULL 
            OR JSON_VALUE("DATA_JSON" FORMAT JSON , '$.PolicyData.CIFData.Customer_C.pyCompany' )&lt;&gt;'') 
        THEN JSON_VALUE("DATA_JSON" FORMAT JSON , '$.PolicyData.CIFData.Customer_C.pyCompany') 
        END ) AS "DETAIL_DOCUMENT",
        a.IDPEGA as "ID",
        a.nopolis as "OLD_ID",
        JSON_VALUE (DATA_JSON, '$.DateOfLoss') AS "TGL_EDIT",
        get_name_agent (
             getnewid (
                JSON_VALUE (DATA_JSON, '$.PolicyData.Quotation.SourceOfBusiness'),
                'm_agent'))
        AS "DOC_COL_INFO",
        (SELECT b.JSONDATA.Name
             FROM m_branch b
            WHERE b.ID =
                     getnewid (
                        JSON_VALUE (DATA_JSON, '$.PolicyData.Quotation.BranchCode'),
                        'M_BRANCH'))
         AS "DOC_COL_ID",
         GET_BUSINESS_NAME (
             getnewid (JSON_VALUE (DATA_JSON, '$.PolicyData.Quotation.BusinessCode'),
                       'M_BUSINESS'))
         AS "DOC_TYPE_ID"
FROM json_klaim a 
where SUBSTR(JSON_VALUE(DATA_JSON, '$.DateOfLoss'),1,8) = SUBSTR('{ASIS:InputData.CARI4}',1,8)</pyBrowseSQL>

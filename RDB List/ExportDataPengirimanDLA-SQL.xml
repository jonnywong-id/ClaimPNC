<pyBrowseSQL>select b.claimno as "CaseID",nodla as "City",dlareinsurer as "CityID",
nilaidla as "Amount",
to_char(tgldla,'dd/mm/yyyy') as"District",to_char(tglkirim,'dd/mm/yyyy') as "DistrictID",to_char(tglterimadla,'dd/mm/yyyy') as "Country",
b.PICTEKNIK as "Keyword",
case 
    when iskirim is null then 'Belum Dikirim'
    when iskirim ='1' then 'Sudah Dikirim'
end AS "CountryID"
from t_dlalist a,t_claim_pnc b where A.CLAIMID = B.CLAIMID and
tgldla between to_date ({TempLaporan.AnalystTransferDate},'dd/mm/yyyy')  and to_date ({TempLaporan.DateOfLoss},'dd/mm/yyyy') 
order by tgldla ASC</pyBrowseSQL>

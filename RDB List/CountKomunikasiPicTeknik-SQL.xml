<pyBrowseSQL>SELECT  count(1) as "ref_no"
  FROM datapega.pc_asm_fw_gcnmfw_work a,
       datapega.pc_assign_worklist b
 WHERE     a.pxobjclass = 'ASM-FW-GCNMFW-Work-PNC'
       AND a.pzInsKey = b.pxrefobjectkey
       AND a.pyStatusWork NOT IN ('Resolved-Completed', 'Resolved-Rejected')
       AND EXISTS
                (SELECT *
                   FROM pooldata.m_komunikasi_pnc kom
                  WHERE (a.pnccaseid=kom.caseid OR a.caseid_1=kom.caseid or a.pzinskey=kom.caseid) 
                        AND kom.komunikasistatus={TempView.ClaimNo}
                        {ASIS:TempView.CaseID})
       AND b.pxassignedoperatorid IN {ASIS:TempOperator.CityID}
      {ASIS:TempSearch.source}</pyBrowseSQL>

<pyBrowseSQL>SELECT pnccaseid "ClaimNo"
FROM (
    SELECT pnccaseid,
           status_progress1,
           ROW_NUMBER() OVER (
               PARTITION BY pnccaseid
               ORDER BY tgl_input DESC, rowid DESC
           ) rn
    FROM pooldata.gcnm_progress_claim
    WHERE pnccaseid = {TempCari.CARI1}
)
PIVOT (
    MAX(status_progress1)
    FOR rn IN (
        1 AS r1,
        2 AS r2,
        3 AS r3
    )
)
WHERE r1 = r2
  AND r2 = r3</pyBrowseSQL>

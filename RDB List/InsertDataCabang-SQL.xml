<pyBrowseSQL>DECLARE 
  TNOKLAIM VARCHAR2(32767);
  TOBJECTID VARCHAR2(32767);
  TOBJECTNAME VARCHAR2(32767);
  TTGL_TRANSFER_PUSAT DATE;
  TSTATUS VARCHAR2(32767);
  TKODECABANG VARCHAR2(32767);
  TUSERNAME VARCHAR2(32767);
  TRCV_ID VARCHAR2(32767);
  TGROUPPANEL VARCHAR2(32767);
  TNOPOLIS VARCHAR2(32767);
  TEXPEDISI VARCHAR2(32767);
  TEXPEDISILAIN VARCHAR2(32767);
  TNORESI VARCHAR2(32767);
  TTANGGALKIRIMRESI DATE;
  TTGLESTIMASIRESI DATE;
  ERRMSG VARCHAR2(32767);

BEGIN
  TNOKLAIM    := {TempDataCabang.NoKlaim};
  TOBJECTID    := {TempDataCabang.ObjectId};
  TOBJECTNAME   := {TempDataCabang.ObjectName};
  TTGL_TRANSFER_PUSAT    :=  sysdate;
  TSTATUS   := {TempDataCabang.Status};
  TKODECABANG  := {TempDataCabang.KodeCabang};
  TUSERNAME    := {TempDataCabang.UserAdmin};
  TRCV_ID      := {TempDataCabang.RCV_ID};
  TGROUPPANEL   := {TempDataCabang.Notes};
  TNOPOLIS     := {TempDataCabang.PolicyNo};
  TEXPEDISI := {TempDataCabang.NPWP};
  TEXPEDISILAIN  := {TempDataCabang.AgentID};
  TNORESI := {TempDataCabang.NoResiEskpedisi};
  TTANGGALKIRIMRESI := ( CASE WHEN {TempDataCabang.TanggalKirimEksedisi} IS NOT NULL THEN TO_DATE(SUBSTR({TempDataCabang.TanggalKirimEksedisi},1,8) || ' ' || SUBSTR({TempDataCabang.TanggalKirimEksedisi},10,6),'RRRRMMDD HH24MISS') + 7/24 ELSE NULL END );
  TTGLESTIMASIRESI :=  ( CASE WHEN {TempDataCabang.EstimasiSampaiEkspedisi} IS NOT NULL THEN TO_DATE(SUBSTR({TempDataCabang.EstimasiSampaiEkspedisi},1,8) || ' ' || SUBSTR({TempDataCabang.EstimasiSampaiEkspedisi},10,6),'RRRRMMDD HH24MISS') + 7/24 ELSE NULL END );
  POOLDATA.INSERTDATAKLAIMCABANG ( TNOKLAIM, TOBJECTID, TOBJECTNAME, TTGL_TRANSFER_PUSAT, TSTATUS, TKODECABANG, TUSERNAME, TRCV_ID, TGROUPPANEL, TNOPOLIS, TEXPEDISI, TNORESI, TTANGGALKIRIMRESI, TTGLESTIMASIRESI, ERRMSG );
  COMMIT; 
END;</pyBrowseSQL>

<pyBrowseSQL>SELECT SUM (
          CASE
             WHEN (A.pxobjclass = 'ASM-FW-GCNMFW-Work-PNC'
                   AND b.pxtasklabel in ('Input Register','Input Estimasi','Estimation'))
             THEN
                1
             ELSE
                0
          END)
          AS "ClaimNo",
       SUM (CASE
               WHEN (A.pxobjclass ='ASM-FW-GCNMFW-Work-ReceiveDocument' AND A.PNCCASEID IS NULL
             AND A.STATUSLOCK_1 = '1')
             THEN
                1
             ELSE
                0
            END)
          AS "Country",
       SUM (CASE
               WHEN (SELECT COUNT (1)
                     FROM pooldata.business c, pooldata.businessgroup d
                    WHERE c.businessgroupid = d.id                            
                          AND  c.id = A.BUSINESSCODE_1
                          AND A.pxobjclass ='ASM-FW-GCNMFW-Work-ReceiveDocument'
                          AND A.PNCCASEID IS NULL
                          AND A.STATUSLOCK_1 = '1'
                          AND A.KURIR = 'Auto Service'
                         ) &gt; 0
             THEN
                1
             ELSE
                0
            END)
          AS "RCV_ID",   
       0
          AS "Currency",
       SUM (
          CASE
             WHEN (SELECT COUNT (1)
                     FROM pooldata.m_komunikasi_pnc kom
                    WHERE     kom.caseid=A.PNCCASEID 
                          AND kom.KOMUNIKASISTATUS = '0'
                          AND kom.sender != {TempOperator.City}
                          AND A.pxobjclass = 'ASM-FW-GCNMFW-Work-PNC'
                           {ASIS:tempQuery.UserAdmin}) &gt; 0 THEN 1
             ELSE 0
          END)
          AS "CaseID",
       SUM (
          CASE
             WHEN (SELECT COUNT (1)
                     FROM pooldata.m_komunikasi_pnc kom
                    WHERE     kom.caseid=A.PNCCASEID
                          AND kom.KOMUNIKASISTATUS = '0'
                          AND kom.sender = {TempOperator.City}
                          AND A.pxobjclass = 'ASM-FW-GCNMFW-Work-PNC'
                           {ASIS:tempQuery.UserAdmin}) &gt; 0 THEN 1
             ELSE 0
          END)
          AS "City",
       SUM (
          CASE
             WHEN (SELECT COUNT (1)
                     FROM pooldata.m_komunikasi_pnc kom
                    WHERE     kom.caseid=A.PNCCASEID
                          AND kom.KOMUNIKASISTATUS = '1'
                          AND kom.sender = {TempOperator.City}
                          AND A.pxobjclass = 'ASM-FW-GCNMFW-Work-PNC'
                           {ASIS:tempQuery.UserAdmin}) &gt; 0 THEN 1
             ELSE 0
          END)
          AS "District",
       SUM (
          CASE
             WHEN (SELECT COUNT (1)
                     FROM pooldata.t_claim_pnc e
                    WHERE     e.claimno = a.pyid AND GROUPPANEL='002'
                          AND a.PXCREATEOPNAME = {TempOperator.City}
                          AND a.pyid IN (SELECT communicate_to
                                           FROM pooldata.m_komunikasi_pnc f
                                          WHERE f.communicate_to = a.pyid
                                          and komunikasistatus='0')) &gt; 0
             THEN
                1
             ELSE
                0
          END)
          AS "BranchName",
        SUM (CASE
               WHEN (SELECT COUNT (1)
                       from pooldata.t_claim_pnc e 
        where B.PXREFOBJECTKEY = e.CLAIMID AND E.CLAIMID = A.PZINSKEY
            and A.PZINSKEY = B.PXREFOBJECTKEY 
            and a.pxobjclass = 'ASM-FW-GCNMFW-Work-PNC' 
            AND a.pyStatusWork not in ('Resolved-Completed','Resolved-Rejected') 
            and a.PXCREATEOPNAME={TempOperator.City}) &gt; 0
               THEN
                  1
               ELSE
                  0
            END)
          AS "BranchID",
          SUM (CASE
               WHEN A.STATUSCLAIM_1='1150'
                 THEN
                  1
               ELSE
                  0
              END)
        AS "KodeCabang"
 FROM DATAPEGA.PC_ASM_FW_GCNMFW_WORK A, DATAPEGA.PC_ASSIGN_WORKLIST B, pooldata.business c
 WHERE     A.PYID=B.PXREFOBJECTINSNAME
        AND A.BUSINESSCODE_1 = c.id
        and A.GROUPPANEL_1= C.GROUPPANEL
       AND upper(A.PYSTATUSWORK) NOT IN ('RESOLVED-COMPLETED', 'RESOLVED-REJECTED')
       AND upper(b.pxflowname) NOT LIKE '%FIXCORRESPONDENCE%'
       AND upper(a.branchname) not like '%ASNET%'
      {ASIS:tempQuery.Remark}
{ASIS:tempQuery.NoKTP}
{ASIS:tempQuery.pyNote}</pyBrowseSQL>

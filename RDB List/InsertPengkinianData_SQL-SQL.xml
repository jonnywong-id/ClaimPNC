<pyBrowseSQL>DECLARE
   Claimid      VARCHAR2 (32767);
   Pyid         VARCHAR2 (32767);
   Noktp        VARCHAR2 (32767);
   Oldemail     VARCHAR2 (32767);
   Oldtelp      VARCHAR2 (32767);
   Newemail     VARCHAR2 (32767);
   Newtelp      VARCHAR2 (32767);
   Userinput    VARCHAR2 (32767);
   pyCategori   VARCHAR2 (32767);
   idopc  VARCHAR2 (32767);
   DATAPEGA CLOB;
BEGIN
    Claimid := {TempUpPengkinian.CityID};
    Pyid := {TempUpPengkinian.ClaimID};
    Noktp := {TempUpPengkinian.NewNoKTP};
    Oldemail := {TempUpPengkinian.Email};
    Oldtelp := {TempUpPengkinian.TelpTertanggung};
    Newemail := {TempUpPengkinian.NewEmail};
    Newtelp := {TempUpPengkinian.NewTelpTertanggung};   
    Userinput := {TempUpPengkinian.UserAdmin};
    pyCategori := {TempUpPengkinian.pyCategory};
    DBMS_LOB.CREATETEMPORARY(DATAPEGA, true);
    DATAPEGA := {TempUpPengkinian.Remark};
   idopc := {TempUpPengkinian.BranchID};

POOLDATA.UpdateInsert_PengkinianData(Claimid,Pyid,Noktp,Oldemail,Oldtelp,Newemail,Newtelp,Userinput,pyCategori,DATAPEGA ,idopc ,{TempUpPengkinian.pyNote out});
  COMMIT;
END;</pyBrowseSQL>

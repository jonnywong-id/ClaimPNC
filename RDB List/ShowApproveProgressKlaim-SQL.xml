<pyBrowseSQL>SELECT SUBSTR (A.ATASAN, 0, INSTR (A.ATASAN, '/') - 1)
           AS "BranchName",
       A.ID_AP
           AS "IDMaster",
       A.ID_PROGRESS
           AS "CABANG",
       A.PROGRESS1 AS "ProvinceID",
       A.PROGRESS2 AS "Province", 
       C.STS_PROGRESS1  
           AS "Notes",
       B.STS_PROGRESS2
           AS "NoteAkseptasi",
       A.KETERANGAN
           AS "Keterangan",
       TO_CHAR (A.APPROVEDATE, 'dd/mm/yyyy')
           AS "ApproveDate",
       CASE WHEN A.STS_APPROVE = 0 THEN ''
        WHEN A.STS_APPROVE = '' THEN '' 
        END
           AS "StatusApprove",
       A.NOTEAPPROVE
           AS "NOTE APPROVE",
       TO_CHAR (A.TGL_INPUT, 'dd/mm/yyyy')
           AS "AlasanKlaim",
       A.NOKLAIM
           AS "ClaimID",
       TO_CHAR (A.NEXTFOLLOWUP, 'dd/mm/yyyy')
           AS "BranchID",
       ( select p.picteknik from POOLDATA.T_CLAIM_PNC p where p.claimid='ASM-FW-GCNMFW-WORK '||A.NOKLAIM) as "ClaimNoSRB",
(select p.dateofloss from POOLDATA.T_CLAIM_PNC p where p.claimid='ASM-FW-GCNMFW-WORK '||A.NOKLAIM) as "DateOfLoss",
(select p.qqname from POOLDATA.T_CLAIM_PNC p where p.claimid='ASM-FW-GCNMFW-WORK '||A.NOKLAIM) as "InsuredName",
(select p.sobname from POOLDATA.T_CLAIM_PNC p where p.claimid='ASM-FW-GCNMFW-WORK '||A.NOKLAIM) as "BusinessName",
A.EMAILBROKER as "EmailBroker"
  FROM POOLDATA.T_APPROVAL_PROGRESS A ,
  POOLDATA.GCNM_MST_PROGRESS  B,
  POOLDATA.GCNM_MST_PROGRESS_KLAIM C
 WHERE 
   A.PROGRESS1 = C.ID_PROGRESS
   AND A.PROGRESS2 = B.ID_MST 
AND A.STS_APPROVE = '0' 
AND SUBSTR (A.ATASAN, 0, INSTR (A.ATASAN, '/') - 1) = {Templogin.BranchName}</pyBrowseSQL>

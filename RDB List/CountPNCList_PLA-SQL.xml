<pyBrowseSQL>SELECT count(1)  AS BRANCH_NAME
    FROM t_claim_pnc b
   WHERE     b.grouppanel != '002'
         AND b.grouppanel != '005'
         AND EXISTS
                (SELECT *
                   FROM t_plalist a
                  WHERE     a.claimid = b.claimid
                        {ASIS:TempPLA.CURRENCY}
                        and a.reinscode is not null
                        AND (a.iskirim IS NULL OR a.iskirim = '0')) 
{ASIS:TempPLA.ASMSurveyor}
ORDER BY b.registerdate ASC</pyBrowseSQL>

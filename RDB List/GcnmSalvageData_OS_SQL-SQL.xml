<pyBrowseSQL>SELECT B.* 
FROM (SELECT A.*, ROWNUM RN 
      FROM (SELECT CLAIMNO AS "CaseID", PICTEKNIK AS "UserTeknis", BUSINESSNAME AS "Location", DATEOFLOSS AS "DateOfLoss"

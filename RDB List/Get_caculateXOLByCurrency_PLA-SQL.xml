<pyDescription/>
<pzRuleSetVersionMinor>03</pzRuleSetVersionMinor>
<pyTemplate/>
<pxInstanceLockedDateTime/>
<pyBrowseSQL>SELECT currency AS "Currency",
         X.GROUPBUSINESS AS "BusinessID",
         SUM (x.OSVALUE) AS "OwnRiskValue",
         CASE
            WHEN X.GROUPBUSINESS = '10004'
            THEN
               (SELECT NVL (SUM (M.SALVAGEOS*-1), 0)
                  FROM POOLDATA.T_SALVAGE_MBU m
                 WHERE     M.DATEOFLOSS ={TempXOL.YearofQuartal}
                       AND M.CAUSEOFLOSS ={TempXOL.CauseOfLoss}
                       AND M.CURRENCY = X.CURRENCY)
            ELSE
               SUM (x.SALVAGEVALUE)
         END
            AS "DeductibleValue",
         (SELECT A.NOTE
            FROM POOLDATA.BUSINESSGROUP a
           WHERE A.ID = X.GROUPBUSINESS)
            AS "BusinessName"
    FROM POOLDATA.XOL_TABLE_ALL_KLAIM x
   WHERE     X.OSVALUE != 0
         AND X.GROUPBUSINESS IN ({ASIS:TempXOL.OccupationCode})
         AND TO_CHAR (TO_DATE (X.DOL, 'dd/mm/yyyy'), 'dd/mm/yyyy') = {TempXOL.YearofQuartal}
         AND X.CAUSEOFLOSS = {TempXOL.CauseOfLoss}
GROUP BY X.CURRENCY, X.GROUPBUSINESS
UNION ALL
  SELECT A.CURRENCYID,
         A.BUSINESSID,
         SUM (CLAIMAMOUNTSHARE),
         0,
         'Treaty Inward'
    FROM POOLDATA.T_CLAIM_INWARD_XOL a
   WHERE     TO_CHAR (TO_DATE (a.dateofloss, 'dd/mm/yyyy'), 'dd/mm/yyyy') = {TempXOL.YearofQuartal}
         AND A.CAUSEOFLOSS ={TempXOL.CauseOfLoss}
GROUP BY A.BUSINESSID, CURRENCYID</pyBrowseSQL>

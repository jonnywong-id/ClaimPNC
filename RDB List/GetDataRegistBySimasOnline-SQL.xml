<pyBrowseSQL>SELECT to_char(A.PXCREATEDATETIME,'dd/MM/yyyy') AS "EDMDATE",
        A.PYID as "EDMNO",
       A.PNCCASEID AS "IDPEGA",
       a.POLICYNO AS "NOPOLIS",
       b.QQNAME AS " QQNAME",
       to_char(A.DATEOFLOSS_1,'dd/MM/yyyy') AS "STARTDATE",
       A.BUSINESSNAME AS "SOBNAME",
       to_char(b.CLOSECLAIMDATE_1,'dd/MM/yyyy') AS "ENDDATE",
       b.CLOSECLAIMNOTE_1 AS "BUSINESSCODE",
       (select BRANCHNAME from BRANCH z where Z.ID = A.KODECABANG_1) as "MARKETINGNAME",
       (select lsc_note from pooldata.v_sts_claim where lsc_id=(select statusclaim from pooldata.t_claim_pnc where claimno=b.pyid)) as "CLIENTID",

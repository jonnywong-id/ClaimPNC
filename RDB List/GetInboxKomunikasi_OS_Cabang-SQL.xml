<pyBrowseSQL>WITH operator_list AS (
    SELECT operator_id
    FROM pooldata.mst_user_teknik
    WHERE sts_aktif = '1'
),
base_data AS (
    SELECT
        a.createddate,
        a.message,
        a.sendername,
        a.sender,
        a.caseid,
        a.komunikasiid,
        a.replymessage,
        a.komunikasistatus,
        a.createdatereply,
        CASE
            WHEN a.sender IN (
                SELECT operator_id
                FROM operator_list
            )
            THEN 'INTERNAL'
            ELSE 'EXTERNAL'
        END AS sender_type
    FROM pooldata.m_komunikasi_pnc a
    WHERE a.caseid in ({ASIS:getkomunikasi.D_SURVEY_ID})
),
internal_user AS (
    SELECT
        sendername
    FROM base_data
    WHERE sender_type = 'INTERNAL'
      AND ROWNUM = 1
)
SELECT
    z."CloseClaimDate",
    z."Email",
    iu.sendername AS "UserName",
    iu.sendername AS "UserTeknik",
    z."pzInsKey",
    z."ClaimNo",
    z."CloseClaimNote",
    z."StatusClaim",
    z."AnalystTransferDate"
FROM (
    SELECT
        createddate AS "CloseClaimDate",
        message AS "Email",
        caseid AS "pzInsKey",
        komunikasiid AS "ClaimNo",
        replymessage AS "CloseClaimNote",
        komunikasistatus AS "StatusClaim",
        createddate AS "AnalystTransferDate",
        createddate AS sort_date
    FROM base_data
    WHERE sender_type = 'INTERNAL'
    UNION ALL
    SELECT
        NULL AS "CloseClaimDate",
        '' AS "Email",
        caseid AS "pzInsKey",
        komunikasiid AS "ClaimNo",
        message AS "CloseClaimNote",
        komunikasistatus AS "StatusClaim",
        createddate AS "AnalystTransferDate",
        createddate AS sort_date
    FROM base_data
    WHERE sender_type = 'EXTERNAL'
    UNION ALL
SELECT
    NVL(createdatereply, createddate) AS "CloseClaimDate",
    replymessage AS "Email",
    caseid AS "pzInsKey",
    komunikasiid AS "ClaimNo",
    '' AS "CloseClaimNote",
    komunikasistatus AS "StatusClaim",
    NULL AS "AnalystTransferDate",
    NVL(createdatereply, createddate) AS sort_date
FROM base_data
WHERE sender_type = 'EXTERNAL'
  AND NVL(TRIM(replymessage), 'X') &lt;&gt; 'X'
) z
CROSS JOIN internal_user iu
ORDER BY z.sort_date ASC</pyBrowseSQL>

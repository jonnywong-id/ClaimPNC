<pyBrowseSQL>SELECT COUNT (1) AS "Sender",
       SUM (
          CASE
             WHEN (A.pnccaseid IS NULL AND A.statusLock_1 IS NULL) THEN 1
             ELSE 0
          END)
          AS "EmailPengirim",  
       SUM (
          CASE
             WHEN (A.pnccaseid IS NULL AND A.statusLock_1 IS NOT NULL) THEN 1
             ELSE 0
          END)
          AS "Keterangan",
       SUM (
          CASE
             WHEN (A.pnccaseid IS NOT NULL AND A.statusLock_1 IS NOT NULL)
             THEN
                1
             ELSE
                0
          END)
          AS "KronologisKejadian", 
       SUM (
          CASE
             WHEN (SELECT COUNT (1)
                     FROM pooldata.t_claim_pnc z,
                          pooldata.t_claim_adjustment x
                    WHERE    z.claimid = x.claimid AND Z.CLAIMID= 'ASM-FW-GCNMFW-WORK '||A.pnccaseid and x.claimid='ASM-FW-GCNMFW-WORK '||A.PNCCASEID
                          AND x.noakseptasi IS NOT NULL AND A.pnccaseid IS NOT NULL
                   AND A.statusLock_1 IS NOT NULL group by z.CLAIMNO) &gt; 0 THEN 1
               ELSE 0
            END)
          AS "PNCCaseID", 
       SUM (
          CASE
             WHEN (SELECT COUNT (1)
                     FROM pooldata.m_komunikasi_pnc kom
                    WHERE     kom.caseid=A.pyid
                          AND kom.KOMUNIKASISTATUS = '0'
                          AND a.pxcreateoperator = {OperatorID.pyUserIdentifier}
                          AND kom.sender != {OperatorID.pyUserIdentifier}) &gt; 0 THEN 1
             ELSE 0
          END)
          AS "PolicyNo",
       SUM (
          CASE
             WHEN (SELECT COUNT (1)
                     FROM pooldata.m_komunikasi_pnc kom
                    WHERE     kom.caseid=A.pyid
                          AND kom.KOMUNIKASISTATUS = '0'
                          AND a.pxcreateoperator = {OperatorID.pyUserIdentifier}
                          AND kom.sender = {OperatorID.pyUserIdentifier}) &gt; 0 THEN 1
             ELSE 0
          END)
          AS "QQName",
       SUM (
          CASE
             WHEN (SELECT COUNT (1)
                     FROM pooldata.m_komunikasi_pnc kom
                    WHERE     kom.caseid=A.pyid
                          AND kom.KOMUNIKASISTATUS = '1'
                          AND a.pxcreateoperator = {OperatorID.pyUserIdentifier}
                          AND kom.sender = {OperatorID.pyUserIdentifier}) &gt; 0 THEN 1
             ELSE 0
          END)
          AS "RCVID"
  FROM DATAPEGA.PC_ASM_FW_GCNMFW_WORK A,
 pooldata.businessnew c
 WHERE A.pxobjclass = 'ASM-FW-GCNMFW-Work-ReceiveDocument'
       AND A.PYSTATUSWORK NOT IN ('Resolved-Completed', 'Resolved-Rejected')
       AND A.BUSINESSCODE_1 = c.id
       {ASIS:tempQuery.NoKTP}
       {ASIS:tempQuery.pyNote}
       {ASIS:tempQuery.Remark}</pyBrowseSQL>

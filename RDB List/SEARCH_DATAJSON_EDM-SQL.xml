<pyBrowseSQL>SELECT TO_CLOB (data_jsonblob) AS DATAJSON, nospak AS MSP_NO_SPAK
  FROM pooldata.JSON_POLIS mbu
 WHERE     nopolis = {InputDataEdm.POLICYNO}
       AND prodke =
              (SELECT MAX (TO_NUMBER (prodke))
                 FROM json_polis b
                WHERE     b.nopolis = mbu.nopolis
                      AND (   b.data_jsonblob.IsEffectiveEndors IS NULL
                           OR b.data_jsonblob.IsEffectiveEndors != 'true'
                           OR (    b.data_jsonblob.IsEffectiveEndors
                                      IS NOT NULL
                               AND b.data_jsonblob.Quotation.StatusBusiness !='3')))</pyBrowseSQL>

<pyBrowseSQL>DECLARE 
  IDPega VARCHAR2(32767);
  TIPEBISNIS VARCHAR2(32767);
  Email1 VARCHAR2(32767);
  TJOB number;
  STS VARCHAR2(32767);
  TGROUP VARCHAR2(32767);
  ATASAN VARCHAR2(32767);
  TJOB2 number; 
  TNAMA VARCHAR2(32767);

BEGIN 
  IDPega := {InputData.OPERATOR_ID};
  TNAMA  := {InputData.MCL_NAME};
  TIPEBISNIS:=  {InputData.TYPE_BUSINESS};
  Email1:= {InputData.EMAIL};
  TJOB := {InputData.COUNTER_QUOTA};
  STS := {InputData.STS_AKTIF};
  TGROUP := {InputData.TEAM_GROUP};
  ATASAN := {InputData.ATASAN};
  TJOB2 := {InputData.OLD_OPERATOR_ID};
  POOLDATA.PEGA_MST_USER_TEKNIS(IDPega, TNAMA, TIPEBISNIS, Email1, TJOB, STS, TGROUP, TJOB2, ATASAN, {OutputData.STS_AKTIF out});
  COMMIT; 
  
END;</pyBrowseSQL>

 upper(pyfullname) AS "ACCUMCODE", 
 asmdateofbirth AS "BRANCHCODE", 
 asmjobname AS "BRANCHNAME", 
 asmheight AS "BUSINESSCODE",
 asmweight AS "BUSINESSNAME",
 asmlefthanded AS "BUSINESSTYPE",
 asmidcard AS "WARRANTYNO",
 asmparticipantstatus AS "THEINSURED",
 indexobject AS "TABLEOBJECTNAME",
ASMGENDER as "MARKETINGNAME"
FROM pooldata.t_personlist 
WHERE 
nopolis={TempPolis.POLICY_NO}
and prodke={TempPolis.CURRENCY}</pyBrowseSQL>

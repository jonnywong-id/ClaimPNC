<pyRuleName>ASM-FW-GCNMFW-Data-ClaimData GCNM GetInboxKomunikasiCabang</pyRuleName>
<pyBrowseSQL>SELECT createddate AS "CloseClaimDate",
       MESSAGE AS "Email",
       sendername AS "UserName",
       sender AS "UserTeknis",
       caseid AS "pzInsKey",
       komunikasiid AS "ClaimNo",
       replymessage AS "CloseClaimNote",
       komunikasistatus AS "StatusClaim",
       createdatereply AS "AnalystTransferDate",
              COMMUNICATE_FROM AS "UserName"
  FROM pooldata.m_komunikasi_pnc
 WHERE {ASIS:TempView.CaseID}  AND SENDER IS NOT NULL AND MESSAGE IS NOT NULL
AND CASEID = 'CABANG'
 AND REPLYMESSAGE IS NULL
 ORDER BY CREATEDDATE ASC</pyBrowseSQL>

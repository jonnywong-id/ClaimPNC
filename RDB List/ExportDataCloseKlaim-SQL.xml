<pyBrowseSQL>select a.claimno as "CaseID", a.nopolis as "NoKTP", a.qqname as "ClaimID", a.businessname as "ClaimNo",  a.picteknik as "Conveyance", a.businesscode as "City",
to_char(a.registerdate,'dd/mm/yyyy') as "Country", to_char(a.dateofloss,'dd/mm/yyyy') as "CountryID", 
to_char(b.tglakseptasi,'dd/mm/yyyy') as "District", b.noakseptasi as "DistrictID", to_char(a.closeclaimdate,'dd/mm/yyyy') as "Email", SUBSTR(a.closeclaimdate,4,3) as "FlagASO" from pooldata.t_claim_pnc a, pooldata.t_claim_adjustment b
where a.claimid=b.claimid 
and a.statuswork in ('Resolved-Completed')
{ASIS:TempLaporan.UserTeknis}
and trunc(a.closeclaimdate)&gt;=to_date ({TempLaporan.AnalystTransferDate},'dd/mm/yyyy') 
and trunc(a.closeclaimdate)&lt;=to_date ({TempLaporan.DateOfLoss},'dd/mm/yyyy') 
order by closeclaimdate asc</pyBrowseSQL>

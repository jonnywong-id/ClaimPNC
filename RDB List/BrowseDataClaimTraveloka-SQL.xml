<pyBrowseSQL>SELECT a.nopolis AS "PolicyNo",
       TO_CHAR (a.registerdate, 'dd/mm/yyyy') AS "BranchID",
       a.claimno AS "ClaimNo",
       b.objectname AS "BranchName",
       c.noakseptasi AS "CaseID",
       c.nilaiakseptasi AS "CauseOfLoss"
  FROM t_claim_pnc a, t_claim_objectlist b, t_claim_adjustment c
 WHERE     a.claimid = b.claimid
       AND b.claimid = c.claimid
       AND b.objectid = c.objectid
       {ASIS:TempLaporan.Message}
       and grouppanel='005'
       AND TRUNC (a.registerdate) &gt;= TO_DATE ({TempLaporan.AnalystTransferDate},'dd/mm/yyyy')
and trunc(a.registerdate)&lt;=to_date({TempLaporan.DateOfLoss},'dd/mm/yyyy')
order by registerdate asc</pyBrowseSQL>

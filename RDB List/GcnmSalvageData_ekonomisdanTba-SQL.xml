<pyBrowseSQL>SELECT B.* 
FROM (SELECT A.*, ROWNUM RN 
      FROM (SELECT CLAIMNO AS "CaseID",
(select objectname from POOLDATA.T_CLAIM_OBJECTLIST c where c.claimid=x.claimid fetch next 1 row only ) as "NewEmail",
                       PICTEKNIK AS "UserTeknis",
                       BUSINESSNAME AS "Location",
                       DATEOFLOSS AS "DateOfLoss"
                  FROM POOLDATA.T_CLAIM_PNC X
                 WHERE     GROUPPANEL IN ('003', '004', '006', '009')
                       AND BUSINESSCODE NOT IN ('10145', '10168')
                       {ASIS:tempQuery.NewEmail}
)A
      )B 
{ASIS:tempQuery.AlasanTerlambat}</pyBrowseSQL>

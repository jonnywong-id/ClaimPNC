<pyBrowseSQL>select b.ID AS BRANCH_CODE, b.DISTRICTID AS POLICY_NO, b.NOTE AS END_DATE , b.DISTRICTNAME AS MARKETING, 

(select distinct a.note from city a where a.id = b.cityid) as CURRENCY,

(select distinct a.ID from city a where a.id = b.cityid) as BRANCH_NAME,

(select distinct a.provincename from city a where a.id = b.cityid) as CUSTOMER,

(select distinct a.PROVINCEID from city a where a.id = b.cityid) as BUSINESS_NAME

from rw b
where zipcode = {TempZip.BUSINESS_CODE}</pyBrowseSQL>

<pyBrowseSQL>select e.NOTE AS "MCL_NAME", COUNT (*) AS "COUNTER_QUOTA"
FROM
  datapega.pc_asm_fw_gcnmfw_work a
    JOIN    datapega.pc_assign_worklist b
           ON      a.pzInsKey = b.pxrefobjectkey
    JOIN    pooldata.business f
           ON      a.BUSINESSCODE_1 = f.id
    JOIN    pooldata.businessgroup e
           ON      f.businessgroupid = e.id
    LEFT JOIN    pooldata.T_CLAIM_OBJECTLIST k
          ON      k.claimid = a.pzinskey
WHERE
a.pxobjclass = 'ASM-FW-GCNMFW-Work-PNC'
  AND b.pxflowname NOT IN ('FixCorrespondence', 'Register_Flow_1')
  AND b.pxtasklabel NOT IN ('FixCorrespondence')
  AND a.userteknis_1 IS NOT NULL
         {ASIS:tempQuery.MCL_NAME}
        {ASIS:tempQuery.EMAIL}
        {ASIS:tempQuery.DISC2}
GROUP BY e.NOTE
ORDER BY e.NOTE ASC</pyBrowseSQL>

<pyBrowseSQL>select jsondata as DATAJSON 
from pooldata.JSON_OFFER a
where (a.COVERNO = {InputDataEdm.POLICYNO} OR a.POLICYDECLARATIONNO = {InputDataEdm.POLICYNO})
and a.PRODKE = (select MAX(to_number(PRODKE)) from json_offer b 
                where (b.COVERNO = a.COVERNO OR b.POLICYDECLARATIONNO = a.POLICYDECLARATIONNO))</pyBrowseSQL>

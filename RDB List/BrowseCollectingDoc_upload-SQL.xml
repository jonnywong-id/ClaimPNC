<pyBrowseSQL>SELECT BUSINESSID as OLD_ID,
         DOCUMENT_TYPE_ID as DOC_TYPE_ID,
         OBJECT_DOC_ID as OBJ_DOC,
         DOC_TYPE_DT_ID as ID,
         DETAIL_DOKUMEN as DETAIL_DOCUMENT,
         CASE
            WHEN DOC_TYPE_DT_ID='14805' THEN 'Ya'
            WHEN DOC_TYPE_DT_ID='14938'  THEN 'Ya'
            WHEN sts_wajib = '0' THEN 'Tidak'
            WHEN sts_wajib = '1' and object_doc_id in ({ASIS:TempParam.BRANCH_NAME}) THEN 'Ya'
            WHEN sts_wajib = '1' and (object_doc_id not in ({ASIS:TempParam.BRANCH_NAME}) or object_doc_id is null) THEN 'Tidak'
         END
            AS sts_wajib,
         0 AS RISK,
         MIN_DOC as MIN_DOC
    FROM lst_type_doc_business b
   WHERE b.BUSINESSID = {TempParam.BUSINESS_CODE}
         AND (SELECT a.type_document
                FROM v_lst_doc_type a
               WHERE a.id = b.DOCUMENT_TYPE_ID AND a.type_document = 'COLLECTING DOCUMENT')
                IS NOT NULL
         AND (b.DETAIL_DOKUMEN != '-')
ORDER BY b.DETAIL_DOKUMEN ASC</pyBrowseSQL>

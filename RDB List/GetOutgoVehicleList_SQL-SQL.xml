<pyBrowseSQL>with data as(
select idpega,
nopolis,
nvl(jt.premium,0) as premium,
nvl(jt.oldpremium,0) as oldpremium,
nvl(jt.premium,0)-nvl(jt.oldpremium,0) as totalpremium
from pooldata.t_vehiclelist a,
JSON_TABLE (coveragelist, '$.CoverageList[*].OutGoList[*]'
  COLUMNS (Premium Number PATH '$.OutgoAmount',
  OldPremium Number PATH '$.OldOutgo[*].OutgoAmount',
  Coverage VARCHAR(50) PATH '$.CoverageNote')) jt
where idpega = {InputData.CARI1}
union all
select idpega,
nopolis,
sum(nvl(jb.premium,0)) as premium,
sum(nvl(jb.oldpremium,0)) as oldpremium,
nvl(jb.premium,0)-nvl(jb.oldpremium,0) as totalpremium
from pooldata.t_vehiclelist a,
JSON_TABLE (coveragelist, '$.CoverageList[*].AdditionalCoverage[*].OutGoList[*]'
  COLUMNS (Premium Number PATH '$.OutgoAmount',
  OldPremium Number PATH '$.OldOutgo[*].OutgoAmount',
  Coverage VARCHAR(50) PATH '$.CoverageNote')) jb
where idpega  = {InputData.CARI1}
group by idpega,nopolis,premium,oldpremium
)
select sum(premium) as HASIL1 ,sum(oldpremium) as HASIL2 ,sum(totalpremium) as HASIL3 from data</pyBrowseSQL>

<pyBrowseSQL>SELECT
    z.*,
    (SELECT count(C.KOMITE_ID)
     FROM POOLDATA.T_CLAIM_KOMITE_LIST C
     WHERE C.KOMITE_ID = z."CaseIDKomite" AND C.TANGGALKOMITE IS NOT NULL) AS "BatasUmur"
FROM (
    SELECT
        CASE WHEN B.KOMITEKE= '1' THEN B.NO_KLAIM ELSE '' END AS "ClaimID",
        B.KOMITE_ID AS "CaseIDKomite",
        B.STATUSAPPROVE AS "KOMITESTATUS",
        B.STATUSCASE,
        A.RESULTAI AS "ResultAI", 
        CASE
            WHEN B.STATUSAPPROVE = 1 THEN 'DITERIMA'
            WHEN B.STATUSAPPROVE = 2 THEN 'DITOLAK'
            WHEN B.STATUSAPPROVE = 0 THEN 'MENUNGGU'
            ELSE ''
        END AS "KomiteAccepted", 
        B.NAMAKOMITE AS "NamaKomite",
        A.NOTETERIMA AS "NoteAITerima",
        A.NOTETOLAK AS "NoteAITolak",
        A.TGLAI AS "TanggalAI",
        B.NOTEKOMITE AS "NoteKomite",
        B.KOMITEKE AS "Komiteno",
        TO_CHAR(SYSDATE-7, 'dd/mm/yyyy') AS "TanggalKomite",
        TO_CHAR(B.TANGGALKOMITE , 'YYYYMMDD"T"HH24MISS".000 GMT"') AS "TanggalComitee"
    FROM 
        POOLDATA.T_CLAIM_DATA_RESULTS_AI A,
        POOLDATA.T_CLAIM_KOMITE_LIST B
    WHERE 
        A.CLAIMID = B.NO_KLAIM 
        AND A.KOMITE= B.KOMITE_ID 
    AND B.KOMITEKE IN (
        SELECT MAX(B.KOMITEKE)
        FROM POOLDATA.T_CLAIM_KOMITE_LIST C
        WHERE C.STATUSCASE ='Resolved-Completed' AND B.KOMITE_ID=C.KOMITE_ID AND B.TANGGALKOMITE IS NOT NULL ) 
{Asis:TempDatalaporanAI.NoteAITerima}
) z
ORDER BY 
    z."CaseIDKomite", z."Komiteno"</pyBrowseSQL>

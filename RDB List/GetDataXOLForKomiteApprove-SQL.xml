<pyBrowseSQL>select "City","CityID","Type","NoteKasir" from 
(select tahun as "City",causeofloss as "CityID",'DLA' as "Type",max(to_char(TGLINSERT,'dd/mm/yyyy')) as "NoteKasir" from pooldata.T_DLA_XOL a where a.STATUSAPPROVE ='0' group by tahun,causeofloss
union 
select tahun as "City",causeofloss as "CityID",'PLA' as "Type",max(to_char(TGLINSERT,'dd/mm/yyyy')) as "NoteKasir" from pooldata.T_PLA_XOL b where b.STATUSAPPROVE ='0' group by tahun,causeofloss)
order by "Type","City" desc</pyBrowseSQL>

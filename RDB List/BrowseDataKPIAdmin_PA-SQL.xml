<pyBrowseSQL>SELECT B.CLAIMNO as "UserTeknis", B.NOPOLIS as "Remark", b.businessname as "Country",to_char(B.RECEIVEDATE,'dd/mm/yyyy') as "ClaimAmount", to_char(b.registerdate,'dd/mm/yyyy') as "ClaimNo",to_char(C.RECEIVEDATELOD,'dd/mm/yyyy') as "BranchID",
to_char(C.TGLAKSEPTASI,'dd/mm/yyyy') as "BranchName",datamining.get_working_hours@asmd.sinarmas.co.id(b.RECEIVEDATE, b.registerdate) / 28800 as "City",datamining.get_working_hours@asmd.sinarmas.co.id(c.RECEIVEDATELOD, c.TGLAKSEPTASI) / 28800 as "CityID"
  FROM pooldata.t_claim_pnc b,POOLDATA.T_CLAIM_ADJUSTMENT c,
                               datapega.pc_asm_fw_gcnmfw_work d
                         WHERE B.CLAIMID =C.CLAIMID and b.claimid = d.pzinskey and B.STATUSWORK !='Resolved-Rejected' and C.NOAKSEPTASI is not null
                               AND pxcreateoperator IN
                                      ('IRMANOPITAPURBA_1',
                                       'IRMANOPITAPURBA',
                                       'YUNIARPAMORSUARI')
                               AND B.GROUPPANEL IN
                                      ('002')
       {ASIS:TempLaporan.BranchID}</pyBrowseSQL>

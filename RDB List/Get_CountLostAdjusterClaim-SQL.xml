<pyBrowseSQL>SELECT
       SUM (CASE
               WHEN (SELECT COUNT (*)
                       FROM DATAPEGA.PC_ASM_FW_GCNMFW_WORK
                      WHERE     pxobjclass = 'ASM-FW-GCNMFW-Work-SurveyClaim'
                            AND SURVEYORTYPE_1 = '2'
                            AND caseid_1 = a.pzinskey
                            AND a.pystatuswork NOT IN ('Resolved-Completed', 'Resolved-Rejected')) &gt; 0 
               THEN 1 
               ELSE 0
            END)
          AS "DistrictID"
  FROM datapega.pc_asm_fw_gcnmfw_work a,
       datapega.pc_assign_worklist b,
       pooldata.business c,
       pooldata.businessgroup d
 WHERE a.pxobjclass = 'ASM-FW-GCNMFW-Work-PNC'
      AND a.pzInsKey = b.pxrefobjectkey
      AND A.BUSINESSCODE_1 = c.id
      AND c.businessgroupid = d.id
      AND a.branchname!='ASNET'
      AND b.pxflowname not in ('FixCorrespondence', 'Register_Flow_1') 
      AND b.PXTASKLABEL not in ('FixCorrespondence') 
      {ASIS:TempView.pyNote}
      {ASIS:TempSearch.AlasanKlaim}
ORDER BY a.pxCreateDateTime ASC</pyBrowseSQL>

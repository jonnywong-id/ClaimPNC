<pyBrowseSQL>SELECT NVL(
         LISTAGG(m.name, ', ')
         WITHIN GROUP (ORDER BY t.idx_dominanfactor),
         '-'
       ) AS "DominanName"
FROM POOLDATA.T_CLAIM_DOMINANFACTOR t
JOIN POOLDATA.M_DOMINAN_FACTOR m
  ON m.id = t.id_dominanfactor
WHERE t.claimid =  {TempKlaimDominan.CASEDB}</pyBrowseSQL>

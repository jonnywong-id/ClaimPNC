<pyBrowseSQL>SELECT 
       CLAIMID AS "pzInsKey",
       NODLA AS "NO_DLA",
       DLAREINSURER AS "DLAReinsurer",
       TIPEDLA AS "DLAType",
       objectid AS "pyID",
       objectcoverageid AS "DLAStream",
       adjustmentid AS "Count",
       a.pzinskey as "Currency",
       tglkirim as "TglDLA",
       nvl(iskirim,'0') as "IsDLA"
  FROM pooldata.t_predlalist c,
       datapega.pc_data_workattach a,
       datapega.pc_link_attachment b
 WHERE     c.claimid = b.pxlinkedreffrom
       AND c.claimid = a.pxRefObjectKey
       AND a.pzinskey = b.pxlinkedrefto
       AND c.claimid = {tempnoklaim.NO_DLA}
       AND b.pyCategory = 'DLA'
       and substr(pxattachname,-15,11) = nodla</pyBrowseSQL>

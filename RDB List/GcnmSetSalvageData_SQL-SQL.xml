<pyBrowseSQL>SELECT b.NOKLAIM AS "CaseID",
       b.TGLINPUT AS "AdminTransferDate",
       b.JENISSALVAGE AS "AnaylstRemarks",
       b.QUANTITYSALVAGE AS "AreaClaimId",
       b.ESTIMASINILAI AS "CauseOfLoss",
       b.LOKASISALVAGE AS "City",
       b.TGLTRANSFERGA AS "AnalystTransferDate",
       b.STSTRANSFER AS "CityID",
       b.TGLAKSEPTASI AS "CPLPostAuditValidDate",
       b.NOAKSEPTASI AS "NIK",
       b.REMARK AS "ClaimID",
       b.CURRENCY AS "Currency",
       b.OBJECTNAME AS "NoKTP",
       b.IDOBJECT AS "NewNoKTP",
       b.COVERAGENAME AS "TelpTertanggung",
       b.IDCOVERAGE AS "NewTelpTertanggung",
       case when trunc(b.tglinput)&lt; to_date('17/07/2023','dd/mm/yy') then '1' else '0' end as "AreaClaimId",
       b.NILAIAKSEP AS "OwnRisk",
       b.IDSALVAGE AS "ClaimNo",
       b.EMAIL AS "Email",
       b.NILAIPENAWARAN as "Resources",
       b.PICSURVEY as "UserAdmin",
       b.NOTELP as "ResponseMsg",
      b.PEMENANGNAME as "CASEDB",
      b.ISJABODATABEK as "InsuredInterest",
       b.TANGGALLELANG as "Idlogservice",
       b.EMAILSURVEY as "ResponseCode",
       (SELECT BUSINESSNAME
          FROM POOLDATA.T_CLAIM_PNC a
         WHERE a.CLAIMID = 'ASM-FW-GCNMFW-WORK ' || b.NOKLAIM)
          AS "ChronologicalOfIncodent"
  FROM POOLDATA.PNC_SALVAGE b  where {ASIS:tempQuery.NewEmail}</pyBrowseSQL>

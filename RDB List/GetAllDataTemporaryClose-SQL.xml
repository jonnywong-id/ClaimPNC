<pyBrowseSQL>select PNCCASEID as "CaseID" from pooldata.GCNM_PROGRESS_CLAIM x
where pnccaseid in
(SELECT A.PYID
  FROM DATAPEGA.PC_ASM_FW_GCNMFW_WORK A,
       DATAPEGA.PC_ASSIGN_WORKLIST B,
       POOLDATA.T_CLAIM_SURVEY_KLAIM S
 WHERE     B.PXREFOBJECTINSNAME = A.PYID
       AND B.pxAssignedOperatorID = S.USERTEKNIK
       AND A.PYSTATUSWORK NOT IN ('Resolved-Completed', 'Resolved-Rejected')
       AND A.pxobjclass = 'ASM-FW-GCNMFW-Work-PNC')
and POSISIID='1' and ID_UPDATE=(select max(ID_UPDATE) from pooldata.GCNM_PROGRESS_CLAIM b where B.PNCCASEID=x.PNCCASEID)
and upper(KETERANGAN) not like '%AUTO%' and upper(KETERANGAN) not like '%SYSTEM%' and X.STATUS_PROGRESS1='017'</pyBrowseSQL>

<pyBrowseSQL>SELECT b.NOPOLIS AS "NoKTP",
       b.claimno AS "CaseID",
       b.picteknik AS "UserAdmin",
       TO_CHAR (b. TRANSFERPIC_DATE,'dd/mm/yyyy') AS "TransferPICDate",
       TO_CHAR (b.registerdate,'dd/mm/yyyy') AS "AnalystTransferDate",
       (SELECT MAX (causeofloss)
          FROM t_claim_objectcoverage
         WHERE claimid = b.claimid)
          AS "Country",
       b.branchname AS "AnalystRemaksInvestigator",
       TO_CHAR (b.DATEOFLOSS, 'dd/mm/yyyy') AS "DateOfLoss",
       TO_CHAR (b.REGISTERDATE, 'mm') AS "Email",
       CASE
          WHEN b.statuswork = 'New' THEN 'Claim On Progress'
          WHEN b.statuswork = 'Resolved-Completed' THEN 'Closed'
          WHEN b.statuswork = 'Resolved-Rejected' THEN 'Ditolak'
          ELSE '-'
       END
          AS "ClaimNo",
       CASE
          WHEN b.typeofcoins = '2' THEN 'Member'
          WHEN b.typeofcoins = 'F' THEN 'Fac In'
          WHEN b.typeofcoins = '1' THEN 'Leader'
          ELSE '-'
       END
          AS "AgingAmount",
       B.QQNAME AS "NamaSurveyor",
       B.SOBNAME AS "CityID",
       B.REMARKRECOMENDATION AS "AnaylstRemarks",
       b.businessname AS "City",
       b.KRONOLOGI AS "LokasiSurveyor",
 b.NOREFBROKER
           AS "NoReffBroker",
      (select RECEIVEDDATE_1 from datapega.pc_asm_fw_gcnmfw_work 
          where B.CLAIMID = pzInskey) AS "NIK",
      (SELECT TO_CHAR (MIN (tanggal + 12 / 24), 'dd/mm/yyyy')
            FROM os_akseptasi_klaim
           WHERE caseid = b.claimid)
            AS "NPWP",
       (SELECT MAX (ASM_SHARE)
          FROM pooldata.t_claim_adjustment
         WHERE claimid = b.claimid)
          AS "AlasanTerlambat",
       (SELECT SUM (TOTAL_CLAIM * CURRENCYVALUE)
          FROM pooldata.t_claim_adjustment
         WHERE claimid = b.claimid)
          AS "ComplianceRemark",
       (SELECT SUM (GROSSVALUE * CURRENCYVALUE)
          FROM pooldata.t_claim_adjustment
         WHERE claimid = b.claimid)
          AS "Conveyance",
       (SELECT SUM (INDIVIDUAL_RISK_VALUE * CURRENCYVALUE)
          FROM pooldata.t_claim_adjustment
         WHERE claimid = b.claimid)
          AS "CloseClaimNote",
       (SELECT SUM ( (TOTAL_CLAIM * CURRENCYVALUE) * (ASM_SHARE / 100))
          FROM pooldata.t_claim_adjustment
         WHERE claimid = b.claimid)
          AS "CommentKomiteClosecase",
       (SELECT SUM ( (NVL (LOC, 0) / 100) * TOTAL_CLAIM * CURRENCYVALUE)
               + SUM (NVL (NILAI_SALVAGE_A * CURRENCYVALUE, 0))
          FROM pooldata.t_claim_adjustment
         WHERE claimid = b.claimid)
          AS "CompliancePosAuditByr",
       (SELECT   SUM (TOTAL_CLAIM * CURRENCYVALUE)
               - SUM (INDIVIDUAL_RISK_VALUE * CURRENCYVALUE)
               - SUM ( (NVL (LOC, 0) / 100) * TOTAL_CLAIM * CURRENCYVALUE)
               + SUM (NVL (NILAI_SALVAGE_A * CURRENCYVALUE, 0))
               - SUM (GROSSVALUE * CURRENCYVALUE)
          FROM pooldata.t_claim_adjustment
         WHERE claimid = b.claimid)
          AS "UserName",
       (SELECT TO_NUMBER (
                    SUM (TOTAL_CLAIM * CURRENCYVALUE)
                  - SUM (INDIVIDUAL_RISK_VALUE * CURRENCYVALUE)
                  - SUM ( (NVL (LOC, 0) / 100) * TOTAL_CLAIM * CURRENCYVALUE)
                  + SUM (NVL (NILAI_SALVAGE_A * CURRENCYVALUE, 0))
                  - SUM (GROSSVALUE * CURRENCYVALUE))
               * MAX (ASM_SHARE / 100)
          FROM pooldata.t_claim_adjustment
         WHERE claimid = b.claimid)
          AS "UserTeknis",
(select PXCREATEOPNAME from datapega.pc_asm_fw_gcnmfw_work where pyid = b.claimno) as "NewEmail"
  FROM POOLDATA.T_CLAIM_PNC b
WHERE TRUNC (b.registerdate) 
       BETWEEN TO_DATE ({TempLaporan.AnalystTransferDate},'dd/mm/yyyy')
       AND TO_DATE ({TempLaporan.DateOfLoss},'dd/mm/yyyy')
       AND b.claimno IS NOT NULL
       and b.branchname!='ASNET'
       and b.grouppanel in ({ASIS:TempLaporan.UserTeknis})
       {ASIS:TempLaporan.UserAdmin}</pyBrowseSQL>

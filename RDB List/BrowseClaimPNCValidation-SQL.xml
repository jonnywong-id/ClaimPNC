<pyBrowseSQL>SELECT  to_date({TempRepType.pyNote},'dd/mm/yyyy') AS "SearchName", a.pyID AS "pyID"
  FROM datapega.pc_ASM_fw_gcnmfw_work a,
       datapega.pr_ASM_fw_gcnmfw_data_index_object b
 WHERE     a.pzinskey = b.pxinsindexedkey
       AND a.pxobjclass = 'ASM-FW-GCNMFW-Work-PNC'
       AND a.pystatuswork != 'Resolved-Rejected'

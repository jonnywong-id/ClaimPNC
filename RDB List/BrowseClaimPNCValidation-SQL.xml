       AND a.pzinskey!={TempRepType.pzInsKey}
       {ASIS:TempRepType.DraftWordingID} 
       AND b.objectid = {TempRepType.DraftWordingIDMarine}
       AND TRUNC(dateofloss_1) = to_date({TempRepType.pyNote},'dd/mm/yyyy')</pyBrowseSQL>

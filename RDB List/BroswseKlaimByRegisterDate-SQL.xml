<pyBrowseSQL>SELECT 
a.CLAIMNO AS "IDPEGA",
a.CLAIMID AS "POLICYDECLARATIONNO",
(select NVL(jt.Diagnose, jt.DescDiagnose) from JSON_KLAIM jk,  
                                     json_table (  jk.DATA_JSONBLOB, '$.ObjectList[*]'
                                                        columns ( ObjectID varchar2 path '$.ObjectID',
                                                        nested path '$.ObjectCoverageList[*]'
                                                        columns (Diagnose varchar2 path '$.Diagnose',
                                                        CoverageID varchar2 path '$.CoverageID',
                                                        DescDiagnose varchar2 path '$.DescDiagnose'))) jt
                                                        where jk.IDPEGA = a.CLAIMID AND jt.ObjectID = d.objectid AND d.OBJECTCOVERAGEID = jt.CoverageID) AS "Diagnose",
a.LOCATION AS "RISKLOCATION",    
TO_DATE(tobj.asmdateofbirth,'RRRRMMDD') AS "DOB",
TRUNC(MONTHS_BETWEEN(TRUNC(a.dateofloss),
                            TO_DATE(tobj.asmdateofbirth,'RRRRMMDD')) / 12) AS "USIA",            
g.CAUSEOFLOSS as "NATUREOFLOSS",
( SELECT to_char(ROUND(MONTHS_BETWEEN(TRUNC(a.dateofloss),
                                     MAX(TRUNC(mds.mds_beg_date)) KEEP (DENSE_RANK LAST ORDER BY mds.mds_prod_ke)),2), '9999D99','NLS_NUMERIC_CHARACTERS = '',.''')
           FROM collection.mst_det_sales@ASMD.SINARMAS.CO.ID mds
          WHERE mds.mds_no_polis = a.nopolis ) || ' Bulan' AS "POLICYRANGE",  
to_char(a.NOPOLIS) AS "EDMNO", 
replace(a.QQNAME, ',',' ') as "QQNAME", 
a.BUSINESSNAME as "NOPOLIS",
a.leader_member as "BUSINESSTYPE",
TO_CHAR(a.DATEOFLOSS,'YYYY') as "ENDDATE",
to_char(a.DATEOFLOSS,'dd/mm/yyyy') as "EDMDATE", 
x.RECEIVEDDATE_1 as "PRODKE", 
to_char(a.FINISHREGISTERDATE,'dd/mm/yyyy') as "ACCUMCODE", 
to_char(a.CLOSECLAIMDATE,'dd/mm/yyyy') as "TABLEOBJECTNAME",
to_char(a.REGISTERDATE,'dd/mm/yyyy') as "REGISTERID", 
to_char(a.transferpic_date,'dd/mm/yyyy')   as "WARRANTYNO", 
(select to_char(min(tanggal+12/24),'dd/mm/yyyy') from os_akseptasi_klaim where caseid=a.claimid)  as "pyCountry", 
to_char(a.DATEOFREQUESTDOCUMENT,'dd/mm/yyyy') as "THEINSURED", 
to_char(a.SURVEYDATE,'dd/mm/yyyy') as "BUSINESSCODE",
a.PICTEKNIK as "OLDPOLICYNO",
replace(a.closeclaimnote,chr(10),' ') as "GROUPPANEL",
to_char(a.investigator_tf_date,'dd/mm/yyyy') as "SOBLEADER1",
to_char(a.ANALYSTTORCLPUCL_DATE,'dd/mm/yyyy') as "SOBLEADER2",
to_char(a.RCLPUCL_TF_TOANALYST,'dd/mm/yyyy') as "SOBLEADER0",
a.RCLPUCL as "SOBNAME",
to_char(a.COMPLIANCE_CREATEDATE,'dd/mm/yyyy') as "SOURCEOFBUSINESS",
to_char(a.CPLVALID_DATE,'dd/mm/yyyy') as "ISMAINFOLLOWING",
to_char(a.POSTAUDIT_TF_ANALYSTDATE,'dd/mm/yyyy') as "STATUSBUSINESS",
to_char(a.CPLPOSTAUDIT_VALIDDATE,'dd/mm/yyyy') as "EDMTYPE",
a.ALASANKETERLAMBATAN as "MARKETINGCODE",
a.businesscode as "BUSINESSNAME",
(Select b.lsc_note from v_sts_claim b where a.StatusClaim = b.LSC_ID) as "CLIENTID", 
to_char(d.ACCEPTANCE_DATECOMITEE,'dd/mm/yyyy') as "SYARIAHSTATUS",
to_char(d.tglbayar,'dd/mm/yyyy') as "BRANCHCODE", 
d.status as "BRANCHNAME",
d.paymenttype as "MARKETINGNAME",
d.noakseptasi as "STARTDATE",
to_char(d.printlod_date,'dd/mm/yyyy') as "FLAGEDMBATAL",
to_char(d.tglakseptasi,'dd/mm/yyyy') as "FOLLOWEDPOLICY",
to_char(d.manual_acceptancedate,'dd/mm/yyyy') as "POOLINGSTATUS",
to_char(d.MANUALACCEPTANCEDATECOMITEE,'dd/mm/yyyy') as "AUTOCANCELPRINTSTATUS",
to_number(d.GROSSVALUE) as "ASMAnalisator",
a.SOBNAME as "ISFOLLOWINGCHILD",
g.coveragename AS "PNCSearch",
x.pnccaseid AS "pyNote",
x.pxcreateoperator as "pyLabel",
to_char(a.TGLDOKLENGKAP,'dd/mm/yyyy') as "pyGroup",
to_char(d.ANALYST_TFKOMITEDATE,'dd/mm/yyyy') as "pyCountryName",
to_char(a.trf_to_investigator,'dd/mm/yyyy') as "pzInsKey",
to_char(d.receivedatelod,'dd/mm/yyyy') as "pyID",
substr(X.REPORTDATE_1,0,8) as "IndexSpreading",
to_char(d.TRANSFER_CASHIER_DATE,'dd/mm/yyyy') as "pyEmailAddress",
(select posisi from POOLDATA.GCNM_PROGRESS_POSISI_PNC z where z.caseid = a.CLAIMNO and id = (select max(id)from POOLDATA.GCNM_PROGRESS_POSISI_PNC where caseid = z.caseid )) as "pyIssue",
(select to_char(startdate,'dd/mm/yyyy') from t_general where nopolis=a.nopolis and prodke=a.prodke) as "PlatNo",
(select to_char(enddate,'dd/mm/yyyy') from t_general where nopolis=a.nopolis and prodke=a.prodke) as "Position"
FROM T_CLAIM_PNC a, t_claim_adjustment d, t_claim_objectcoverage g, datapega.pc_asm_fw_gcnmfw_work x, pooldata.t_personlist tobj  where 
trunc(a.registerdate)&gt;=to_date({TempLaporan.AnalystTransferDate},'dd/mm/yyyy') 
and trunc(a.registerdate)&lt;=to_date({TempLaporan.DateOfLoss},'dd/mm/yyyy') 
and x.pxobjclass='ASM-FW-GCNMFW-Work-PNC'
AND a.branchcode != '100639'
{ASIS:TempLaporan.UserTeknis}
and d.claimid = a.ClaimID 
and a.claimid = g.claimid
and a.claimid = x.pzInskey
and d.objectcoverageid=g.objectcoverageid
AND a.nopolis = tobj.nopolis
AND a.prodke = tobj.prodke
AND d.objectid = tobj.indexobject
order by a.ClaimID asc</pyBrowseSQL>

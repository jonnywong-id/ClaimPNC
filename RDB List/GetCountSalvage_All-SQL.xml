<pyBrowseSQL>SELECT
    SUM (
        CASE 
            WHEN 
                (A.CLAIMID='ASM-FW-GCNMFW-WORK ' || B.NOKLAIM
                AND (B.STSTRANSFER='1' AND A.STSSALVAGE ='2'))
                THEN 1 
                ELSE 0 
                END ) 
                AS "ClaimNo"
FROM POOLDATA.T_CLAIM_PNC A, POOLDATA.PNC_SALVAGE B 
WHERE A.CLAIMID = 'ASM-FW-GCNMFW-WORK ' || B.NOKLAIM AND A.GROUPPANEL IN ('003','004','006','009') AND A.BUSINESSCODE NOT IN ('10145', '10168')</pyBrowseSQL>

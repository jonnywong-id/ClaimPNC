<pyBrowseSQL>/* Formatted on 05/Aug/20 3:52:55 PM (QP5 v5.215.12089.38647) */
SELECT sum(jt.TSIOBJECTITEM) as "HASIL1"  FROM T_PROPERTYLIST A,JSON_TABLE (
A.PROPERTYITEMLIST,'$'COLUMNS(NESTED PATH '$.PropertyItemList[*]' COLUMNS(TSIOBJECTITEM VARCHAR(32) PATH '$.TSIObjectItem', FLAGDELETE VARCHAR(5) PATH '$.FlagDelete')))jt 
WHERE A.IDPEGA  = {InputData.CARI1}
         AND (jt.FLAGDELETE &lt;&gt; '1' OR jt.FLAGDELETE IS NULL)
ORDER BY A.INDEXOBJECT</pyBrowseSQL>

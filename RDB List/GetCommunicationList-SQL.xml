<pyBrowseSQL>SELECT 
    A.TGL_INPUT AS "ObjekTanggal",
    A.PNCCASEID AS "ClaimID",
    B.STS_PROGRESS1 AS "Comment",
    C.STS_PROGRESS2 AS "IdCompliance",
    A.USER_INPUT AS "Email", 
    A.NEXT_FOLLOWUP AS "Date", 
    A.STATUS AS "AcceptedNo", 
    A.KETERANGAN AS "BranchCode"
FROM POOLDATA.GCNM_PROGRESS_CLAIM A
LEFT JOIN POOLDATA.GCNM_MST_PROGRESS_KLAIM B
    ON A.STATUS_PROGRESS1 = B.ID_PROGRESS
LEFT JOIN POOLDATA.GCNM_MST_PROGRESS C
    ON A.STATUS_PROGRESS2 = C.ID_MST
   AND B.ID_PROGRESS = C.ID_PROGRESS
   WHERE A.PNCCASEID = {TempSearch.CARI1}
   ORDER BY TGL_INPUT DESC</pyBrowseSQL>

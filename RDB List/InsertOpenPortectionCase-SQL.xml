<pySaveSQL>DECLARE
   vCount NUMBER(2,0);

BEGIN

SELECT COUNT(1)
  INTO vCount
  FROM general.mst_buka_proteksi@simasnet
 WHERE mbp_id = {TempInsertOPC.BRANCH_CODE} ;

IF vCount = 0 THEN
INSERT INTO general.mst_buka_proteksi@simasnet (MBP_ID, MBP_NO_POLIS, MBP_NO_REF, PROTEKSI_ID, LUS_ID, MBP_TGL_INPUT, MBP_ALASAN, MBP_PERSETUJUAN, KETERANGAN) 
values( {TempInsertOPC.BRANCH_CODE}, {TempInsertOPC.POLICY_NO}, (select NO_SPK from v_klaim@simasnet where no_klaim={TempInsertOPC.BRANCH_NAME} and no_polis={TempInsertOPC.POLICY_NO} fetch next 1 rows only), {TempInsertOPC.BUSINESS_NAME}, '00000', sysdate, {TempInsertOPC.CUSTOMER}, {TempInsertOPC.MARKETING}, {TempInsertOPC.CUSTOMER}) ;

COMMIT;
END IF;
END;</pySaveSQL>

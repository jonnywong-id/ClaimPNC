<pyBrowseSQL>select 
    a.claimno as "CaseID", 
    b.pzinskey as "ClaimNo",
    a.nopolis as "PolicyNo", 
    b.qqname as "InsuredName", 
    a.businessname as "BusinessName", 
    B.SOBNAME as "BusinessID",
    a.dateofloss as "DateOfLoss", 
    a.reportdate as "ReportDate", 
    b.PXCREATEDATETIME as "DateReceived",
    case when (select COUNT(b.uploaddate) from m_komunikasi_pnc a, d_komunikasi_pnc b where caseid=b.pzinskey and a.komunikasiid=b.komunikasi_id and b.uploaddate is null) &lt; 0  then 'Sudah Upload'
         when (select COUNT(b.uploaddate) from m_komunikasi_pnc a, d_komunikasi_pnc b where caseid=b.pzinskey and a.komunikasiid=b.komunikasi_id and b.uploaddate is null) &gt; 0  then 'Belum Upload'
    else 'Belum Upload'
    end as "Status"
        from t_claim_pnc a, DATAPEGA.PC_ASM_FW_GCNMFW_WORK b
            where a.claimno=b.pyid
            and A.PICTEKNIK IN {ASIS:TempOperator.CityID}
            and b.pzinskey in (select caseid from m_komunikasi_pnc where caseid=b.pzinskey)</pyBrowseSQL>

<pyBrowseSQL>SELECT a.NOKLAIM AS "CaseID",
       a.idsalvage as "Remark",
       A.OBJECTNAME AS "CauseOfLoss",
       A.COVERAGENAME AS "CauseOfLossID",
       TO_CHAR (A.TGLINPUT, 'dd/mm/yyyy') AS "AlasanKlaim",
       CASE WHEN A.NOAKSEPTASI IS NULL THEN '-' ELSE A.NOAKSEPTASI END AS "NIK",
       ESTIMASINILAI AS "Resources",
       A.PIC "OwnRisk",
       CASE
          WHEN A.STSTRANSFER = 1
          THEN
             'Sudah Aksep Checker'
          WHEN A.STSTRANSFER = 2 AND A.NOAKSEPTASI IS NOT NULL
          THEN
             'Sudah Akseptasi'
          WHEN A.STSTRANSFER = 2 AND A.NOAKSEPTASI IS NULL
          THEN
             'Create Ajd Salvage'
          WHEN A.STSTRANSFER = 3
          THEN
             'Salvage Diterima di Komite'
          WHEN A.STSTRANSFER = 5
          THEN
             'Salvage Tolak di Komite'
          WHEN A.STSTRANSFER = 6
          THEN
             'Salvage Waive'
          ELSE
             'OTHER'
       END
          AS "City"
  FROM POOLDATA.PNC_SALVAGE a
 WHERE A.NOKLAIM = {tempQuery.RWID}</pyBrowseSQL>

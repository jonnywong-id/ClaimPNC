<pyBrowseSQL>SELECT count(1) as "ref_no"
  FROM datapega.PC_ASM_FW_GCNMFW_WORK a,
       (SELECT BRANCHNAME
          FROM POOLDATA.BRANCH
         WHERE ID IN {ASIS:tempQuery.CaseID}
       union
       SELECT BRANCHNAME FROM POOLDATA.V_D_SURVEYORS WHERE D_SURVEY_ID in {ASIS:tempQuery.CaseID})z

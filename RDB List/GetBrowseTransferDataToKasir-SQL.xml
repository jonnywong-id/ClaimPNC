<pyMemo>Menambahkan kolom, nama pic, nama client, dan asm sahere</pyMemo>
<pyBrowseSQL>SELECT a.CLAIMID AS "CaseID",
       b.CLIENTNAME AS "NamaSurveyor",
       b.PIC AS "NIK",
       a.NOAKSEPTASI AS "City",
       TO_CHAR (a.TGLAKSEPTASI, 'YYYY-MM-dd') AS "CityID",
       a.RECEIVERNAME AS "Country",
       a.ASM_SHARE AS "NoKTP",
       a.ASM_SHARE_VALUE AS "NPWP",
       TO_CHAR (a.TRANSFER_CASHIER_DATE, 'YYYY-MM-dd') AS "CountryID" from POOLDATA.T_CLAIM_ADJUSTMENT a,POOLDATA.PEGA_DASHBOARDPNC b where b.noklaim = substr(a.claimid,20,length(a.claimid)) {ASIS:TempDataDetailKasir.City} {ASIS:TempDataDetailKasir.Country} and {ASIS:TempDataDetailKasir.UserTeknis}</pyBrowseSQL>

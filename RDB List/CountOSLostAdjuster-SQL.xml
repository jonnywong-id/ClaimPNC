<pyBrowseSQL>SELECT SUM (
          CASE
             WHEN (A.PYSTATUSWORK NOT IN
                      ('Resolved-Completed', 'Resolved-Rejected')
                   AND A.AdjusterAccept_1 IS NULL)
             THEN
                1
             ELSE
                0
          END)
          AS "CaseID",
       SUM (
          CASE
             WHEN (A.PYSTATUSWORK NOT IN
                      ('Resolved-Completed', 'Resolved-Rejected')
                   AND A.AdjusterAccept_1 = '1')
             THEN
                1
             ELSE
                0
          END)
          AS "ClaimNo",
       SUM (
          CASE
             WHEN (A.PYSTATUSWORK NOT IN
                      ('Resolved-Completed', 'Resolved-Rejected')
                   AND A.AdjusterAccept_1 = '1' and a.AdjusterStatus_1='Invoice Fee')
             THEN
                1
             ELSE
                0
          END)
          AS "Password",
       SUM (
          CASE WHEN (A.PYSTATUSWORK = 'Resolved-Completed') THEN 1 ELSE 0 END)
          AS "CityID",
       SUM (
          CASE
             WHEN (SELECT COUNT (*)
                     FROM pooldata.m_komunikasi_pnc kom
                    WHERE     A.pzinskey= kom.caseid
                          AND kom.KOMUNIKASISTATUS = '0'
                          AND A.PYSTATUSWORK NOT IN ('Resolved-Completed', 'Resolved-Rejected')
                          AND kom.sender != {TempOperator.CityID} group by caseid) &gt; 0 THEN 1
             ELSE 0
          END)
          AS "Province",
       SUM (
          CASE
             WHEN (SELECT COUNT (*)
                     FROM pooldata.m_komunikasi_pnc kom
                    WHERE     A.pzinskey= kom.caseid
                          AND kom.KOMUNIKASISTATUS = '0'
                         AND A.PYSTATUSWORK NOT IN ('Resolved-Completed', 'Resolved-Rejected')
                          AND kom.sender = {TempOperator.CityID}) &gt; 0 THEN 1
             ELSE 0
          END)
          AS "Country",
       SUM (
          CASE
             WHEN (SELECT COUNT (*)
                     FROM pooldata.m_komunikasi_pnc kom
                    WHERE     A.pzinskey= kom.caseid
                          AND kom.KOMUNIKASISTATUS = '1'
                         AND A.PYSTATUSWORK NOT IN ('Resolved-Completed', 'Resolved-Rejected')
                          AND kom.sender = {TempOperator.CityID}) &gt; 0 THEN 1
             ELSE 0
          END)
          AS "DistrictID"
  FROM DATAPEGA.PC_ASM_FW_GCNMFW_WORK A
 WHERE a.pxobjclass = 'ASM-FW-GCNMFW-Work-SurveyClaim'

<pyBrowseSQL>SELECT max(c.objectname) AS "ACCUMCODE",
       c.indexobject AS "BRANCHCODE",
       max (C.OBJECTNO) AS "IDPEGA",
       max(c.asmaddress) AS "BRANCHNAME",
       max(c.ASMRWNOTE) AS "CLIENTID",
       max(c.ASMRW) AS "EDMNO",
       max(c.ASMDISTRICTNOTE) AS "EDMTYPE",
       max(c.ASMDISTRICT) AS "FLAGEDMBATAL",
       max(c.ASMCITYNOTE) AS "FOLLOWEDPOLICY",
       max(c.ASMCITY) AS "GROUPPANEL"
 FROM pooldata.t_propertylist c
 WHERE     c.nopolis = {TempPolis.POLICY_NO} and (c.FLAGDELETE is null or c.FLAGDELETE=0)
       AND c.PRODKE in 
              (SELECT max(PRODKE)
                 FROM T_GENERAL A
                WHERE A.NOPOLIS = c.NOPOLIS {ASIS:TempPolis.CUSTOMER}) group by c.indexobject</pyBrowseSQL>

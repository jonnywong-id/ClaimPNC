<pyBrowseSQL>select b.* from (
select a.*, ROWNUM rn from (SELECT 
a.pzinskey AS "StatusLock", 
a.pyid AS "RCVID", a.pnccaseid AS "PNCCaseID", a.BUSINESSNAME AS "Kurir", 
a.POLICYNO AS "PolicyNo", a.qqname AS "QQName", a.BookNo_1 as "Sender", 
a.DATEOFLOSS_1 AS "TglKejadian", a.STATUSLOCK_1, 
a.kodecabang_1 AS "StatusKomunikasi",
a.pxcreatedatetime as "pxCreateDateTime", a.pxcreateoperator , DateForAging_1 AS "DateForAging",
(SELECT b.message from pooldata.m_komunikasi_pnc b where a.pyid=b.caseid  and b.KOMUNIKASISTATUS={tempQuery.ClaimNo}  
    {ASIS:tempQuery.CaseID} order by createddate desc fetch next 1 rows only) as "EmailPengirim"
 FROM datapega.pc_asm_fw_gcnmfw_work a
WHERE 
     a.pxobjclass = 'ASM-FW-GCNMFW-Work-ReceiveDocument' 
     AND a.pxcreateoperator = {OperatorID.pyUserIdentifier}
     AND EXISTS 
                 (SELECT *
                  from pooldata.m_komunikasi_pnc b 
                 where a.pyid=b.caseid 
                 and b.KOMUNIKASISTATUS={tempQuery.ClaimNo} 
                {ASIS:tempQuery.CaseID} )
ORDER BY a.DateForAging_1 DESC ) a ) b
{ASIS:TempContents.NoteKasir}</pyBrowseSQL>

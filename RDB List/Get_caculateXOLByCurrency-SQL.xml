<pyBrowseSQL>select currency as "Currency",X.GROUPBUSINESS as "BusinessID",sum(x.AKSEPVALUE) as "OwnRiskValue",
sum(x.SALVAGEVALUE) AS "DeductibleValue"
,(select A.NOTE from POOLDATA.BUSINESSGROUP a where A.ID = X.GROUPBUSINESS) as "BusinessName" from POOLDATA.XOL_TABLE_ALL_KLAIM x 
where X.AKSEPVALUE != 0 and X.GROUPBUSINESS in ({ASIS:TempXOL.OccupationCode}) and TO_CHAR(TO_DATE (X.DOL, 'dd/mm/yyyy'),'dd/mm/yyyy') = {TempXOL.YearofQuartal} and X.CAUSEOFLOSS = {TempXOL.CauseOfLoss} 
group by X.CURRENCY,X.GROUPBUSINESS UNION ALL
select A.CURRENCYID,A.BUSINESSID,SUM (PAIDCLAIMAMOUNTSHARE),0,'Treaty Inward' FROM POOLDATA.T_CLAIM_INWARD_XOL a
 WHERE    TO_CHAR (TO_DATE (a.dateofloss, 'dd/mm/yyyy'), 'dd/mm/yyyy') = {TempXOL.YearofQuartal} and A.CAUSEOFLOSS = {TempXOL.CauseOfLoss} group by A.BUSINESSID,CURRENCYID</pyBrowseSQL>

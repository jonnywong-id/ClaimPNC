<pyBrowseSQL>select b.claimno AS "CaseID", b.nopolis AS "NoKTP", b.businessname AS "ClaimID",
b.qqname AS "ClaimNo",
a.nopla AS "Conveyance",  to_char(a.tglpla,'dd/mm/yyyy')  AS "Country", to_char(a.tglpla,'mm')  AS "District",a. plareinsurer AS "CountryID", 
b.coinsname AS "Email",
to_char(b.dateofloss,'dd/mm/yyyy') as "RefNo",
to_char(b.registerdate,'dd/mm/yyyy') AS "Remark",
b.picteknik AS "RW"
from t_plalist a, t_claim_pnc b
where a.claimid=b.claimid
and trunc(a.tglpla)&gt;=to_date ({TempLaporan.AnalystTransferDate},'dd/mm/yyyy') 
and trunc(a.tglpla)&lt;=to_date ({TempLaporan.DateOfLoss},'dd/mm/yyyy') 
{ASIS:TempLaporan.UserTeknis}
order by a.tglpla ASC</pyBrowseSQL>

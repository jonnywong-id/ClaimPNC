<pyBrowseSQL>select 
(       CASE
           WHEN A.STS_KONVERSI = '999'
               THEN
                  'Tidak Aktif'
              WHEN getcountdataJSON(a.NOPOLIS)='1'
                    THEN
                             CASE
                        WHEN getIsEDMCancelation(a.NOPOLIS) &lt;&gt; to_number('1')
                        THEN
                              CASE 
                                  WHEN
                                         trunc(StartDate)  &lt;= trunc(sysdate)
                                         and  trunc(EndDate) &gt;= trunc(sysdate) 
                                         THEN
                                               'Aktif'
                                  WHEN 
                                        trunc(StartDate)  &gt;= trunc(sysdate) 
                                        OR
                                        trunc(EndDate)  &lt;= trunc(sysdate)
                                        THEN
                                            'Tidak Aktif'    
                              END  
                       WHEN getIsEDMCancelation(a.NOPOLIS) = to_number('1')
                       THEN
                            'Tidak Aktif'
                     END
               WHEN getcountdataJSON(a.NOPOLIS) &gt; '1' 
                and tg.StatusBusiness = '3'
                    THEN
                        CASE WHEN tg.EdmType &lt;&gt; '7'
                        THEN
                               CASE WHEN tg.EdmDate is not null then
                                    CASE
                                        WHEN getIsEDMCancelation(a.NOPOLIS) &lt;&gt; to_number('1')
                                        THEN
                                                     CASE 
                                                         WHEN
                                                             to_date(tg.EdmDate,'dd-mm-yyyy') &lt;= trunc(sysdate)
                                                             and  trunc(tg.StartDate) &gt;= trunc(sysdate) 
                                                           THEN 'Aktif'
                                                         WHEN
                                                             to_date(tg.EdmDate,'dd-mm-yyyy') &lt;= trunc(sysdate)
                                                             and  trunc(tg.enddate) &lt;= trunc(sysdate) 
                                                           THEN ' tidak  Aktif'
                                                         WHEN
                                                             to_date(tg.EdmDate,'dd-mm-yyyy') &lt;= trunc(sysdate)
                                                             and  trunc(tg.enddate) &gt;= trunc(sysdate) 
                                                           THEN ' Aktif'
                                                        WHEN 
                                                            to_date(tg.EdmDate,'dd-mm-yyyy') &gt;= trunc(sysdate) 
                                                            OR
                                                             trunc(tg.EndDate) &lt;= trunc(sysdate)
                                                        THEN 'Tidak Aktif'    
                                                     END
                                        WHEN getIsEDMCancelation(a.NOPOLIS) = to_number('1')
                                        THEN
                                            'Tidak Aktif'
                                    END
                               END  
                        WHEN tg.EdmType = '7'
                        THEN
                            CASE WHEN getIsEDMCancelation(a.NOPOLIS) = to_number('1') THEN
                            'Tidak Aktif'
                            WHEN getIsEDMCancelation(a.NOPOLIS) = to_number('0') THEN
                            'Aktif'
                            END
                        END        
              WHEN getcountdataJSON(a.NOPOLIS) &gt; '1' 
              and tg.StatusBusiness = '1' or tg.StatusBusiness = '2'
                 THEN
                     CASE
                        WHEN getIsEDMCancelation(a.NOPOLIS) &lt;&gt; to_number('1')
                        THEN
                              CASE 
                                  WHEN
                                          trunc(tg.StartDate) &lt;= trunc(sysdate)
                                         and  trunc(tg.EndDate) &gt;= trunc(sysdate) 
                                         THEN
                                               'Aktif'
                                  WHEN 
                                         trunc(tg.StartDate)  &gt;= trunc(sysdate) 
                                        OR
                                         trunc(tg.EndDate) &lt;= trunc(sysdate)
                                        THEN
                                            'Tidak Aktif'    
                              END  
                       WHEN getIsEDMCancelation(a.NOPOLIS) = to_number('1')
                       THEN
                            'Tidak Aktif'
                     END                                       
        END) as HASIL1
from JSON_POLIS a, t_general tg
where a.idpega=tg.idpega
and a.nopolis = tg.nopolis
and a.prodke = tg.prodke
and a.NOPOLIS = '{ASIS:InputData.CARI1}' AND a.PRODKE = '{ASIS:InputData.CARI2}'</pyBrowseSQL>

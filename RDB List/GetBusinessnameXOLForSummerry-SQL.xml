<pyBrowseSQL>SELECT BUSINESSGROUPID AS "BusinessID",
         (SELECT BUSINESSGROUPNAME
            FROM POOLDATA.BUSINESS b
           WHERE X.BUSINESSGROUPID = B.BUSINESSGROUPID AND ROWNUM = 1)
            AS "BusinessName"
    FROM Pooldata.T_CLAIM_XOL x
   WHERE col_desc ={getDetailXOL.CauseOfLoss}  AND TO_CHAR (DATEOFLOSS, 'dd/mm/yyyy') = {getDetailXOL.NoKTP}
GROUP BY BUSINESSGROUPID 
union
select BUSINESSID as "BusinessID",'Treaty Inward' as "BusinessName" FROM POOLDATA.T_CLAIM_INWARD_XOL a
   WHERE     TO_CHAR (TO_DATE (a.dateofloss, 'dd/mm/yyyy'), 'dd/mm/yyyy') ={getDetailXOL.NoKTP}  AND A.CAUSEOFLOSS = {getDetailXOL.CauseOfLoss}
GROUP BY BUSINESSID</pyBrowseSQL>

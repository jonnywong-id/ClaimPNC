<pyBrowseSQL>SELECT a.pyID AS "ClaimNo",
         a.pzinskey AS "CaseID",
         a.policyno AS "District",
         a.qqname AS "CountryID",
         a.RECEIVEDDATE_1 as "DateOfRequestDocument",
         A.BUSINESSNAME AS "Country",
         a.sobname AS "CityID",
         a.branchname AS "City",
         a.pyOrigUserID AS "ReporterName",
         to_char(a.pxCreateDateTime,'dd/mm/yyyy') AS "StatusWork",
         to_char(a.dateofloss_1,'dd/mm/yyyy') AS "RW",
         a.statusclaim_1,
         a.pyStatusWork AS "StatusClaim",
        TO_CHAR ((Select r.FINISHREGISTERDATE from POOLDATA.T_CLAIM_PNC r where A.PXINSNAME = R.CLAIMNO), 'dd/mm/yyyy') AS "Prodke",
         b.PXASSIGNEDOPERATORID AS "NamaSurveyor",
         a.UserTeknis_1 AS "UserTeknis",
         (SELECT b.lsc_note
            FROM v_sts_claim b
           WHERE a.STATUSCLAIM_1 = b.LSC_ID)
            AS "CloseClaimNote",
           (select sum(CONVERTVALUE) from POOLDATA.T_CLAIM_ESTIMASI e where E.CLAIMID = a.pzinskey) as "NoRekap",
           (select TSI from POOLDATA.PEGA_DASHBOARDPNC e where E.NOKLAIM= a.PXINSNAME ) as "NoteKasir"
    FROM datapega.pc_asm_fw_gcnmfw_work a,
         datapega.pc_assign_worklist b,
         pooldata.business c,
         pooldata.businessgroup d
   WHERE     a.pxobjclass = 'ASM-FW-GCNMFW-Work-PNC'
         AND a.pzInsKey = b.pxrefobjectkey
         AND a.BUSINESSCODE_1 = c.id
         AND c.businessgroupid = d.id
         AND pystatuswork NOT IN ('Resolved-Completed', 'Resolved-Rejected')
         AND b.pxflowname not in ('FixCorrespondence', 'Register_Flow_1') 
         AND b.PXTASKLABEL not in ('FixCorrespondence')
         AND a.branchname!='ASNET'
{ASIS:TempView.pyNote}
ORDER BY a.pxCreateDateTime DESC</pyBrowseSQL>

<pyBrowseSQL>select b.* from (
select a.*, ROWNUM rn from (SELECT a.pzinskey AS "StatusLock",
         a.pyid AS "RCVID",
         a.pnccaseid AS "PNCCaseID",
         a.BUSINESSNAME AS "Kurir",
         a.POLICYNO AS "PolicyNo",
         a.qqname AS "QQName",
         a.DATEOFLOSS_1 AS "TglKejadian",
         STATUSLOCK_1,
         a.pxcreatedatetime AS "pxCreateDateTime",
         a.pystatuswork,
         a.pxcreateoperator as "KodeCabang",
         DateForAging_1 AS "DateForAging",
         (SELECT C.BRANCHNAME FROM pooldata.BRANCH C, DATAPEGA.PC_ASM_FW_GCNMFW_WORK e WHERE e.KODECABANG_1=C.ID and  e.pyid=a.pyid) AS "UserAdmin",
        a.kodecabang_1 AS "StatusKomunikasi"
    FROM datapega.pc_asm_fw_gcnmfw_work a, pooldata.business c, pooldata.businessgroup d  
   WHERE     a.pnccaseid IS NOT NULL
         AND a.pxobjclass = 'ASM-FW-GCNMFW-Work-ReceiveDocument'
         AND a.statusLock_1 IS NOT NULL
AND A.BUSINESSCODE_1 = c.id AND c.businessgroupid = d.id
{ASIS:tempQuery.Remark}
{ASIS:tempQuery.NoKTP}
{ASIS:tempQuery.pyNote}
         AND EXISTS
                (SELECT *
                   FROM pooldata.t_claim_pnc b, pooldata.t_claim_adjustment c
                  WHERE     a.pnccaseid = b.CLAIMNO
                        AND b.claimid = c.claimid
                        AND c.noakseptasi IS NOT NULL)
ORDER BY a.DateForAging_1 DESC) a ) b
{ASIS:TempContents.NoteKasir}</pyBrowseSQL>

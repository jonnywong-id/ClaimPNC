<pyBrowseSQL>DECLARE 
  POLISNO VARCHAR2(32767);
  PEGAID VARCHAR2(32767);
  ERRMSG VARCHAR2(32767);
  OUTJSON CLOB;

BEGIN 
  POLISNO := {TempJsonKlaim.POLICY_NO};
  PEGAID := {TempJsonKlaim.BUSINESS_CODE};
  ERRMSG := {TempJsonKlaim.IDMASTER};

  DBMS_LOB.CREATETEMPORARY(OUTJSON, true);  

  POOLDATA.JSONKLAIMTEMP.INSERTKASIRKLAIM ( {TempJsonKlaim.POLICY_NO}, {TempJsonKlaim.BUSINESS_CODE}, {TempJsonKlaim.START_DATE}, {TempJsonKlaim.IDMASTER OUT}, {TempObject.City OUT}, {TempJsonKlaim.ACCEPT_NO});
  COMMIT; 
END;</pyBrowseSQL>

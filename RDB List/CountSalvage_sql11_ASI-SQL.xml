<pyBrowseSQL>SELECT
    SUM (
        CASE 
            WHEN 
                (A.CLAIMID='ASM-FW-GCNMFW-WORK ' || B.NOKLAIM
                AND (B.STSTRANSFER='1' AND A.STSSALVAGE ='2'))
                THEN 1 
                ELSE 0 
                END ) 
                AS "ClaimNo", /*Sudah Balai Lelang*/
    SUM (
        CASE 
            WHEN 
                (A.CLAIMID = 'ASM-FW-GCNMFW-WORK ' || B.NOKLAIM and B.STSTRANSFER in ('1','6'))
                THEN 1 
                ELSE 0 
                END ) 
                AS "City",  /* history salvage*/
    SUM (
        CASE 
            WHEN 
                (A.CLAIMID = 'ASM-FW-GCNMFW-WORK ' || B.NOKLAIM 
                AND (B.STSTRANSFER = '3' or B.STSTRANSFER = '5'))
                THEN 1 
                ELSE 0 
                END ) 
                AS "CityID",  /*checker*/
    SUM (
        CASE 
            WHEN 
                (A.CLAIMID='ASM-FW-GCNMFW-WORK ' || B.NOKLAIM
                 AND (B.STSTRANSFER='4'))
                THEN 1 
                ELSE 0 
                END ) 
                AS "Email",   /*Reject dari Cheker*/
   SUM (
        CASE 
            WHEN 
                (A.CLAIMID='ASM-FW-GCNMFW-WORK ' || B.NOKLAIM
                 AND A.STSSALVAGE='2')
                THEN 1 
                ELSE 0 
                END ) 
                AS "NoKTP", /*Ekonomis*/
      SUM (
        CASE 
            WHEN 
                (A.CLAIMID='ASM-FW-GCNMFW-WORK ' || B.NOKLAIM
                 AND (A.STSSALVAGE='3' or B.STSTRANSFER='6'))
                THEN 1 
                ELSE 0 
                END ) 
                AS "ProvinceID",  /*Tidak Ekonomis*/
     SUM (
        CASE 
            WHEN 
                (A.CLAIMID='ASM-FW-GCNMFW-WORK ' || B.NOKLAIM
                 AND B.STSTRANSFER='6')
                THEN 1 
                ELSE 0 
                END ) 
                AS "RW",  /*Tidak Waive Salvage*/
     SUM (
        CASE 
            WHEN 
                (A.CLAIMID='ASM-FW-GCNMFW-WORK ' || B.NOKLAIM
                 AND A.STSSALVAGE='4')
                THEN 1 
                ELSE 0 
                END ) 
                AS "Province"   /*TBA*/
FROM POOLDATA.T_CLAIM_PNC A, POOLDATA.PNC_SALVAGE B 
WHERE A.GROUPPANEL IN ('003','004','006','009') AND A.BUSINESSCODE NOT IN ('10145', '10168')</pyBrowseSQL>

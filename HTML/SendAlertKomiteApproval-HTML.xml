<pySourceStream>&lt;html&gt;
  &lt;head&gt;
 &lt;style&gt;
.link-button{
   background-color: white;
   border: 2px solid #e7e7e7;
  border-radius: 12px;
  color: black;
  font-color: black;
  padding: 5px 10px;
  text-align: center;
  text-decoration: none;
  display: inline-block;
  font-size: 12px;
  margin: 4px 2px;
  cursor: pointer;
}
&lt;/style&gt;
  &lt;/head&gt;
   &lt;body&gt;
     &lt;table&gt;
       &lt;tr&gt;&lt;td&gt;Dear,&lt;/td&gt;&lt;/tr&gt;
       &lt;tr&gt;&lt;/tr&gt;
       &lt;tr&gt;&lt;td&gt;Berikut status komite yang sudah diproses &lt;/td&gt;&lt;/tr&gt; 
          &lt;tr&gt;&lt;br/&gt;&lt;/tr&gt;
       &lt;tr&gt; &lt;td&gt;No Klaim&lt;/td&gt;
         &lt;td&gt;:&lt;/td&gt;
         &lt;td&gt;&lt;b&gt;&lt;pega:reference name="TempKomiteEmail.Remarks"&gt;&lt;/pega:reference&gt;&lt;/b&gt;&lt;/td&gt;
       &lt;/tr&gt;
       &lt;tr&gt;&lt;td&gt;No KMT&lt;/td&gt;
         &lt;td&gt;:&lt;/td&gt;
         &lt;td&gt;&lt;b&gt;&lt;pega:reference name="TempKomiteEmail.Initial"&gt;&lt;/pega:reference&gt;&lt;/b&gt;&lt;/td&gt;
       &lt;/tr&gt;
       &lt;tr&gt;&lt;td&gt;Nama Komite&lt;/td&gt;
         &lt;td&gt;:&lt;/td&gt;
         &lt;td&gt;&lt;b&gt;&lt;pega:reference name="TempKomiteEmail.KomiteID"&gt;&lt;/pega:reference&gt;&lt;/b&gt;&lt;/td&gt;
       &lt;/tr&gt;
       &lt;tr&gt;&lt;td&gt;Nama PIC&lt;/td&gt;
         &lt;td&gt;:&lt;/td&gt;
         &lt;td&gt;&lt;b&gt;&lt;pega:reference name="TempKomiteEmail.KomiteEmail"&gt;&lt;/pega:reference&gt;&lt;/b&gt;&lt;/td&gt;
       &lt;/tr&gt;
       &lt;tr&gt;&lt;td&gt;Status Akseptasi Komite&lt;/td&gt;
         &lt;td&gt;:&lt;/td&gt;
         &lt;pega:when test="TempKomiteEmail.Salvage=='1'"&gt;
           &lt;td&gt;&lt;b&gt;Approve&lt;/b&gt;&lt;/td&gt;
                  &lt;/pega:when&gt;
         &lt;pega:when test="TempKomiteEmail.Salvage=='2'"&gt;
           &lt;td&gt;&lt;b&gt;Reject&lt;/b&gt;&lt;/td&gt;
                  &lt;/pega:when&gt;
       &lt;/tr&gt;
       &lt;tr&gt;&lt;td&gt;Komen Komite&lt;/td&gt;
         &lt;td&gt;:&lt;/td&gt;
         &lt;td&gt;&lt;b&gt;&lt;pega:reference name="TempKomiteEmail.KomiteComment"&gt;&lt;/pega:reference&gt;&lt;/b&gt;&lt;/td&gt;
       &lt;/tr&gt;
          &lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;
     &lt;/table&gt;&lt;br&gt;
     Terima Kasih.
	&lt;br&gt;&lt;br&gt;
   
  &lt;/body&gt;

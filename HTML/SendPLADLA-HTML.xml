  &lt;head&gt;
 &lt;style&gt;
.link-button{
   background-color: white;
   border: 2px solid #e7e7e7;
  border-radius: 12px;
  color: black;
  font-color: black;
  padding: 5px 10px;
  text-align: center;
  text-decoration: none;
  display: inline-block;
  font-size: 12px;
  margin: 4px 2px;
  cursor: pointer;
}
&lt;/style&gt;
  &lt;/head&gt;
   &lt;body&gt;
     &lt;pega:when test="NOTIFEMAILSBUKTI.FlagASO=='1'"&gt;
     &lt;table&gt;
       &lt;tr&gt;
        &lt;td&gt;Send : &lt;pega:reference name="NOTIFEMAILSBUKTI.NoteKasir"&gt;&lt;/pega:reference&gt; &lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
        &lt;td&gt;From : &lt;pega:reference name="NOTIFEMAILSBUKTI.ExGratiaNote"&gt;&lt;/pega:reference&gt; &lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
        &lt;td&gt;To : &lt;pega:reference name="NOTIFEMAILSBUKTI.TelpMasking"&gt;&lt;/pega:reference&gt; &lt;/td&gt;
      &lt;/tr&gt;
       &lt;tr&gt;
        &lt;td&gt;Subject : &lt;pega:reference name="NOTIFEMAILSBUKTI.SubjectEmail"&gt;&lt;/pega:reference&gt; &lt;/td&gt;
      &lt;/tr&gt;
     &lt;/table&gt;
     &lt;/pega:when&gt;
     &lt;table&gt;
       &lt;tr&gt;&lt;td&gt;Dengan Hormat,&lt;/td&gt;&lt;/tr&gt;
       &lt;tr&gt;&lt;/tr&gt;
       &lt;tr&gt;
         &lt;pega:when test="SendPLADLA.CityID=='PLA'"&gt;
         &lt;td&gt;Merujuk klaim diatas, bersama ini kami kirimkan dokumen PLA &lt;/td&gt;
         &lt;/pega:when&gt;
         &lt;pega:when test="SendPLADLA.CityID=='DLA'"&gt;
         &lt;td&gt;Merujuk klaim diatas, bersama ini kami kirimkan dokumen DLA &lt;/td&gt;
         &lt;/pega:when&gt;
       &lt;/tr&gt; 
          &lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;
       &lt;tr&gt; 
         &lt;td&gt;&lt;pega:reference name="SendPLADLA.CloseClaimNote"&gt;&lt;/pega:reference&gt;&lt;/td&gt;
       &lt;/tr&gt;
       &lt;tr&gt;&lt;td&gt; &lt;/td&gt;&lt;/tr&gt;
       &lt;tr&gt;&lt;td&gt; &lt;/td&gt;&lt;/tr&gt;
       &lt;tr&gt;&lt;td&gt; &lt;/td&gt;&lt;/tr&gt;
       &lt;tr&gt;&lt;td&gt;&lt;b&gt;*Klaim ini dihandle oleh &lt;pega:reference name="SendPLADLA.UserTeknis"&gt;&lt;/pega:reference&gt;&lt;/b&gt;&lt;/td&gt;     
       &lt;/tr&gt;
       &lt;tr&gt;&lt;td&gt; &lt;/td&gt;&lt;/tr&gt;
       &lt;tr&gt;&lt;td&gt; &lt;/td&gt;&lt;/tr&gt;
       &lt;tr&gt;&lt;td&gt; &lt;/td&gt;&lt;/tr&gt;
         &lt;tr&gt;
         &lt;pega:when test="SendPLADLA.CityID=='PLA'"&gt;
         &lt;td&gt;&lt;b&gt;*PLA di cetak by sistem dan sudah valid tanpa adanya cap resmi &lt;pega:reference name="TempGetApp.LSC_NOTE"&gt;&lt;/pega:reference&gt;.&lt;/b&gt;&lt;/td&gt;
         &lt;/pega:when&gt;
         &lt;pega:when test="SendPLADLA.CityID=='DLA'"&gt;
         &lt;td&gt;&lt;b&gt;*DLA di cetak by sistem dan sudah valid tanpa adanya cap resmi &lt;pega:reference name="TempGetApp.LSC_NOTE"&gt;&lt;/pega:reference&gt;.&lt;/b&gt;&lt;/td&gt;
         &lt;/pega:when&gt;
         &lt;br/&gt;
       &lt;/tr&gt;
       &lt;tr&gt;&lt;td&gt; &lt;/td&gt;&lt;/tr&gt;
       &lt;tr&gt;&lt;td&gt; &lt;/td&gt;&lt;/tr&gt;
       &lt;tr&gt;&lt;td&gt; &lt;/td&gt;&lt;/tr&gt;
       &lt;tr&gt;
         &lt;td&gt;Supporting dokumen via email ini menggantikan pengiriman dokumen via ekspedisi yang selama ini kami lakukan.&lt;/td&gt;
       &lt;/tr&gt;
       &lt;tr&gt;
         &lt;td&gt;Mohon Bapak / Ibu dapat memeriksa kembali isi dokumen terlampir.&lt;/td&gt;
       &lt;/tr&gt;
       &lt;tr&gt;
         &lt;td&gt;&lt;b&gt;Apabila dalam waktu dua hari tidak ada konfirmasi, maka kami anggap dokumen tersebut telah diterima secara jelas dan lengkap.&lt;/b&gt;&lt;/td&gt;
       &lt;/tr&gt;
       &lt;br/&gt;
       &lt;tr&gt;&lt;td&gt; &lt;/td&gt;&lt;/tr&gt;
       &lt;tr&gt;&lt;td&gt; &lt;/td&gt;&lt;/tr&gt;
       &lt;tr&gt;&lt;td&gt; &lt;/td&gt;&lt;/tr&gt;
         &lt;td&gt; Untuk melihat detail dapat diakses melalui link &lt;b&gt;&lt;a href="http://pega.sinarmas.co.id/prweb/"&gt;PEGA SITE&lt;/a&gt;&lt;/b&gt;&lt;/td&gt;
       &lt;tr&gt;
         &lt;td&gt;&lt;b&gt;Login : &lt;pega:reference name="SendPLADLA.UserName"&gt;&lt;/pega:reference&gt;&lt;/b&gt;&lt;/td&gt;
       &lt;/tr&gt;  
         &lt;br/&gt;
       &lt;tr&gt;&lt;td&gt; &lt;/td&gt;&lt;/tr&gt;
       &lt;tr&gt;&lt;td&gt; &lt;/td&gt;&lt;/tr&gt;
       &lt;tr&gt;
         &lt;td&gt;Demikian kami sampaikan, atas perhatian dan kerjasamanya kami ucapkan terima kasih.&lt;/td&gt;
       &lt;/tr&gt;    
       &lt;tr&gt;&lt;td&gt; &lt;/td&gt;&lt;/tr&gt;
       &lt;tr&gt;&lt;td&gt; &lt;/td&gt;&lt;/tr&gt;
       &lt;tr&gt;&lt;td&gt; &lt;/td&gt;&lt;/tr&gt;
     &lt;tr&gt;
       &lt;td&gt;&lt;i&gt;Claim Non MBU Administration Departement&lt;/i&gt;&lt;/td&gt;
     &lt;/tr&gt;
     &lt;tr&gt;
       &lt;td&gt;&lt;i&gt;&lt;pega:reference name="TempGetApp.LSC_NOTE"&gt;&lt;/pega:reference&gt;&lt;/i&gt;&lt;/td&gt;
     &lt;/tr&gt;

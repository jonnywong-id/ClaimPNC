   &lt;body&gt;
     &lt;table&gt;
       
       &lt;!--
       &lt;tr&gt; &lt;td&gt;Subject &lt;/td&gt;
         &lt;td&gt;:&lt;/td&gt;
         &lt;td&gt;&lt;pega:reference name="CatatanKlaim.CauseOfLoss"&gt;&lt;/pega:reference&gt;&lt;/td&gt; //Subject Email
       &lt;/tr&gt; --&gt;
       &lt;tr&gt;
         &lt;p&gt;Dear Bpk/Ibu &lt;br&gt;&lt;pega:reference name="CatatanKlaim.Telephone"&gt;&lt;/pega:reference&gt;&lt;br&gt;&lt;/p&gt;
         &lt;p&gt;Sehubung dengan pengajuan klaim asuransi dengan polis &lt;pega:reference name="CatatanKlaim.PolicyNo"&gt;&lt;/pega:reference&gt; a/n &lt;pega:reference name="CatatanKlaim.NamaDokterRCL"&gt;&lt;/pega:reference&gt;,tanggal kejadian    &lt;pega:reference name="CatatanKlaim.NoRekap"&gt;&lt;/pega:reference&gt; yang dilaporkan pada &lt;pega:reference name="CatatanKlaim.NoPla"&gt;&lt;/pega:reference&gt;, &lt;br&gt;kami mengingatkan Bapak/Ibu untuk menyampaikan kelengkapan dokumen klaim ini agar klaim dapat kami proses lebih lanjut.&lt;/p&gt;
         &lt;p&gt;&lt;b&gt;On Without Prejudice to Policy Liability&lt;/b&gt;, dokumen yang diperlukan terkait klaim ini: &lt;br&gt; 
         &lt;br&gt;&lt;pega:forEach name="TempCatatanKlaim.pxResults"&gt;
             *&lt;pega:reference name = "$this.ProgressID"/&gt;&lt;br&gt;
           &lt;/pega:forEach&gt;
         *Dan dokumen/ hal lainnya bila diperlukan dikemudian hari (belum bersifat final)&lt;br&gt;
         Kami mengharapkan agar dokumen dapat diberikan dalam waktu dekat agar proses klaim dapat dilanjutkan.&lt;br&gt;&lt;br&gt;
         Terima kasih atas perhatian dan kerjasamanya.&lt;/p&gt;
        
       &lt;/tr&gt;
       &lt;tr&gt;
       &lt;p&gt;
       Best Regards,&lt;br&gt;&lt;br&gt;
       &lt;pega:reference name="CatatanKlaim.Usulan"&gt;&lt;/pega:reference&gt;
       &lt;/p&gt;
       &lt;/tr&gt;

<pySourceStream>&lt;!DOCTYPE html&gt;
&lt;html&gt;
&lt;head&gt;
  &lt;meta http-equiv="Content-Type" content="text/html; charset=UTF-8"&gt;
  &lt;style&gt;
    table {
    width: 640px;
    border-collapse: collapse;
    border-spacing: 0;
    }
    td, th { border: 1px solid #CCC; }
  &lt;/style&gt;
  &lt;%
  ClipboardPage MyServicePage = tools.findPage("MyServicePage");
  ClipboardPage Requesttor = tools.findPage("pxRequestor");
  String lbuid = Requesttor.getString("pxReqContextURI");
    if(lbuid.equals("https://cloudpega.sinarmas.co.id/prweb")){
    lbuid = "https://pegaservice.sinarmas.co.id/prweb";
  }
	String tempcaseid = MyServicePage.getString(".ClaimData.CaseID").trim(); 
	String tempobjectid = MyServicePage.getString(".ClaimData.KomiteStatus").trim(); 
	String tempcoverageid = MyServicePage.getString(".ClaimData.DistrictID").trim();  
	String temptype = MyServicePage.getString(".ClaimData.ExGratia").trim();
	String tempoperator = MyServicePage.getString(".ClaimData.Country").trim();
	String tempaproved = MyServicePage.getString(".ClaimData.KomiteApprove").trim();
  String tempkey = MyServicePage.getString(".ClaimData.KodeCabang").trim();
	
  %&gt;
  &lt;script&gt;
    function yesKomite()
    {
      var comment = document.getElementById('comment').value;
      var caseid = document.getElementById('caseid').value;
      var objectid = document.getElementById('objectid').value;
      var coverageid = document.getElementById('coverageid').value;
      var type = document.getElementById('type').value;
      var operator = document.getElementById('operator').value;
      var aproved = document.getElementById('aproved').value;
      var key = document.getElementById('key').value;
      var srcpega = document.getElementById('srcpega').value;
      
      if(comment == '' || comment == null)
      {
        alert('harap isi comment');
      }
      else
      {
        window.location = srcpega+"/PRRestService/ASMFWGCNMFWWORKPNC/ASM-FW-GCNMFW-WORK-PNC/KomiteAcceptAdjustmentConfirmation?caseid="+caseid+"&amp;objectid="+objectid+"&amp;coverageid="+coverageid+"&amp;type="+type+"&amp;operator="+operator+"&amp;comment="+comment+"&amp;key="+key+"&amp;aproved="+aproved;
      }
    }
  &lt;/script&gt;
&lt;/head&gt;
&lt;body &gt;
&lt;form id="frm" name="frm" onsubmit="return false" action="&lt;%=lbuid%&gt;/PRRestService/ASMFWGCNMFWWORKPNC/ASM-FW-GCNMFW-WORK-PNC/KomiteAcceptAdjustmentConfirmationPA"&gt;
   &lt;input type="hidden" name="caseid" id="caseid" value="&lt;pega:reference name="MyServicePage.ClaimData.CaseID"&gt;&lt;/pega:reference&gt;"/&gt;
   &lt;input type="hidden" name="objectid" id="objectid" value="&lt;pega:reference name="MyServicePage.ClaimData.KomiteStatus"&gt;&lt;/pega:reference&gt;"/&gt;
   &lt;input type="hidden" name="coverageid" id="coverageid" value="&lt;pega:reference name="MyServicePage.ClaimData.DistrictID"&gt;&lt;/pega:reference&gt;"/&gt;
   &lt;input type="hidden" name="type" id="type" value="&lt;pega:reference name="MyServicePage.ClaimData.ExGratia"&gt;&lt;/pega:reference&gt;"/&gt;
   &lt;input type="hidden" name="operator" id="operator" value="&lt;pega:reference name="MyServicePage.ClaimData.Country"&gt;&lt;/pega:reference&gt;"/&gt;
   &lt;input type="hidden" name="key" id="key" value="&lt;pega:reference name="MyServicePage.ClaimData.KodeCabang"&gt;&lt;/pega:reference&gt;"/&gt;
   &lt;input type="hidden" name="aproved" id="aproved" value="&lt;pega:reference name="MyServicePage.ClaimData.KomiteApprove"&gt;&lt;/pega:reference&gt;"/&gt;
   &lt;input type="hidden" name="srcpega" id="srcpega" value="&lt;%=lbuid%&gt;"/&gt;
   &lt;!--&lt;input type="hidden" name="aproved" id="aproved" value="&lt;pega:reference name="MyServicePage.ClaimData.KomiteApprove"&gt;&lt;/pega:reference&gt;"/&gt;--&gt;
   &lt;pega:when name="MyServicePage.ClaimData.RCV_ID=='0'"&gt;
     &lt;pega:when name="MyServicePage.ClaimData.CaseID==''"&gt;
       Email tidak support, silahkan gunakan IBM Notes atau akseptasi menggunakan handphone
        &lt;br&gt;&lt;br&gt;
      &lt;tr&gt;
           &lt;td colspan="3" align="center"&gt;&lt;input type="button" value="CLOSE" onClick="window.close();"&gt;&lt;/td&gt;
         &lt;/tr&gt;
     &lt;/pega:when&gt;
     &lt;pega:when name="MyServicePage.ClaimData.CaseID!=''"&gt;
       &lt;tr&gt;&lt;td&gt;Catatan komite : &lt;/td&gt;&lt;/tr&gt;
         &lt;tr&gt;
           &lt;br&gt;
           &lt;td&gt;&lt;textarea name="comment" id="comment" rows="4" cols="50"&gt;&lt;pega:reference name="MyServicePage.ClaimData.ProdKe"&gt;&lt;/pega:reference&gt;&lt;/textarea&gt;&lt;/td&gt;
         &lt;/tr&gt;
       &lt;br&gt;
       &lt;br&gt;
         &lt;tr&gt;
           &lt;td colspan="3" align="center"&gt;&lt;input type="button" value="SEND" onClick="yesKomite()"&gt;&lt;/td&gt;
         &lt;/tr&gt;
     &lt;/pega:when&gt;
   &lt;/pega:when&gt;
   &lt;pega:when name="MyServicePage.ClaimData.RCV_ID!='0'"&gt;
     	Persetujuan Komite Sudah di jawab, tidak bisa menjawab persetujuan komite kembali
     &lt;br&gt;&lt;br&gt;
      &lt;tr&gt;
           &lt;td colspan="3" align="center"&gt;&lt;input type="button" value="CLOSE" onClick="window.close();"&gt;&lt;/td&gt;
         &lt;/tr&gt;
   &lt;/pega:when&gt;
&lt;/form&gt;
  
  
&lt;/body&gt;  
&lt;/html&gt;</pySourceStream>

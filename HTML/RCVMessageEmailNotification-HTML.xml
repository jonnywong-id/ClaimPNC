   &lt;body&gt;
      Dear,&lt;br&gt;&lt;br&gt;
      &lt;!--Terima kasih atas pelaporan yang telah bapak/ibu kirim.&lt;br&gt;--&gt;
      Berikut pesan yang disampaikan : &lt;br&gt;
      &lt;ul&gt;
        &lt;li&gt;&lt;pega:reference name="TempKomunikasi.District"&gt;&lt;/pega:reference&gt;&lt;/li&gt;
      &lt;/ul&gt;
     &lt;pega:when test = "TempKomunikasi.CityID!=''"&gt;
     &lt;table&gt;
       
       &lt;tr&gt;
         &lt;pega:when test="TempKomunikasi.City='1'"&gt;
         &lt;td&gt;No.Klaim&lt;/td&gt;
         &lt;td&gt;:&lt;/td&gt;
         &lt;td&gt;&lt;b&gt;&lt;pega:reference name="pyWorkPage.ClaimData.RCV_ID"&gt;&lt;/pega:reference&gt;&lt;/b&gt;&lt;/td&gt;
         &lt;/pega:when&gt;  
       &lt;/tr&gt;        
        &lt;tr&gt;
          &lt;pega:when test="TempKomunikasi.City='1'"&gt;
         &lt;td&gt;Kekurangan Dokumen&lt;/td&gt;
         &lt;td&gt;:&lt;/td&gt;
            &lt;/pega:when&gt;
         &lt;td Valign="top"&gt;
           &lt;table style="width:100%" style = "border: 1px solid black;"&gt;
              &lt;tr&gt;
                 &lt;td&gt;&lt;b&gt;Tipe Dokumen&lt;/b&gt;&lt;/td&gt;
                 &lt;td&gt;&lt;b&gt;Detail Dokumen&lt;/b&gt;&lt;/td&gt;
                 &lt;td&gt;&lt;b&gt;Keterangan&lt;/b&gt;&lt;/td&gt;
       		  &lt;/tr&gt;
              &lt;pega:forEach name="TempDTDoc.DFT_DOC_DET"&gt;
                &lt;tr&gt;
                  &lt;td style = "padding:10px;"&gt;&lt;pega:reference name="$THIS.DOC_COL_INFO"&gt;&lt;/pega:reference&gt;&lt;/td&gt;
                   &lt;td style = "padding:10px;"&gt;&lt;pega:reference name="$THIS.DETAIL_DOCUMENT"&gt;&lt;/pega:reference&gt;&lt;/td&gt;
                   &lt;td style = "padding:10px;"&gt;&lt;pega:reference name="$THIS.ID"&gt;&lt;/pega:reference&gt;&lt;/td&gt;

<pySourceStream>&lt;html&gt;
  &lt;head&gt;
   &lt;style&gt;
     body{
       color:#000000;
     }
    .table1{
        border: 1px solid #999;
        padding: 1px 1px;
        font-family: sans-serif;
        color: #232323;
        border-collapse: collapse;

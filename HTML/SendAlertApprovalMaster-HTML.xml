<pySourceStream>&lt;html&gt;
  &lt;head&gt;
 &lt;style&gt;
.link-button{
   background-color: white;
   border: 2px solid #e7e7e7;
  border-radius: 12px;
  color: black;
  font-color: black;
  padding: 5px 10px;
  text-align: center;
  text-decoration: none;
  display: inline-block;
  font-size: 12px;
  margin: 4px 2px;
  cursor: pointer;
}
&lt;/style&gt;
  &lt;/head&gt;
   &lt;body&gt;
     &lt;table&gt;
       &lt;tr&gt;&lt;td&gt;Dear Pak Daniel/Pak Bambang,&lt;/td&gt;&lt;/tr&gt;
       &lt;tr&gt;&lt;/tr&gt;
       &lt;tr&gt;&lt;td&gt;Terdapat inputan master yang membutuhkan approval &lt;/td&gt;&lt;/tr&gt; 
          &lt;tr&gt;&lt;br/&gt;&lt;/tr&gt;
       &lt;tr&gt; &lt;td&gt;Jenis Master/Approval&lt;/td&gt;
         &lt;td&gt;:&lt;/td&gt;
         &lt;td&gt;&lt;b&gt;&lt;pega:reference name="TempMaster.NamaDokumen"&gt;&lt;/pega:reference&gt;&lt;/b&gt;&lt;/td&gt;
       &lt;/tr&gt;
       &lt;tr&gt;
         &lt;pega:when test="TempMaster.NamaDokumen!='PERBEDAAN NO RANGKA' &amp;&amp; TempMaster.CaseID!= 'UnknownID' "&gt;
         &lt;td&gt;ID Master&lt;/td&gt;
         &lt;/pega:when&gt;  
         &lt;pega:when test="TempMaster.NamaDokumen=='PERBEDAAN NO RANGKA'"&gt;
         &lt;td&gt;No Klaim&lt;/td&gt;
         &lt;/pega:when&gt; 
         &lt;pega:when test="TempMaster.CaseID!= 'UnknownID' "&gt;
         &lt;td&gt;:&lt;/td&gt;
         &lt;/pega:when&gt; 
         &lt;pega:when test="TempMaster.CaseID!= 'UnknownID' "&gt;
         &lt;td&gt;&lt;b&gt;&lt;pega:reference name="TempMaster.CaseID"&gt;&lt;/pega:reference&gt;&lt;/b&gt;&lt;/td&gt;
           &lt;/pega:when&gt; 
       &lt;/tr&gt;  
       &lt;tr&gt;
         &lt;pega:when test="TempMaster.NamaDokumen=='BENGKEL'"&gt;
           &lt;td&gt;Nama Bengkel&lt;/td&gt;
          &lt;/pega:when&gt;
         &lt;pega:when test="TempMaster.NamaDokumen=='PANEL'"&gt;
           &lt;td&gt;Nama Panel&lt;/td&gt;
          &lt;/pega:when&gt;
         &lt;pega:when test="TempMaster.NamaDokumen=='SPAREPART'||TempMaster.NamaDokumen=='GROUPING SPAREPART'"&gt;
           &lt;td&gt;Nama Sparepart&lt;/td&gt;
          &lt;/pega:when&gt;
         &lt;pega:when test="TempMaster.NamaDokumen=='KATEGORI SPAREPART'"&gt;
           &lt;td&gt;Nama Kategori Sparepart&lt;/td&gt;
          &lt;/pega:when&gt;
         &lt;pega:when test="TempMaster.NamaDokumen=='TIPE SPAREPART'"&gt;
           &lt;td&gt;Nama Tipe Sparepart&lt;/td&gt;
          &lt;/pega:when&gt;
         &lt;pega:when test="TempMaster.NamaDokumen!='PERBEDAAN NO RANGKA'"&gt;
         &lt;td&gt;:&lt;/td&gt;
         &lt;/pega:when&gt;  
         &lt;td&gt;&lt;b&gt;&lt;pega:reference name="TempMaster.CauseOfLoss"&gt;&lt;/pega:reference&gt;&lt;/b&gt;&lt;/td&gt;
       &lt;/tr&gt;
       &lt;tr&gt;
         &lt;pega:when test="TempMaster.NamaDokumen=='GROUPING SPAREPART'"&gt;
           &lt;td&gt;Nama Panel&lt;/td&gt;
         &lt;td&gt;:&lt;/td&gt;
         &lt;td&gt;&lt;b&gt;&lt;pega:reference name="TempMaster.Conveyance"&gt;&lt;/pega:reference&gt;&lt;/b&gt;&lt;/td&gt;
         &lt;/pega:when&gt;
       &lt;/tr&gt;
       &lt;tr&gt;
         &lt;pega:when test="TempMaster.NamaDokumen=='GROUPING SPAREPART'"&gt;
           &lt;td&gt;No Rangka&lt;/td&gt;
         &lt;td&gt;:&lt;/td&gt;
         &lt;td&gt;&lt;b&gt;&lt;pega:reference name="TempMaster.Country"&gt;&lt;/pega:reference&gt;&lt;/b&gt;&lt;/td&gt;
         &lt;/pega:when&gt;
       &lt;/tr&gt;
          &lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;
     &lt;/table&gt;&lt;br&gt;
     Data dapat di cek di inbox manager tab approval master.
     &lt;br&gt;
     Terima Kasih.
	&lt;br&gt;&lt;br&gt;
   
  &lt;/body&gt;
&lt;/html&gt;</pySourceStream>

<pySourceStream>&lt;!DOCTYPE html&gt;
&lt;html&gt;
&lt;head&gt;
  &lt;meta http-equiv="Content-Type" content="text/html; charset=UTF-8"&gt;
  &lt;style&gt;
    table {
    width: 640px;
    border-collapse: collapse;
    border-spacing: 0;
    }
    td, th { border: 1px solid #CCC; }
  &lt;/style&gt;
  &lt;%
  	ClipboardPage MyServicePage = tools.findPage("MyServicePage");
	ClipboardPage Claim = MyServicePage.getProperty(".ClaimData").getPageValue();
  ClipboardPage Requesttor = tools.findPage("pxRequestor");
  String lbuid = Requesttor.getString("pxReqContextURI");
  if(lbuid.equals("https://pega.sinarmas.co.id/prweb")){
    lbuid = "https://pegaservice.sinarmas.co.id/prweb";
  }
	String tempcaseid = Claim.getString(".CaseID"); 
	String tempobject_id = Claim.getString(".CityID").trim(); 
	String tempaproved2 = Claim.getString(".KomiteApprove").trim();
	String temptipeSurveyor = Claim.getString(".LokasiSurveyor").trim();
	String tempsurveyor = Claim.getString(".NamaSurveyor");
	String tempKomiteID = Claim.getString(".DistrictID").trim();
	String tempKomiteCount = Claim.getString(".ProvinceID").trim();
	String tempComment = Claim.getString(".Remark").trim();
  String tempKey = Claim.getString(".KodeCabang").trim();
	
  %&gt;
  &lt;script&gt;
    function yesKomite(aproved)
    {
      var comment = document.getElementById('comment').value;
      var surveyor = document.getElementById('surveyor').value;
      var caseid = document.getElementById('caseid').value;
      var object_id = document.getElementById('object_id').value;
      var komite = document.getElementById('komite').value;
      var komiteCount = document.getElementById('komiteCount').value;
      var key = document.getElementById('key').value;
      var srcpega = document.getElementById('srcpega').value;
      if(aproved==1)
      {
        if(surveyor == '' || surveyor == null)
        {
          alert('harap isi surveyor');
        }
        else
        {
          if(comment == '' || comment == null)
          {
            alert('harap isi comment');
          }
          else
          {  
            window.location = srcpega+"/PRRestService/ASMFWGCNMFWWORKPNC/ASM-FW-GCNMFW-WORK-PNC/KomiteAcceptSurvey?caseid="+caseid+"&amp;object_id="+object_id+"&amp;surveyor="+surveyor+"&amp;comment="+comment+"&amp;aproved="+aproved+"&amp;komiteid="+komite+"&amp;komitecount="+komiteCount+"&amp;key="+key;
          }
        }
      }
      else
      {
        if(comment == '' || comment == null)
        {
          alert('harap isi comment');
        }
        else
        {
          window.location = srcpega+"/PRRestService/ASMFWGCNMFWWORKPNC/ASM-FW-GCNMFW-WORK-PNC/KomiteAcceptSurvey?caseid="+caseid+"&amp;object_id="+object_id+"&amp;surveyor="+surveyor+"&amp;comment="+comment+"&amp;aproved="+aproved+"&amp;komiteid="+komite+"&amp;komitecount="+komiteCount+"&amp;key="+key;
        }
      }
    }
  &lt;/script&gt;
&lt;/head&gt;
&lt;body &gt;
  &lt;form id="frm" name="frm" onsubmit="return false" action="&lt;%=lbuid%&gt;/PRRestService/ASMFWGCNMFWWORKPNC/ASM-FW-GCNMFW-WORK-PNC/KomiteAcceptSurvey"&gt;
    &lt;input type="hidden" name="caseid" id="caseid" value="&lt;pega:reference name="MyServicePage.ClaimData.CaseID"&gt;&lt;/pega:reference&gt;"/&gt;
    &lt;input type="hidden" name="object_id" id="object_id" value="&lt;pega:reference name="MyServicePage.ClaimData.CityID"&gt;&lt;/pega:reference&gt;"/&gt;
    &lt;input type="hidden" name="location" id="location" value="&lt;pega:reference name="MyServicePage.ClaimData.Location"&gt;&lt;/pega:reference&gt;"/&gt;
    &lt;input type="hidden" name="surveyorId" id="surveyorId" value="&lt;pega:reference name="MyServicePage.ClaimData.LokasiSurveyor"&gt;&lt;/pega:reference&gt;"/&gt;
    &lt;input type="hidden" name="komite" id="komite" value="&lt;pega:reference name="MyServicePage.ClaimData.DistrictID"&gt;&lt;/pega:reference&gt;"/&gt;
    &lt;input type="hidden" name="komiteCount" id="komiteCount" value="&lt;pega:reference name="MyServicePage.ClaimData.ProvinceID"&gt;&lt;/pega:reference&gt;"/&gt;
    &lt;input type="hidden" name="key" id="key" value="&lt;pega:reference name="MyServicePage.ClaimData.KodeCabang"&gt;&lt;/pega:reference&gt;"/&gt;
    &lt;input type="hidden" name="srcpega" id="srcpega" value="&lt;%=lbuid%&gt;"/&gt;
    &lt;pega:when name="MyServicePage.ClaimData.KomiteApprove==1"&gt;
      &lt;label&gt;Terima kasih telah menjawab, jawaban email anda telah di terima&lt;/label&gt;
    &lt;/pega:when&gt;
  
	&lt;pega:when name="MyServicePage.ClaimData.KomiteApprove==0"&gt;
      &lt;table align="center" id="object"&gt;
		&lt;tr&gt;
          &lt;td&gt;ID Object&lt;/td&gt;
          &lt;td&gt;Nama Object&lt;/td&gt;
          &lt;td&gt;Lokasi Object&lt;/td&gt;
          &lt;td&gt;Nama Adjuster&lt;/td&gt;
          &lt;td&gt;&lt;/td&gt;
		&lt;/tr&gt;
		&lt;tr&gt;
          &lt;td&gt;&lt;%=tempobject_id %&gt;&lt;/td&gt;
          &lt;td&gt;&lt;pega:reference name="TempObjectList.pxResults(1).ObjectName"&gt;&lt;/pega:reference&gt;&lt;/td&gt;
          &lt;td&gt;&lt;pega:reference name="TempObjectList.pxResults(1).ObjectLocation"&gt;&lt;/pega:reference&gt;&lt;/td&gt;
          &lt;td&gt;&lt;%=tempsurveyor %&gt;&lt;/td&gt;
          &lt;td&gt;
            &lt;select class="form-control" name="surveyor" id="surveyor"&gt;
              &lt;option value="" &gt;--Pilih--&lt;/option&gt;
              &lt;pega:forEach name="TempResultSurveyor.pxResults"&gt;
                &lt;option value="&lt;pega:reference name="$THIS.LOGIN_APLIKASI"&gt;&lt;/pega:reference&gt;" &gt;&lt;pega:reference name="$THIS.NAME"&gt;&lt;/pega:reference&gt;&lt;/option&gt;
              &lt;/pega:forEach&gt;
            &lt;/select&gt;
          &lt;/td&gt;
        &lt;/tr&gt;
      &lt;/table&gt;
      &lt;br&gt;
      &lt;table align="center"&gt;
		&lt;tr&gt;
			&lt;td&gt;Alasan&lt;/td&gt;
			&lt;td&gt;:&lt;/td&gt;
			&lt;td&gt;&lt;textarea name="comment" id="comment"&gt;&lt;/textarea&gt;&lt;/td&gt;
		&lt;/tr&gt;
		&lt;tr&gt;
          &lt;td colspan="3" align="center"&gt;&lt;input type="button" name="aproved" id="aproved" value="PILIH ADJUSTER" onClick="yesKomite('1')"
               colspan="3" align="center"&gt;&lt;input type="button" name="aproved" id="aproved" value="TIDAK PAKAI ADJUSTER" onClick="yesKomite('2')"&gt;&lt;/td&gt;
		&lt;/tr&gt;
	&lt;/table&gt;
 &lt;/pega:when&gt;
  
&lt;/form&gt;
&lt;/body&gt;
&lt;/html&gt;</pySourceStream>

        &lt;tr style="background-color: #EEEBEB;"&gt;
            &lt;th&gt;No&lt;/th&gt;
            &lt;th&gt;No Klaim&lt;/th&gt;
            &lt;th&gt;Komite Approval&lt;/th&gt;
            &lt;th&gt;Tanggal Komite Approve&lt;/th&gt;
            &lt;th&gt;AI Approval&lt;/th&gt;
            &lt;th&gt;Tanggal AI Dikirim&lt;/th&gt;
            &lt;th&gt;Nama Komite&lt;/th&gt;

             &lt;/tr&gt;    
             &lt;tr&gt;
               &lt;table&gt;
                 &lt;tr&gt;
                   &lt;pega:when test="CatatanKlaim.District!=''"&gt;
                     &lt;td&gt;
                       &lt;pega:forEach name="CatatanKlaim.Data"&gt;
                         &lt;span&gt;&lt;pega:reference name="$THIS.NAMAFILE"&gt;&lt;/pega:reference&gt; : &lt;pega:reference name="$THIS.ErrMsg"&gt;&lt;/pega:reference&gt;&lt;/span&gt;&lt;br&gt;  
                     &lt;/pega:forEach&gt;
                       &lt;!--Keterangan : &lt;pega:reference name="CatatanKlaim.District"&gt;&lt;/pega:reference&gt; --&gt;

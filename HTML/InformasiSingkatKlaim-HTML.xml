   &lt;body&gt;
     &lt;table&gt;
       &lt;tr&gt;&lt;td&gt;Dear,&lt;/td&gt;&lt;/tr&gt;
       &lt;tr&gt;&lt;/tr&gt;
       &lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt; 
          &lt;tr&gt;&lt;br/&gt;&lt;/tr&gt;
       &lt;tr&gt; &lt;td&gt;Perihal &lt;/td&gt;
         &lt;td&gt;:&lt;/td&gt;
         &lt;td&gt;&lt;pega:reference name="CatatanKlaim.CauseOfLoss"&gt;&lt;/pega:reference&gt;&lt;/td&gt;
       &lt;/tr&gt;
       &lt;tr&gt; &lt;td&gt;Catatan &lt;/td&gt;
         &lt;td&gt;:&lt;/td&gt;
         &lt;td&gt;&lt;pega:reference name="CatatanKlaim.Remark"&gt;&lt;/pega:reference&gt;&lt;/td&gt;
       &lt;/tr&gt;
       &lt;pega:when test="CatatanKlaim.Status!='1'"&gt;
       &lt;tr&gt;&lt;td&gt;Keterangan &lt;/td&gt;
         &lt;td&gt;:&lt;/td&gt;
         &lt;td&gt;&lt;pega:reference name="CatatanKlaim.AlasanKlaim"&gt;&lt;/pega:reference&gt;&lt;/td&gt;
         &lt;table&gt;
         &lt;pega:forEach name="CatatanKlaim.Data"&gt;
            &lt;td&gt;&lt;span&gt;&lt;pega:reference name="$THIS.NAMAFILE"&gt;&lt;/pega:reference&gt; : &lt;pega:reference name="$THIS.ErrMsg"&gt;&lt;/pega:reference&gt;&lt;/span&gt;&lt;br&gt;&lt;/td&gt;
         &lt;/pega:forEach&gt;
         &lt;/table&gt;
       &lt;/tr&gt;
        &lt;/pega:when&gt;
       &lt;pega:when test="CatatanKlaim.TKA=='1'"&gt;
       &lt;br&gt;&lt;br&gt;&lt;tr&gt;&lt;td&gt;Hormat Kami &lt;/td&gt;
         &lt;td&gt;&lt;br&gt;&lt;br&gt;&lt;/td&gt;
         &lt;td&gt;&lt;pega:reference name="CatatanKlaim.Province"&gt;&lt;/pega:reference&gt;&lt;/td&gt;
       &lt;/tr&gt;&lt;br&gt;&lt;br&gt;
        &lt;/pega:when&gt;
       &lt;pega:when test="CatatanKlaim.Status=='1'"&gt;
       &lt;tr&gt;&lt;td&gt;Keterangan &lt;/td&gt;
         &lt;td&gt;:&lt;/td&gt;
         &lt;td&gt;
       &lt;tr&gt; 
           &lt;table&gt;
             &lt;tr&gt; 
               &lt;td&gt;1. Data Salvage Balai Lelang&lt;/td&gt;
               &lt;td&gt;:&lt;/td&gt;
               &lt;td&gt;&lt;pega:reference name="CatatanKlaim.AlasanKlaim"&gt;&lt;/pega:reference&gt;&lt;/td&gt;
               &lt;td&gt;
             &lt;tr&gt;
               &lt;table&gt;
                 &lt;tr&gt;
                   &lt;pega:when test="CatatanKlaim.City!=''"&gt;
                     &lt;td&gt;
                       Keterangan : &lt;pega:reference name="CatatanKlaim.City"&gt;&lt;/pega:reference&gt; 
                     &lt;/td&gt; 
                   &lt;/pega:when&gt; 
                 &lt;/tr&gt;                              
                &lt;/table&gt; 
             &lt;/tr&gt;                  
               &lt;/td&gt; 
             &lt;/tr&gt;
             
             &lt;br&gt;
             
             &lt;tr&gt; 
               &lt;td&gt;2. File Salvage Balai Lelang&lt;/td&gt;
               &lt;td&gt;:&lt;/td&gt;
               &lt;td&gt;&lt;pega:reference name="CatatanKlaim.Country"&gt;&lt;/pega:reference&gt;&lt;/td&gt;
               &lt;td&gt;
             &lt;tr&gt;
               &lt;table&gt;
                 &lt;tr&gt;File yang gagal dikirim : &lt;/tr&gt; 
                 &lt;tr&gt;
                   &lt;pega:when test="CatatanKlaim.CityID!=''"&gt;
                     &lt;pega:forEach name="TempErrImg.pxResults"&gt;
                         &lt;span&gt;&lt;pega:reference name="$THIS.City"&gt;&lt;/pega:reference&gt;&lt;/span&gt;&lt;br&gt;  
                     &lt;/pega:forEach&gt;
                   &lt;/pega:when&gt; 
                 &lt;/tr&gt;                              
                &lt;/table&gt; 
             &lt;/tr&gt;                  
               &lt;/td&gt; 
             &lt;/tr&gt;
             
             &lt;br&gt;
             
             &lt;tr&gt;
               &lt;td&gt;3. Data Salvage SimasBid&lt;/td&gt;

<pySourceStream>&lt;html&gt;
  &lt;head&gt;
    &lt;style&gt;
      .poinned {
        margin-left: 30px;
      }
      .link-button{
        background-color: white;
        border: 2px solid #e7e7e7;
        border-radius: 12px;
        color: black;
        font-color: black;
        padding: 5px 10px;
        text-align: center;
        text-decoration: none;
        display: inline-block;
        font-size: 12px;
        margin: 4px 2px;
        cursor: pointer;
        }
      .salam {
        margin-top: 30px;
      }
    &lt;/style&gt;
  &lt;/head&gt;
  &lt;body&gt;
    &lt;pega:when test="NOTIFEMAILSBUKTI.FlagASO=='1'"&gt;
     &lt;table&gt;
       &lt;tr&gt;
        &lt;td&gt;Send : &lt;pega:reference name="NOTIFEMAILSBUKTI.NoteKasir"&gt;&lt;/pega:reference&gt; &lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
        &lt;td&gt;From : &lt;pega:reference name="NOTIFEMAILSBUKTI.ExGratiaNote"&gt;&lt;/pega:reference&gt; &lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
        &lt;td&gt;To : &lt;pega:reference name="NOTIFEMAILSBUKTI.TelpMasking"&gt;&lt;/pega:reference&gt; &lt;/td&gt;
      &lt;/tr&gt;
       &lt;tr&gt;
        &lt;td&gt;Subject : &lt;pega:reference name="NOTIFEMAILSBUKTI.SubjectEmail"&gt;&lt;/pega:reference&gt; &lt;/td&gt;
      &lt;/tr&gt;
     &lt;/table&gt;
     &lt;/pega:when&gt;
    &lt;table&gt;
      &lt;tr&gt;
        &lt;td&gt;Dear Messr.&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
        &lt;td&gt;&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
        &lt;td&gt;&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
        &lt;td&gt;&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
        &lt;td&gt;&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
        &lt;td&gt;Referring to the above claim mentioned, herewith we enclosed the supporting documents:&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
        &lt;td&gt;&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
         &lt;pega:when test="SendPLADLA.CityID=='PLA'"&gt;
        &lt;td&gt;&lt;li class="poinned"&gt;PLA : &lt;pega:reference name="TempData.ClaimData.ClaimNo"&gt;&lt;/pega:reference&gt;&lt;/li&gt;&lt;/td&gt;
         &lt;/pega:when&gt;
        &lt;pega:when test="SendPLADLA.CityID=='DLA'"&gt;
        &lt;td&gt;&lt;li class="poinned"&gt;DLA : &lt;pega:reference name="TempData.ClaimData.ClaimNo"&gt;&lt;/pega:reference&gt;&lt;/li&gt;&lt;/td&gt;
         &lt;/pega:when&gt;
      &lt;/tr&gt;
      &lt;!--&lt;tr&gt;
        &lt;td&gt;&lt;li class="poinned"&gt;Claim Notification&lt;/li&gt;&lt;/td&gt;
      &lt;/tr&gt;--&gt;
      &lt;tr&gt;
        &lt;td&gt;&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
        &lt;td&gt;&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
        &lt;td&gt;This claim was handled by &lt;pega:reference name="SendPLADLA.UserTeknis"&gt;&lt;/pega:reference&gt;
        &lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
        &lt;td&gt;&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
        &lt;td&gt;&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
        &lt;pega:when test="SendPLADLA.CityID=='PLA'"&gt;
          &lt;td&gt;
            &lt;b&gt;*This PLA Printed by System and Valid without &lt;pega:reference name="TempGetApp.LSC_NOTE"&gt;&lt;/pega:reference&gt; official stamp.&lt;/b&gt;
          &lt;/td&gt;
        &lt;/pega:when&gt;
        &lt;pega:when test="SendPLADLA.CityID=='DLA'"&gt;
          &lt;td&gt;
            &lt;b&gt;*This DLA Printed by System and Valid without &lt;pega:reference name="TempGetApp.LSC_NOTE"&gt;&lt;/pega:reference&gt; official stamp.&lt;/b&gt;
          &lt;/td&gt;
        &lt;/pega:when&gt;
        &lt;br /&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
        &lt;td&gt;&lt;/td&gt;
      &lt;/tr&gt;
      &lt;br/&gt;
       &lt;tr&gt;&lt;td&gt; &lt;/td&gt;&lt;/tr&gt;
       &lt;tr&gt;&lt;td&gt; &lt;/td&gt;&lt;/tr&gt;
       &lt;tr&gt;&lt;td&gt; &lt;/td&gt;&lt;/tr&gt;
         &lt;td&gt; To see the details can be accessed via the link &lt;b&gt;&lt;a href="http://pega.sinarmas.co.id/prweb/"&gt;PEGA SITE&lt;/a&gt;&lt;/b&gt;&lt;/td&gt;
       &lt;tr&gt;
         &lt;td&gt;&lt;b&gt;Login : &lt;pega:reference name="SendPLADLA.UserName"&gt;&lt;/pega:reference&gt;&lt;/b&gt;&lt;/td&gt;
       &lt;/tr&gt;  
         &lt;br/&gt;
       &lt;tr&gt;&lt;td&gt; &lt;/td&gt;&lt;/tr&gt;
       &lt;tr&gt;&lt;td&gt; &lt;/td&gt;&lt;/tr&gt;
      &lt;tr&gt;
        &lt;td&gt;&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
        &lt;td&gt;&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
        &lt;td&gt;
          &lt;i&gt;
            &lt;b&gt; Note: - This email substitutes the original document sent by courier.&lt;/b&gt;
           &lt;/i&gt;
        &lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
        &lt;td&gt;&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
        &lt;td&gt;&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
        &lt;td&gt;&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
        &lt;td&gt;Thank you and looking forward to receiving your confirmation whether you receive the same or not.&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
        &lt;td&gt;
          &lt;p class="salam"&gt;Regards, &lt;/p&gt;
        &lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
        &lt;td&gt;&lt;pega:reference name="TempDataNoPLA.ProvinceID"&gt;&lt;/pega:reference&gt; &lt;/td&gt;
      &lt;/tr&gt;
    &lt;/table&gt;
  &lt;/body&gt;
&lt;/html&gt;</pySourceStream>

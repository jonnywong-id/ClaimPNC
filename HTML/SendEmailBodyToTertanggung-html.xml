<pySourceStream>&lt;html&gt;
  &lt;head&gt;
   &lt;style&gt;
    .link-button{
       background-color: white;
       border: 2px solid #e7e7e7;
      border-radius: 12px;
      color: black;
      font-color: black;
      padding: 5px 10px;
      text-align: center;
      text-decoration: none;
      display: inline-block;
      font-size: 12px;
      margin: 4px 2px;
      cursor: pointer;
    }
    .table1{
        border: 1px solid #999;
        padding: 1px 1px;
        font-family: sans-serif;
        color: #232323;
        border-collapse: collapse;
    }
    .td1{border: 1px solid #999;
        padding: 1px 1px;
    }

&lt;/style&gt;
  &lt;/head&gt;
   &lt;body&gt;
    
       &lt;p&gt;Dear,&lt;/p&gt;
       
       &lt;p&gt;Terlampir kami sampaikan Proposed Adjustment, dan draf LOD untuk klaim &lt;b&gt;&lt;pega:reference name="TempEmailTertanggung.PlatNo"&gt;&lt;/pega:reference&gt;&lt;/b&gt; dengan rincian :&lt;/p&gt;
      &lt;table&gt;   
       &lt;tr&gt;&lt;td&gt;&amp;emsp;&amp;emsp;Nomor Polis&lt;/td&gt;
         &lt;td&gt;:&lt;/td&gt;
         &lt;td&gt;&lt;b&gt;&lt;pega:reference name="TempEmailTertanggung.NAME"&gt;&lt;/pega:reference&gt;&lt;/b&gt;&lt;/td&gt;
       &lt;/tr&gt;
       &lt;tr&gt;&lt;td&gt;&amp;emsp;&amp;emsp;Nomor Klaim&lt;/td&gt;
         &lt;td&gt;:&lt;/td&gt;
         &lt;td&gt;&lt;b&gt;&lt;pega:reference name="TempEmailTertanggung.warna"&gt;&lt;/pega:reference&gt;&lt;/b&gt;&lt;/td&gt;
       &lt;/tr&gt;
       &lt;tr&gt;&lt;td&gt;&amp;emsp;&amp;emsp;DOL&lt;/td&gt;
         &lt;td&gt;:&lt;/td&gt;
         &lt;td&gt;&lt;b&gt;&lt;pega:reference name="TempEmailTertanggung.MERK"&gt;&lt;/pega:reference&gt;&lt;/b&gt;&lt;/td&gt;
       &lt;/tr&gt;
      &lt;/table&gt;&lt;br&gt;
      &lt;!-- Proposed Adjustemnt --&gt;
           &lt;table class="table1" width = 45%&gt;
             &lt;tr&gt;
               &lt;td align=center class="td1"&gt;DESCRIPTION&lt;/td&gt;
               &lt;td align=center class="td1"&gt;&lt;/td&gt;
               &lt;pega:when test="pyWorkPage.Policy.Quotation.BusinessType!='Travel'"&gt;
                 &lt;td align=center class="td1"&gt;ADJUSTMENT&lt;/td&gt;
               &lt;/pega:when&gt;
               &lt;pega:when test="pyWorkPage.Policy.Quotation.BusinessType=='Travel'"&gt;
                 &lt;td align=center class="td1"&gt;Claim Accepted&lt;/td&gt;
               &lt;/pega:when&gt;
             &lt;/tr&gt;
             &lt;tr&gt;
               &lt;td class="td1"&gt;Total Claim&lt;/td&gt;
               &lt;td align=right class="td1"&gt;&lt;/td&gt;
               &lt;td align=right class="td1"&gt;
                 &lt;pega:reference name="tempAdj.Currency"&gt;&lt;/pega:reference&gt;
                 &lt;pega:reference name="tempAdj.ProposeAdjustmentValue"&gt;&lt;/pega:reference&gt;
               &lt;/td&gt;
             &lt;/tr&gt;
             &lt;pega:when test="tempAdj.LOC!='' &amp;&amp; tempAdj.LOC!=0"&gt;
               &lt;tr&gt;
                 &lt;td class="td1"&gt;Lack Of Document&lt;/td&gt;
                 &lt;td align=right class="td1"&gt;
                   &lt;pega:reference name="tempAdj.LOC"&gt;&lt;/pega:reference&gt;% 
                 &lt;/td&gt;
                 &lt;td align=right class="td1"&gt;
                   &lt;pega:reference name="tempAdj.Currency"&gt;&lt;/pega:reference&gt;
                   &lt;pega:reference name="tempAdj.LOCValue"&gt;&lt;/pega:reference&gt;
                 &lt;/td&gt;
               &lt;/tr&gt;
             &lt;/pega:when&gt; 
             &lt;pega:when test="tempAdj.SalvageValueA!='' &amp;&amp; tempAdj.SalvageValueA!=0"&gt;
               &lt;tr&gt;
                 &lt;td class="td1"&gt;Less Salvage&lt;/td&gt;
                 &lt;td align=right class="td1"&gt;&lt;/td&gt;
                 &lt;td align=right class="td1"&gt;
                   &lt;pega:reference name="tempAdj.Currency"&gt;&lt;/pega:reference&gt;
                   &lt;pega:reference name="tempAdj.SalvageValueA"&gt;&lt;/pega:reference&gt;
                 &lt;/td&gt;
               &lt;/tr&gt;
             &lt;/pega:when&gt;
             &lt;tr&gt;
               &lt;td class="td1"&gt;Less Deductible&lt;/td&gt;
               &lt;td class="td1"&gt;
                 &lt;pega:when test="tempAdj.IndividualRiskPercentage!=0 &amp;&amp; tempAdj.IndividualRiskPercentage!=''"&gt;
                   &lt;pega:reference name="tempAdj.IndividualRiskPercentage"&gt;&lt;/pega:reference&gt; %
                 &lt;/pega:when&gt;
               &lt;/td&gt;
               &lt;td align=right class="td1"&gt;
                 &lt;pega:reference name="tempAdj.Currency"&gt;&lt;/pega:reference&gt;
                 &lt;pega:reference name="tempAdj.IndividualRiskValue"&gt;&lt;/pega:reference&gt;
               &lt;/td&gt;
             &lt;/tr&gt;
             &lt;tr&gt;
               &lt;td class="td1"&gt;Nett Of Deductible&lt;/td&gt;
               &lt;td align=right class="td1"&gt;&lt;/td&gt;
               &lt;td align=right class="td1"&gt;
                 &lt;pega:reference name="tempAdj.Currency"&gt;&lt;/pega:reference&gt;
                 &lt;pega:reference name="tempAdj.ProposeAdjustmentFinal"&gt;&lt;/pega:reference&gt;
               &lt;/td&gt;
             &lt;/tr&gt;
             &lt;pega:when test="tempAdj.SalvageValue!='' &amp;&amp; tempAdj.SalvageValue!=0"&gt;
               &lt;tr&gt;
                 &lt;td class="td1"&gt;Less Salvage&lt;/td&gt;
                 &lt;td align=right class="td1"&gt;&lt;/td&gt;
                 &lt;td align=right class="td1"&gt;
                   &lt;pega:reference name="tempAdj.Currency"&gt;&lt;/pega:reference&gt;
                   &lt;pega:reference name="tempAdj.SalvageValue"&gt;&lt;/pega:reference&gt;
                 &lt;/td&gt;
               &lt;/tr&gt;
             &lt;/pega:when&gt;
             &lt;pega:when test="tempAdj.InterimPayment!='' &amp;&amp; tempAdj.InterimPayment!=0"&gt;
               &lt;tr&gt;
                 &lt;td class="td1"&gt;Interim Payment&lt;/td&gt;
                 &lt;td align=right class="td1"&gt;&lt;/td&gt;
                 &lt;td align=right class="td1"&gt;
                   &lt;pega:reference name="tempAdj.Currency"&gt;&lt;/pega:reference&gt;
                   &lt;pega:reference name="tempAdj.InterimPayment"&gt;&lt;/pega:reference&gt;
                 &lt;/td&gt;
               &lt;/tr&gt;
             &lt;/pega:when&gt;
             &lt;tr&gt;
               &lt;td class="td1"&gt;&lt;b&gt;Nett Of Adjustment Value&lt;/b&gt;&lt;/td&gt;
               &lt;td class="td1"&gt;&lt;/td&gt;
               &lt;td align=right class="td1"&gt;
                 &lt;b&gt;
                   &lt;pega:reference name="tempAdj.Currency"&gt;&lt;/pega:reference&gt;
                   &lt;pega:reference name="tempAdj.AdjustmentValue"&gt;&lt;/pega:reference&gt;
                 &lt;/b&gt;
               &lt;/td&gt;
             &lt;/tr&gt;
             &lt;tr&gt;
               &lt;td class="td1"&gt;&lt;b&gt;ASM Share ( &lt;pega:reference name="tempAdj.IDAdjustClaim"&gt;&lt;/pega:reference&gt; % )&lt;/b&gt;&lt;/td&gt;
               &lt;td class="td1"&gt;&lt;/td&gt;
               &lt;td align=right class="td1"&gt; 
                 &lt;b&gt;
                   &lt;pega:reference name="tempAdj.Currency"&gt;&lt;/pega:reference&gt;
                   &lt;pega:reference name="tempAdj.AdjusterFeeValue"&gt;&lt;/pega:reference&gt;
                 &lt;/b&gt;
               &lt;/td&gt;
             &lt;/tr&gt;
           &lt;/table&gt;


      &lt;p&gt;Selanjutnya kami menunggu persetujuan dari tertanggng, dan pembayaran klaim ini akan kami proses setelah tertanggung : &lt;/p&gt;
      &lt;ul&gt;
        &lt;li&gt;Menyampaikan LOD yang telah ditandatangani diatas materai Rp 10.000&lt;/li&gt;
        &lt;li&gt;From survey kepuasan pelanggan&lt;/li&gt;
        &lt;pega:forEach name="TempFILEattach.pxResults"&gt;
        &lt;pega:when test="$THIS.City!=0"&gt; 
          &lt;tr&gt;
            &lt;td&gt;&lt;li&gt;&lt;pega:reference name="$THIS.Country"&gt;&lt;/pega:reference&gt;&lt;/li&gt;&lt;/td&gt;
          &lt;/tr&gt;
        &lt;/pega:when&gt;
        &lt;/pega:forEach&gt;
        
        &lt;!--&lt;li&gt;&lt;pega:reference name="TempEmailTertanggung.Notes"&gt;&lt;/pega:reference&gt;&lt;/li&gt; --&gt;
      &lt;/ul&gt;
      &lt;p&gt;Demikian kami sampaikan, atas perhatianya kami ucapkan Terima Kasih.&lt;/p&gt;
      &lt;p&gt;Salam&lt;/p&gt;
      &lt;b&gt;&lt;pega:reference name="TempEmailTertanggung.pyCountry"&gt;&lt;/pega:reference&gt;&lt;/b&gt;
    &lt;br&gt;&lt;br&gt;
  &lt;/body&gt;
&lt;/html&gt;</pySourceStream>

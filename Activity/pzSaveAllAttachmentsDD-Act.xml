<pyStepsJavaSource>ClipboardPage pgDD = tools.findPage( "dragDropFileUpload" );
ClipboardProperty pAttachIndex = pgDD.getProperty( "pyAttachIndex" );
ClipboardProperty pList = pgDD.getProperty( "pxResults" );
int size = pList.size();

StringMap keys = new HashStringMap();
keys.putString( "pyClassName", "Data-WorkAttach-File" );
keys.putString( "pyActivityName", "SaveAttachment" );

tools.putParamValue( "CalledFromDD", "true" );

ClipboardPage pgAttach = tools.findPage( tools.getParamValue( "AttachmentPageName" ) );
pgAttach = pgAttach.copy();

ClipboardPage pgRequestor = tools.findPage( "pxRequestor" );

for ( int j = 1 ; j &lt;= size ; j++ )
{
	ClipboardPage pgDDFile = pList.getPageValue( j );

	ClipboardPage pg = pgAttach.copy();
	pg.putString( "pyNote", pgDDFile.getString( "pyNote" ) );
	pg.putString( "pyCategory", pgDDFile.getString( "pyCategory" ) );

	pAttachIndex.setValue( Integer.toString( j ) );
	tools.putParamValue( "pzTransactionId", pgRequestor.getString( "pxClientExchange" ) );

	tools.doActivity( keys, pg, tools.getParameterPage() );

	if (pg.hasMessages()) {
      	pgDDFile.addMessages(pg);
      	tools.findPage(tools.getParamValue("AttachmentPageName")).addMessages(pg);
	}

	/* Without this sleep some files might get skipped in a multi-file attachment */
	try
	{	Thread.currentThread().sleep( 25 );
	}
	catch ( Exception ex )
	{
	}
}

tools.putParamValue( "pzTransactionId", pgRequestor.getString( "pxClientExchange" ) );
tools.putParamValue( "CalledFromDD", "false" );</pyStepsJavaSource>

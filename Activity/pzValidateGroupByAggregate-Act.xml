<pyStepsJavaSource>//Check if same sort order is given for more than 1 field.

Set setOfSortOrders = new java.util.TreeSet();
Set setOfDuplicateSortOrders = new java.util.TreeSet();

ClipboardPage pg_pyBody = tools.getPrimaryPage().getPage(".pyUI.pyBody");
ClipboardProperty pyFields_1 = tools.getPrimaryPage().getProperty(".pyUI.pyBody.pyUIFields");
String arrOfDupes[] = new String[pyFields_1.size()];

boolean hasDupes=false;
java.util.Iterator itr_results = pyFields_1.iterator();
while (itr_results.hasNext()) {
	ClipboardProperty cp_aResult = (ClipboardProperty) itr_results.next();
	ClipboardPage pg_aResult = cp_aResult.getPageValue();
         int sortOrder = pg_aResult.getInteger(".pySortOrder");
         if(sortOrder &gt; pyFields_1.size()){
  //            pg_aResult.addMessage("Sort order for some columns is greater than the number of columns in the report");
             pg_aResult.putString(".pySortOrder","");
             pg_aResult.putString(".pySortType","");
             sortOrder=0;
               continue;
          }
         if(sortOrder!=0){
              
                if(!setOfSortOrders.add(sortOrder+"")){
                  setOfDuplicateSortOrders.add(sortOrder+""); 
                 }
          }
}

if(setOfDuplicateSortOrders.size() &gt; 0){
pg_pyBody.addMessage("Following sort orders are entered in duplicate :"+ setOfDuplicateSortOrders.toString() + " . Sort order must not be repeated for different columns");
}</pyStepsJavaSource>

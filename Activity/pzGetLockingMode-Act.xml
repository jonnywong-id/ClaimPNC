<pyStepsJavaSource>ClipboardPage primaryPage=tools.getPrimaryPage();
ClipboardPage coverPage=tools.findPage(tools.getParamValue("coverPage"));

boolean isTopLevel = primaryPage.getString("pxCoverInsKey").equals("")?true:false;
String topCaseCls="";
StringMap tmpMap;

if(!isTopLevel){
   String insKey = tools.getPrimaryPage().getString("pzInsKey");
   String workCls = tools.getPrimaryPage().getString("pxObjClass");
   tmpMap= pega_processengine_workutilities.pxGetTopLevelCoverKeyAndClass(workCls,insKey);
   topCaseCls = tmpMap.getString("pxObjClass");
   if(topCaseCls==null || topCaseCls.length()==0)
   		topCaseCls =  primaryPage.getString("pxObjClass");

}else
topCaseCls =  primaryPage.getString("pxObjClass");

tmpMap= new HashStringMap();
tmpMap.putString("pxObjClass", "Rule-Obj-CaseType");
tmpMap.putString("pyPurpose", "pyDefault");
tmpMap.putString("pyClassName", topCaseCls);
ParameterPage pp = new ParameterPage();
pp.putString("pyCaseTypePurpose", "GETLOCKINGMODE");

try{
	tools.doAction(tmpMap, primaryPage, pp);
	lockingMode = pp.getString("LockingMode");
         if(lockingMode.equalsIgnoreCase("Default")) nextBlock="***";
}catch(Exception e){

}</pyStepsJavaSource>

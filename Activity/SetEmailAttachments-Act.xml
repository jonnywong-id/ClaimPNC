<pyStepsJavaSource>Database db_inf = tools.getDatabase();
String strClass = null;
boolean bDecode = false,
        bXML = false;
 
ClipboardPage page_Attachment = null,
              page_EmbedAttachment = null,
              page_AttachmentPage = tools.findPage("AttachmentPage"),
              page_OpenAttachments = tools.findPage("AttachmentLinksOpened");
ClipboardProperty prop_pxResults = page_OpenAttachments.getProperty("pxResults"),
                  prop_pyAttachment = null;

try {

   page_Attachment = db_inf.open(myStepPage.getString(".pxLinkedRefTo"),true);

   if ( page_Attachment != null ) {
      prop_pxResults.add(page_Attachment);

      strClass = page_Attachment.getString("pxObjClass");

      prop_pyAttachment = page_AttachmentPage.getProperty(".pyAttachments(&lt;append&gt;)");
      page_EmbedAttachment = prop_pyAttachment.getPageValue();


      bDecode= true;
      bXML=false;

      String strfilename = null;
      strfilename = page_Attachment.getString(".pxAttachName");
      strfilename =  (new java.io.File(strfilename)).getName();

      page_EmbedAttachment.putString(".pyReference","AttachmentLinksOpened.pxResults("+prop_pyAttachment.indexOf() +").pyAttachStream");
      page_EmbedAttachment.putString(".pyName",strfilename );
      page_EmbedAttachment.putString(".pyDecode","true"); 
      page_EmbedAttachment.putString(".pyRemoveXML","false");          	

    }

} catch (DatabaseException dbe) {

  tools.getPrimaryPage().addMessage( dbe.getMessage() );

}

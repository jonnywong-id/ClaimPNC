<pyStepsJavaSource>/** 
 * This step would determine the value of the goal time
 * from a property on the work page.
*/

// obtain the value of the property from the workpage.
ClipboardPage slaPage = tools.findPage("ServiceLevelRecord");
String propertyName = slaPage.getString(".pyEscalations(Goal).pyEscalationProperty");
String propertyValue = "";
try {
   propertyValue = myStepPage.getString(propertyName);
} catch (InvalidReferenceException e) {
   myStepPage.addMessage(e.getMessage());
}

// set the value for the pySLAGoal as obtained from the property
ClipboardProperty pySLAGoal = myStepPage.getProperty(".pySLAGoal");
pySLAGoal.setValue(propertyValue);
</pyStepsJavaSource>

<pyStepsDescription>Create a new pyWorkParty Page</pyStepsDescription>
<pyStepsActivityNameUC>JAVA</pyStepsActivityNameUC>
<pyStepsJavaSource>String pRole = myStepPage.getString("pyPartyRole");
String pCls = myStepPage.getString("pyPartyClass");
String pPrompt = myStepPage.getString("pyPartyClassPrompt");
String pLbl = myStepPage.getString("pyPartyLabel");
if (pLbl.equals(""))
         pLbl = pRole;
String pModel = myStepPage.getString("pyPartyClassModel");

ClipboardProperty workPartyProp = tools.getPrimaryPage().getProperty(".pyWorkParty");
workPartyProp.add(pRole, pCls);
ClipboardPage newPartyPage = workPartyProp.getPageValue(pRole);

// R-23105 set VOE property if necessary
ClipboardProperty roleVOE = newPartyPage.getProperty("pyPartyRoleVisibleOnEntry");
if (roleVOE != null) 
	roleVOE.setValue("true");

boolean bRequired = myStepPage.getProperty(".pyRequired").toBoolean();
if (bRequired)
{
	ClipboardProperty cp_pyPartyRoleRequired = newPartyPage.getProperty("pyPartyRoleRequired");
	cp_pyPartyRoleRequired.setValue("true");
}


ClipboardProperty cp_pyPartyLabel = newPartyPage.getProperty("pyPartyLabel");
cp_pyPartyLabel.setValue(pLbl);

ClipboardProperty cp_pyPartyClassPrompt = newPartyPage.getProperty("pyPartyClassPrompt");
cp_pyPartyClassPrompt.setValue(pPrompt);

if (pModel.length() &gt; 0) {
	tools.applyModel(newPartyPage, null, pModel);
	if (newPartyPage.getString(".pyWorkPartyUri").length() &gt; 0) {
		StringMap actPage = new HashStringMap();
		actPage.putString("pyClassName", pCls);
		actPage.putString("pyActivityName", "WorkPartyRetrieve");
		tools.doActivity(actPage, newPartyPage, null);
	}
}</pyStepsJavaSource>

# Biner hasil build
*.exe
# Go menyisakan berkas ~ saat menimpa binary yang sedang berjalan; 28 MB dan bukan sumber.
*.exe~
backend/claimpnc

# Hasil build SPA — dihasilkan `npm run build` di frontend/, disematkan saat go build.
# .gitkeep sengaja ikut supaya `go build ./...` tetap jalan pada clone yang bersih:
# direktif go:embed menuntut folder dist ada, walau isinya belum dibangun.
backend/spa/dist/*
!backend/spa/dist/.gitkeep

# Dependensi frontend
frontend/node_modules/

# Berkas lingkungan yang memuat nilai rahasia
backend/.env
backend/.env.*
!backend/.env.example

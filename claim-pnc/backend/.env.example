ANEKA_SPKS_SANDI=

# Batas pool koneksi kedua. Opsional; nilai baku sama dengan portal, 20 / 5 / 30m.
# ANEKA_ASM_MAKS_KONEKSI=20
# ANEKA_ASM_MAKS_IDLE=5
# ANEKA_ASM_UMUR_KONEKSI=30m

# ---------------------------------------------------------------------------
# Sistem Kasir — dipakai modul Master Rekening
# ---------------------------------------------------------------------------
# Dipanggil saat komite MENYETUJUI sebuah rekening, dan hanya untuk portal ASM dan
# SIMASNET. Menggantikan dua Connect-REST sistem lama:
#   InjectDataRekeningToKasir        -> KASIR_URL_DAFTAR_REKENING
#   UpdateSearchDataRekeningToKasir  -> KASIR_URL_PERBARUI_REKENING
#
# BELUM TERISI DAN ITU DISENGAJA. Alamat dan kredensialnya TIDAK ada di dalam export
# rule — keduanya berada di konfigurasi instans Pega, yang tidak ikut terekspor.
# Menunggu Tim Infra.
#
# Selama kosong, aplikasi tetap berjalan penuh: rekening tetap dapat diajukan dan
# diputuskan komite, hanya langkah pendaftaran ke Kasir yang dilewati. Aplikasi
# MEMPERINGATKANNYA di log saat start supaya keadaan itu tidak lolos tanpa disadari.
#
# JANGAN pernah mengisi nilai nyata di berkas ini — ia ikut ter-commit. Isilah di
# backend/.env yang diabaikan git.
KASIR_URL_DAFTAR_REKENING=
KASIR_URL_PERBARUI_REKENING=
# KASIR_USER / KASIR_PASSWORD juga dipakai Transfer Kasir (Basic Auth ke layanan
# KASIRPAID / KASIRPAIDSYARIAH / KASIRIVEST). Alamat layanan itu dibaca dari
# POOLDATA.GCNM_CONNECT_REST, bukan dari berkas ini.
KASIR_USER=
KASIR_PASSWORD=
# Pemeriksaan No Rekening penerima di master Kasir (COLLECTION.LST_ACCOUNT@ASMD) saat
# penerima klaim disimpan. Kosong = mengikuti APP_ENV: menyala di staging/production,
# mati di development (Kasir dev memakai master rekening lain).  Isi true/false untuk memaksa.
KASIR_CEK_REKENING=
# Opsional; nilai baku 30s.
# KASIR_BATAS_WAKTU=30s
# Batas waktu Transfer Kasir (bawaan 2m). Kasir memproses pembayaran sebelum menjawab;
# bila habis, layar meminta petugas MEMERIKSA Kasir sebelum mengulang (bisa jadi sudah terkirim).
# KASIR_TRANSFER_BATAS_WAKTU=2m

# ── Absensi PIC Teknik (ServiceGetDataAbsenPIC) ──────────────────────────────
#
# Dipakai memilih PIC Teknik Non-MBU: PIC yang tidak dijadwalkan masuk dilewati, dan pada
# akhir pekan/hari libur klaim dibiarkan tanpa PIC — sama dengan getRandomTeam_act.
# Permintaannya: GET {ABSEN_PIC_URL}/prweb/PRRestService/HCC/Absen/attendance/{PIC}/{yyyyMMdd}
# ABSEN_PIC_URL adalah alamat DASAR saja (skema + host), tanpa jalur. Kosong: setiap PIC
# dianggap hadir. Kredensial auth profile `servicehcd` dari Tim Infra/Security.
ABSEN_PIC_URL=
ABSEN_PIC_USER=
ABSEN_PIC_PASSWORD=
# ABSEN_PIC_BATAS_WAKTU=10s

# ── Penerbit Virtual Account (Master Recovery) ───────────────────────────────
#
# ⚠  TERTUTUP SECARA BAKU, DAN ITU DISENGAJA.
#
# Menyalakannya MENERBITKAN REKENING VIRTUAL SUNGGUHAN lewat layanan Pega. Berbeda
# dari adapter lain di berkas ini, yang keliru menyala paling jauh membaca data yang
# salah — yang ini meninggalkan rekening bank nyata yang tidak diminta siapa pun.
#
# Keputusan Work Owner 2026-09-29: jangan dibuka dulu.
#
# CARA MEMBUKANYA — ketiganya sekaligus, kurang satu pun tetap tertutup:
#
#   1. VIRTUAL_ACCOUNT_ADAPTER=pega
#   2. VIRTUAL_ACCOUNT_PENGGUNA diisi
#   3. VIRTUAL_ACCOUNT_SANDI diisi
#
# Ditambah PENYIMPANAN=oracle, karena alamat layanannya dibaca dari
# POOLDATA.GCNM_CONNECT_REST (APP=<portal>, TYPESERVICE='GENERATEDVA'). Meminta
# `pega` tanpa Oracle membuat aplikasi BERHENTI saat start, bukan diam-diam memakai
# tiruan.
#
# KREDENSIALNYA BUKAN KREDENSIAL HCQ. Rule
# `Connect REST/VirtualAccountClaimsPNC-ConnectREST.xml` ber-pyUseAuthentication=true
# dengan pyAuthenticationProfile = LELANG. Profil itu TIDAK ADA di export — hanya
# namanya yang dirujuk — sehingga kredensialnya harus diminta ke Tim Pega/Infra.
#
# Selama tertutup, layar Master Recovery tetap berjalan penuh: nomor VA yang tampil
# adalah nomor TIRUAN berawalan 9999, dan aplikasi MEMPERINGATKANNYA di log saat
# start supaya keadaan itu tidak lolos tanpa disadari.
#
# JANGAN pernah mengisi nilai nyata di berkas ini — ia ikut ter-commit. Isilah di
# backend/.env yang diabaikan git.
VIRTUAL_ACCOUNT_ADAPTER=tiruan
VIRTUAL_ACCOUNT_PENGGUNA=
VIRTUAL_ACCOUNT_SANDI=
# Opsional; nilai baku 30s.
# VIRTUAL_ACCOUNT_BATAS_WAKTU=30s

# ── Persetujuan / Akseptasi (AcceptationLOD) ─────────────────────────────────
# Nama Komite Akseptasi yang terisi untuk adjustment Non-MBU yang komitenya beranggota
# dua atau lebih (AcceptationLOD_PreAct langkah 15). Pega menuliskannya di dalam rule:
# BAMBANGSETIADJIGUNAWAN. Kosong = anggota komite terakhir yang menyetujui.
AKSEPTASI_KOMITE_BERJENJANG=

# ── Dokumen penunjang klaim ──────────────────────────────────────────────────
# Dua layanan, dua alamat. Dipakai layar Input Req Protection dan Inbox Accept
# Open Protection untuk mengunggah "File Penunjang" sebuah klaim.
#
# KEDUANYA SUDAH PUNYA NILAI BAKU, disalin dari rule Connect REST Pega, sehingga
# unggah dokumen bekerja tanpa mengisi apa pun di sini. Yang di bawah hanya perlu
# diisi bila lingkungan ini memakai alamat LAIN — staging, misalnya.
#
# Kenapa tidak di POOLDATA.GCNM_CONNECT_REST seperti alamat HCQ: registri itu
# diperiksa langsung pada 2026-09-26 dan TIDAK punya baris untuk kedua layanan ini.
# Begitu DBA menambahkannya, nilai ini pindah ke sana dan kedua variabel dicabut.

# Pangkal layanan PENYIMPANAN, TANPA jalur /api/v1/upload.
# Baku: rule Connect REST UploadDokumenPNC.
# Kosong = unggah dokumen tidak aktif; aplikasi tetap hidup penuh dan layar tetap
# terbuka, hanya setiap unggahan ditolak dengan pesan yang menyebut sebabnya.
# PENYIMPANAN_DOKUMEN_ALAMAT=

# Pangkal layanan KONVERSI GAMBAR, TANPA jalur /convert-avif.
# Baku: rule Connect REST KonversiAvif.
#
# PERHATIAN — bakunya memakai http:// polos, apa adanya dari rule Pega. Isi berkas,
# termasuk dokumen nasabah, melintas TANPA enkripsi dan TANPA otentikasi. Isi
# variabel ini dengan alamat https:// begitu layanannya menyediakannya.
#
# Kosong = unggah PNG, JPG, JPEG, dan PDF ditolak; berkas lain tetap dapat diunggah.
# KONVERSI_GAMBAR_ALAMAT=

# Lewati konversi AVIF sementara (keputusan Work Owner 2026-09-30): PNG, JPG, JPEG,
# dan PDF diunggah apa adanya dengan ekstensi aslinya. Kosong/false = konversi berjalan.
# KONVERSI_GAMBAR_LEWATI=ya

# Kode akses terdaftar untuk folder penyimpanan aplikasi ini (dikirim sebagai KodeString).
# Diminta ke tim pemilik layanan penyimpanan dokumen. Kosong = token sekali pakai
# (GET_TOKEN_STORAGE). RAHASIA — jangan di-commit.
# PENYIMPANAN_DOKUMEN_KODE_AKSES=

# Opsional; nilai baku 60s untuk KEDUANYA — lebih panjang dari 30s pemanggilan
# biasa karena muatannya membawa berkas.
# PENYIMPANAN_DOKUMEN_BATAS_WAKTU=60s

# ---------------------------------------------------------------------------
# Surel keluar — peringatan kegagalan pendaftaran rekening ke Kasir
# ---------------------------------------------------------------------------
# Menggantikan activity SendEmailAlertRekening. Dipicu HANYA bila Kasir menjawab
# ResponseCode "9", persis seperti prasyarat rule lama — tidak ada pemicu tambahan.
#
# PENERIMANYA TIM IT, bukan operator yang memutuskan (keputusan Work Owner 2026-09-17).
# Rule lama mengirimnya ke operator yang sedang masuk lewat POOLDATA.MST_USER_TEKNIK;
# jalur itu belum dapat dipakai karena pemetaan identitas HCC/HCQ ke OPERATOR_ID belum
# ditetapkan (ADR-0024 pertanyaan terbuka no. 4). Dicatat di keputusan-implementasi.md.
#
# Boleh diisi lebih dari satu alamat, dipisah koma.
#
# Selama belum lengkap, aplikasi tetap berjalan penuh dan hanya melewatkan pengiriman
# surel. Aplikasi MEMPERINGATKANNYA di log saat start.
#
# SMTP_USER dan SMTP_PASSWORD boleh kosong bila relay menerima pengirim dari jaringan
# tepercaya tanpa autentikasi. Bila diisi, kredensialnya HANYA dikirim setelah STARTTLS
# berhasil — penolakannya ada di kode, bukan di konfigurasi.
#
# JANGAN pernah mengisi nilai nyata di berkas ini — ia ikut ter-commit.
SMTP_HOST=
SMTP_PORT=
SMTP_DARI=
SMTP_PENERIMA_PERINGATAN=
SMTP_USER=
SMTP_PASSWORD=
# Opsional; nilai baku 20s.
# SMTP_BATAS_WAKTU=20s

# ── Konversi Coverage (MENU_ID 87) ───────────────────────────────────────────
# Koneksi dan daftar polis di bawah dipakai BERSAMA oleh Konversi Object Item Fire
# (MENU_ID 88): PropertyItemList polis Fire LIVE → T_PROPERTYITEMLIST TEST.
# dan Konversi Coins (MENU_ID 89): CoinsList JSON_POLIS.DATA_JSONBLOB LIVE → T_COINSLIST TEST.
# Alat bantu data uji: membaca dokumen coverage polis (BLOB JSON) dari basis data
# LIVE, lalu menulis ke basis data TEST:
#
#   T_ANEKALIST.COVERAGELIST    -> T_COVERAGELIST_ANEKA  + T_SPREADINGLIST
#   T_CARGOLIST.COVERAGEDATA    -> T_COVERAGELIST_CARGO  + T_SPREADINGLIST
#   T_PROPERTYLIST.COVERAGELIST -> T_COVERAGELIST_FIRE   + T_SPREADINGLIST
#   T_PERSONLIST.COVERAGEDATA   -> T_COVERAGELIST_PERSON + T_SPREADINGLIST
#
# sekaligus menyalin kolom BLOB tersebut ke baris objek yang sama di TEST.
#
# LIVE HANYA DIBACA (transaksi READ ONLY). Aplikasi MENOLAK menjalankan konversi bila
# LIVE dan TEST menunjuk host, port, service, dan pengguna yang sama.
#
# Koneksi baru dibuka saat konversi pertama kali dijalankan dari menu, bukan saat
# aplikasi start — LIVE yang tidak terjangkau tidak menghentikan aplikasi.
#
# JANGAN pernah mengisi nilai nyata di berkas .env.example — ia ikut ter-commit.
KONVERSI_LIVE_HOST=
KONVERSI_LIVE_PORT=1521
KONVERSI_LIVE_SERVICE=
KONVERSI_LIVE_PENGGUNA=
KONVERSI_LIVE_SANDI=

KONVERSI_TEST_HOST=
KONVERSI_TEST_PORT=1521
KONVERSI_TEST_SERVICE=
KONVERSI_TEST_PENGGUNA=
KONVERSI_TEST_SANDI=

# Daftar nomor polis bawaan, mengisi kotak di layar. Pisahkan dengan koma.
# Boleh dikosongkan dan diisi langsung di layar. Seluruh versi (PRODKE) ikut dikonversi.
# Contoh: KONVERSI_POLIS=NOPOLIS1,NOPOLIS2,NOPOLIS3
KONVERSI_POLIS=

# ── Proxy keluar ──────────────────────────────────────────────────────────────
# Bila mesin memasang HTTP_PROXY/HTTPS_PROXY, layanan INTERNAL dari
# POOLDATA.GCNM_CONNECT_REST (status premi, Kasir, arsip, ...) harus dikecualikan:
# proxy Squid kantor menolaknya dengan HTTP 403, dan akseptasi gagal dengan pesan
# "The premium status could not be checked". Isi dengan host internal, dipisah koma.
# Variabel yang sudah ada di lingkungan sistem TIDAK ditimpa berkas ini.
# NO_PROXY=localhost,127.0.0.1,<host-layanan-internal>

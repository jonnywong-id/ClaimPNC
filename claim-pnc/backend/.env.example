# Konfigurasi Claim PNC — salin menjadi berkas .env di folder backend/, lalu isi.
#
# JANGAN pernah mengisi nilai rahasia di berkas contoh ini dan jangan pernah
# mengirimkannya ke version control. Rahasia hanya masuk lewat berkas .env atau
# variabel lingkungan proses (ADR-0025).
#
# Nilai yang sudah ada di lingkungan proses MENANG atas isi .env, sehingga satu
# perintah dapat menimpa satu nilai tanpa menyunting berkas ini.

# ── Aplikasi ─────────────────────────────────────────────────────────────────
# development | test | staging | production
APP_ENV=development
APP_ALAMAT=:8080

# fake = provider identitas tiruan; MENOLAK berjalan bila APP_ENV=production
# hcq  = jalur nyata: API HCC/HCQ untuk karyawan, lalu POOLDATA.M_LOGIN_PNC untuk
#        non-karyawan. Menuntut PENYIMPANAN=oracle.
IDENTITAS_ADAPTER=fake

# oracle = penyimpanan sesungguhnya
# Bila TIDAK disetel: memori di development/test, oracle di staging/production.
#
# PENYIMPANAN=memori + IDENTITAS_ADAPTER=hcq adalah kombinasi yang sah dan berguna:
# identitas diverifikasi SUNGGUHAN ke HCC/HCQ dan POOLDATA.M_LOGIN_PNC, sementara sesi
# disimpan di memori. Dipakai untuk menguji integrasi sebelum migrasi 0001 dijalankan.
# Yang hilang: sesi tidak tahan restart dan tidak dikenali instans lain.
# memori = penyimpanan di memori; MENOLAK berjalan bila APP_ENV=production
PENYIMPANAN=memori

# Masa berlaku sesi. Bawaan 60m — batas atas rentang 30–60 menit pada
# docs/Steering/11-SECURITY.md §2.2. Nilai final menunggu Work Owner + Security.
SESI_MASA_BERLAKU=60m

# ── Autentikasi HCC/HCQ ──────────────────────────────────────────────────────
# Basic Auth ke API HCQ. Ini kredensial APLIKASI, bukan kredensial pengguna.
#
# Alamat endpoint-nya TIDAK di sini: ia dibaca dari POOLDATA.GCNM_CONNECT_REST
#   SELECT servicename FROM POOLDATA.GCNM_CONNECT_REST
#    WHERE app = <portal_alias> AND typeservice = 'HCQ-LOGIN'
# sehingga perpindahan endpoint menjadi perubahan data oleh DBA, bukan rilis ulang.
HCQ_LOGIN_USER=
HCQ_LOGIN_PASSWORD=
HCQ_LOGIN_BATAS_WAKTU=15s

# ── Portal entitas (ADR-0030) ────────────────────────────────────────────────
# Satu database per entitas. Alias portal ditemukan dengan memindai variabel
# berpola POOLDATA_<ALIAS>_HOST — daftar portal TIDAK ditulis di kode. Menambah
# entitas cukup menambah blok lima baris di bawah ini.
#
# Alias mengikuti kolom PORTAL_ALIAS pada POOLDATA.M_PORTAL_PNC.
#
# PORTAL_UTAMA adalah portal yang basis datanya melayani hal-hal yang dibutuhkan
# SEBELUM pengguna memilih portal: daftar portal, alamat layanan HCQ, login
# non-karyawan, dan tabel sesi. Ia satu-satunya yang WAJIB lengkap; portal lain
# boleh menyusul, dan yang belum lengkap ditandai "belum tersedia" di aplikasi.
PORTAL_UTAMA=ASM

# 202600101 — ASURANSI SINAR MAS
POOLDATA_ASM_HOST=
POOLDATA_ASM_PORT=1521
POOLDATA_ASM_SERVICE=
POOLDATA_ASM_PENGGUNA=
POOLDATA_ASM_SANDI=

# 202600102 — ASURANSI SIMAS INSURTECH
POOLDATA_ASI_HOST=
POOLDATA_ASI_PORT=1521
POOLDATA_ASI_SERVICE=
POOLDATA_ASI_PENGGUNA=
POOLDATA_ASI_SANDI=

# 202600103 — SINARMAS ASURANSI SYARIAH
POOLDATA_SMAS_HOST=
POOLDATA_SMAS_PORT=1521
POOLDATA_SMAS_SERVICE=
POOLDATA_SMAS_PENGGUNA=
POOLDATA_SMAS_SANDI=

# 202600104 — SINARMAS INSURANCE
POOLDATA_SMI_HOST=
POOLDATA_SMI_PORT=1521
POOLDATA_SMI_SERVICE=
POOLDATA_SMI_PENGGUNA=
POOLDATA_SMI_SANDI=

# 202600105 — SINARMAS PENJAMINAN KREDIT
POOLDATA_SPK_HOST=
POOLDATA_SPK_PORT=1521
POOLDATA_SPK_SERVICE=
POOLDATA_SPK_PENGGUNA=
POOLDATA_SPK_SANDI=

# 202600106 — SINARMAS PENJAMINAN KREDIT SYARIAH
POOLDATA_SPKS_HOST=
POOLDATA_SPKS_PORT=1521
POOLDATA_SPKS_SERVICE=
POOLDATA_SPKS_PENGGUNA=
POOLDATA_SPKS_SANDI=

# Batas pool per portal. Opsional; nilai baku 20 / 5 / 30m.
# Selama masa paralel basis data dibagi dengan Pega (ADR-0004); menaikkan nilai ini
# harus dibicarakan dengan DBA lebih dulu.
# POOLDATA_ASM_MAKS_KONEKSI=20
# POOLDATA_ASM_MAKS_IDLE=5
# POOLDATA_ASM_UMUR_KONEKSI=30m

# ── Koneksi kedua tiap portal — menggantikan DB Link (R-03) ──────────────────
# Sejumlah kueri laporan membaca basis data LAIN lewat DB Link @ASMD:
#
#   GENERAL.HRD_LBR                 kalender libur, dasar perhitungan TAT
#   DATAMINING.GET_WORKING_HOURS    jam kerja, dasar perhitungan TAT
#   GENERAL.LST_MITRA               master mitra, penyaring laporan Mitra
#
# D-25 mengganti seluruh DB Link dengan pemanggilan API, dan API penggantinya belum
# ada (R-03). Keputusan Work Owner 2026-09-24:
#
#   yang berupa SUB-QUERY    tetap memakai DB Link apa adanya
#   selain itu               memakai KONEKSI LANGSUNG ke basis datanya
#
# Blok di bawah inilah koneksi langsung itu. Aliasnya mengikuti PORTAL_ALIAS yang
# sama dengan blok POOLDATA di atas — koneksi kedua selalu MILIK sebuah portal, dan
# koneksi milik satu badan hukum tidak pernah melayani badan hukum lain (R-20).
#
# SELURUHNYA OPSIONAL. Portal yang belum diisi tetap berjalan penuh; yang hilang
# hanyalah kolom laporan yang membutuhkannya, dan kolom itu dikosongkan serta
# ditandai di layar — bukan diisi angka yang tampak benar.
#
# Aplikasi MEMPERINGATKANNYA di log saat start supaya keadaan itu tidak lolos tanpa
# disadari.
#
# JANGAN pernah mengisi nilai nyata di berkas ini — ia ikut ter-commit.

# 202600101 — ASURANSI SINAR MAS
ANEKA_ASM_HOST=
ANEKA_ASM_PORT=1521
ANEKA_ASM_SERVICE=
ANEKA_ASM_PENGGUNA=
ANEKA_ASM_SANDI=

# 202600102 — ASURANSI SIMAS INSURTECH
ANEKA_ASI_HOST=
ANEKA_ASI_PORT=1521
ANEKA_ASI_SERVICE=
ANEKA_ASI_PENGGUNA=
ANEKA_ASI_SANDI=

# 202600103 — SINARMAS ASURANSI SYARIAH
ANEKA_SMAS_HOST=
ANEKA_SMAS_PORT=1521
ANEKA_SMAS_SERVICE=
ANEKA_SMAS_PENGGUNA=
ANEKA_SMAS_SANDI=

# 202600104 — SINARMAS INSURANCE
ANEKA_SMI_HOST=
ANEKA_SMI_PORT=1521
ANEKA_SMI_SERVICE=
ANEKA_SMI_PENGGUNA=
ANEKA_SMI_SANDI=

# 202600105 — SINARMAS PENJAMINAN KREDIT
ANEKA_SPK_HOST=
ANEKA_SPK_PORT=1521
ANEKA_SPK_SERVICE=
ANEKA_SPK_PENGGUNA=
ANEKA_SPK_SANDI=

# 202600106 — SINARMAS PENJAMINAN KREDIT SYARIAH
ANEKA_SPKS_HOST=
ANEKA_SPKS_PORT=1521
ANEKA_SPKS_SERVICE=
ANEKA_SPKS_PENGGUNA=
ANEKA_SPKS_SANDI=

# Batas pool koneksi kedua. Opsional; nilai baku sama dengan portal, 20 / 5 / 30m.
# ANEKA_ASM_MAKS_KONEKSI=20
# ANEKA_ASM_MAKS_IDLE=5
# ANEKA_ASM_UMUR_KONEKSI=30m

# ---------------------------------------------------------------------------
# Sistem Kasir — dipakai modul Master Rekening
# ---------------------------------------------------------------------------
# Dipanggil saat komite MENYETUJUI sebuah rekening, dan hanya untuk portal ASM dan
# SIMASNET. Menggantikan dua Connect-REST sistem lama:
#   InjectDataRekeningToKasir        -> KASIR_URL_DAFTAR_REKENING
#   UpdateSearchDataRekeningToKasir  -> KASIR_URL_PERBARUI_REKENING
#
# BELUM TERISI DAN ITU DISENGAJA. Alamat dan kredensialnya TIDAK ada di dalam export
# rule — keduanya berada di konfigurasi instans Pega, yang tidak ikut terekspor.
# Menunggu Tim Infra.
#
# Selama kosong, aplikasi tetap berjalan penuh: rekening tetap dapat diajukan dan
# diputuskan komite, hanya langkah pendaftaran ke Kasir yang dilewati. Aplikasi
# MEMPERINGATKANNYA di log saat start supaya keadaan itu tidak lolos tanpa disadari.
#
# JANGAN pernah mengisi nilai nyata di berkas ini — ia ikut ter-commit. Isilah di
# backend/.env yang diabaikan git.
KASIR_URL_DAFTAR_REKENING=
KASIR_URL_PERBARUI_REKENING=
KASIR_USER=
KASIR_PASSWORD=
# Opsional; nilai baku 30s.
# KASIR_BATAS_WAKTU=30s

# ---------------------------------------------------------------------------
# Surel keluar — peringatan kegagalan pendaftaran rekening ke Kasir
# ---------------------------------------------------------------------------
# Menggantikan activity SendEmailAlertRekening. Dipicu HANYA bila Kasir menjawab
# ResponseCode "9", persis seperti prasyarat rule lama — tidak ada pemicu tambahan.
#
# PENERIMANYA TIM IT, bukan operator yang memutuskan (keputusan Work Owner 2026-09-17).
# Rule lama mengirimnya ke operator yang sedang masuk lewat POOLDATA.MST_USER_TEKNIK;
# jalur itu belum dapat dipakai karena pemetaan identitas HCC/HCQ ke OPERATOR_ID belum
# ditetapkan (ADR-0024 pertanyaan terbuka no. 4). Dicatat di keputusan-implementasi.md.
#
# Boleh diisi lebih dari satu alamat, dipisah koma.
#
# Selama belum lengkap, aplikasi tetap berjalan penuh dan hanya melewatkan pengiriman
# surel. Aplikasi MEMPERINGATKANNYA di log saat start.
#
# SMTP_USER dan SMTP_PASSWORD boleh kosong bila relay menerima pengirim dari jaringan
# tepercaya tanpa autentikasi. Bila diisi, kredensialnya HANYA dikirim setelah STARTTLS
# berhasil — penolakannya ada di kode, bukan di konfigurasi.
#
# JANGAN pernah mengisi nilai nyata di berkas ini — ia ikut ter-commit.
SMTP_HOST=
SMTP_PORT=
SMTP_DARI=
SMTP_PENERIMA_PERINGATAN=
SMTP_USER=
SMTP_PASSWORD=
# Opsional; nilai baku 20s.
# SMTP_BATAS_WAKTU=20s

# Konfigurasi Claim PNC — salin menjadi berkas .env di folder backend/, lalu isi.
#
# JANGAN pernah mengisi nilai rahasia di berkas contoh ini dan jangan pernah
# mengirimkannya ke version control. Rahasia hanya masuk lewat berkas .env atau
# variabel lingkungan proses (ADR-0025).
#
# Nilai yang sudah ada di lingkungan proses MENANG atas isi .env, sehingga satu
# perintah dapat menimpa satu nilai tanpa menyunting berkas ini.

# ── Aplikasi ─────────────────────────────────────────────────────────────────
# development | test | staging | production
APP_ENV=development
APP_ALAMAT=:8080

# fake = provider identitas tiruan; MENOLAK berjalan bila APP_ENV=production
# hcq  = jalur nyata: API HCC/HCQ untuk karyawan, lalu POOLDATA.M_LOGIN_PNC untuk
#        non-karyawan. Menuntut PENYIMPANAN=oracle.
IDENTITAS_ADAPTER=fake

# oracle = penyimpanan sesungguhnya
# Bila TIDAK disetel: memori di development/test, oracle di staging/production.
#
# PENYIMPANAN=memori + IDENTITAS_ADAPTER=hcq adalah kombinasi yang sah dan berguna:
# identitas diverifikasi SUNGGUHAN ke HCC/HCQ dan POOLDATA.M_LOGIN_PNC, sementara sesi
# disimpan di memori. Dipakai untuk menguji integrasi sebelum migrasi 0001 dijalankan.
# Yang hilang: sesi tidak tahan restart dan tidak dikenali instans lain.
# memori = penyimpanan di memori; MENOLAK berjalan bila APP_ENV=production
PENYIMPANAN=memori

# Masa berlaku sesi. Bawaan 60m — batas atas rentang 30–60 menit pada
# docs/Steering/11-SECURITY.md §2.2. Nilai final menunggu Work Owner + Security.
SESI_MASA_BERLAKU=60m

# ── Autentikasi HCC/HCQ ──────────────────────────────────────────────────────
# Basic Auth ke API HCQ. Ini kredensial APLIKASI, bukan kredensial pengguna.
#
# Alamat endpoint-nya TIDAK di sini: ia dibaca dari POOLDATA.GCNM_CONNECT_REST
#   SELECT servicename FROM POOLDATA.GCNM_CONNECT_REST
#    WHERE app = <portal_alias> AND typeservice = 'HCQ-LOGIN'
# sehingga perpindahan endpoint menjadi perubahan data oleh DBA, bukan rilis ulang.
HCQ_LOGIN_USER=
HCQ_LOGIN_PASSWORD=
HCQ_LOGIN_BATAS_WAKTU=15s

# ── Portal entitas (ADR-0030) ────────────────────────────────────────────────
# Satu database per entitas. Alias portal ditemukan dengan memindai variabel
# berpola POOLDATA_<ALIAS>_HOST — daftar portal TIDAK ditulis di kode. Menambah
# entitas cukup menambah blok lima baris di bawah ini.
#
# Alias mengikuti kolom PORTAL_ALIAS pada POOLDATA.M_PORTAL_PNC.
#
# PORTAL_UTAMA adalah portal yang basis datanya melayani hal-hal yang dibutuhkan
# SEBELUM pengguna memilih portal: daftar portal, alamat layanan HCQ, login
# non-karyawan, dan tabel sesi. Ia satu-satunya yang WAJIB lengkap; portal lain
# boleh menyusul, dan yang belum lengkap ditandai "belum tersedia" di aplikasi.
PORTAL_UTAMA=ASM

# 202600101 — ASURANSI SINAR MAS
POOLDATA_ASM_HOST=
POOLDATA_ASM_PORT=1521
POOLDATA_ASM_SERVICE=
POOLDATA_ASM_PENGGUNA=
POOLDATA_ASM_SANDI=

# 202600102 — ASURANSI SIMAS INSURTECH
POOLDATA_ASI_HOST=
POOLDATA_ASI_PORT=1521
POOLDATA_ASI_SERVICE=
POOLDATA_ASI_PENGGUNA=
POOLDATA_ASI_SANDI=

# 202600103 — SINARMAS ASURANSI SYARIAH
POOLDATA_SMAS_HOST=
POOLDATA_SMAS_PORT=1521
POOLDATA_SMAS_SERVICE=
POOLDATA_SMAS_PENGGUNA=
POOLDATA_SMAS_SANDI=

# 202600104 — SINARMAS INSURANCE
POOLDATA_SMI_HOST=
POOLDATA_SMI_PORT=1521
POOLDATA_SMI_SERVICE=
POOLDATA_SMI_PENGGUNA=
POOLDATA_SMI_SANDI=

# 202600105 — SINARMAS PENJAMINAN KREDIT
POOLDATA_SPK_HOST=
POOLDATA_SPK_PORT=1521
POOLDATA_SPK_SERVICE=
POOLDATA_SPK_PENGGUNA=
POOLDATA_SPK_SANDI=

# 202600106 — SINARMAS PENJAMINAN KREDIT SYARIAH
POOLDATA_SPKS_HOST=
POOLDATA_SPKS_PORT=1521
POOLDATA_SPKS_SERVICE=
POOLDATA_SPKS_PENGGUNA=
POOLDATA_SPKS_SANDI=

# Batas pool per portal. Opsional; nilai baku 20 / 5 / 30m.
# Selama masa paralel basis data dibagi dengan Pega (ADR-0004); menaikkan nilai ini
# harus dibicarakan dengan DBA lebih dulu.
# POOLDATA_ASM_MAKS_KONEKSI=20
# POOLDATA_ASM_MAKS_IDLE=5
# POOLDATA_ASM_UMUR_KONEKSI=30m

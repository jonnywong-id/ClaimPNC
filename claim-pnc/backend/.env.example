POOLDATA_SPKS_PORT=1521
POOLDATA_SPKS_SERVICE=
POOLDATA_SPKS_PENGGUNA=
POOLDATA_SPKS_SANDI=

# Batas pool per portal. Opsional; nilai baku 20 / 5 / 30m.
# Selama masa paralel basis data dibagi dengan Pega (ADR-0004); menaikkan nilai ini
# harus dibicarakan dengan DBA lebih dulu.
# POOLDATA_ASM_MAKS_KONEKSI=20
# POOLDATA_ASM_MAKS_IDLE=5
# POOLDATA_ASM_UMUR_KONEKSI=30m

# ── Koneksi kedua tiap portal — menggantikan DB Link (R-03) ──────────────────
# Sejumlah kueri laporan membaca basis data LAIN lewat DB Link @ASMD:
#
#   GENERAL.HRD_LBR                 kalender libur, dasar perhitungan TAT
#   DATAMINING.GET_WORKING_HOURS    jam kerja, dasar perhitungan TAT
#   GENERAL.LST_MITRA               master mitra, penyaring laporan Mitra
#
# D-25 mengganti seluruh DB Link dengan pemanggilan API, dan API penggantinya belum
# ada (R-03). Keputusan Work Owner 2026-09-24:
#
#   yang berupa SUB-QUERY    tetap memakai DB Link apa adanya
#   selain itu               memakai KONEKSI LANGSUNG ke basis datanya
#
# Blok di bawah inilah koneksi langsung itu. Aliasnya mengikuti PORTAL_ALIAS yang
# sama dengan blok POOLDATA di atas — koneksi kedua selalu MILIK sebuah portal, dan
# koneksi milik satu badan hukum tidak pernah melayani badan hukum lain (R-20).
#
# SELURUHNYA OPSIONAL. Portal yang belum diisi tetap berjalan penuh; yang hilang
# hanyalah kolom laporan yang membutuhkannya, dan kolom itu dikosongkan serta
# ditandai di layar — bukan diisi angka yang tampak benar.
#
# Aplikasi MEMPERINGATKANNYA di log saat start supaya keadaan itu tidak lolos tanpa
# disadari.
#
# JANGAN pernah mengisi nilai nyata di berkas ini — ia ikut ter-commit.

# 202600101 — ASURANSI SINAR MAS
ANEKA_ASM_HOST=
ANEKA_ASM_PORT=1521
ANEKA_ASM_SERVICE=
ANEKA_ASM_PENGGUNA=
ANEKA_ASM_SANDI=

# 202600102 — ASURANSI SIMAS INSURTECH
ANEKA_ASI_HOST=
ANEKA_ASI_PORT=1521
ANEKA_ASI_SERVICE=
ANEKA_ASI_PENGGUNA=
ANEKA_ASI_SANDI=

# 202600103 — SINARMAS ASURANSI SYARIAH
ANEKA_SMAS_HOST=
ANEKA_SMAS_PORT=1521
ANEKA_SMAS_SERVICE=
ANEKA_SMAS_PENGGUNA=
ANEKA_SMAS_SANDI=

# 202600104 — SINARMAS INSURANCE
ANEKA_SMI_HOST=

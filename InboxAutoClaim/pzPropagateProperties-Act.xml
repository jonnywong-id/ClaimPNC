casetype.putString("pyClassName", myStepPage.getClassName());
casetype.putString("pyPurpose", "pyDefault");

ParameterPage pp = new ParameterPage();
pp.putString("pyCaseTypePurpose", "PROPAGATE");
String childPageName = tools.getParamValue("workPageName");
String childClass = tools.findPage(childPageName).getClassName();
String paramName = "ChildPage" + com.pegarules.generated.pega_processarchitect_pzprocessarchitect.pzPageNameClean(childClass);
pp.putString("workPageClass", childClass);
pp.putString(paramName, childPageName);
try {
	tools.doAction(casetype, null, pp);
         String errorMessage = pp.getString("ErrorMessage");
   
	if("CaseTypeIsAbstract".equals(errorMessage))
	{
		tools.getStepStatus().backoutWorst();
		return true;
	}
} catch (com.pega.pegarules.pub.generator.RuleNotFoundException e) {

<pyStepsJavaSource>ClipboardPage targetPage;
String referenceProperty;
if(!"Removed".equals(myStepPage.getString("pxChangeType"))){
	targetPage = tools.findPage(tools.getParamValue("CurrentEmbedPageName"));
    referenceProperty = "pxCurrentReference";
} else {
	targetPage = tools.findPage(tools.getParamValue("CompareWithEmbedPageName"));
    referenceProperty = "pxPreviousReference";
}
ClipboardProperty currentProperty = targetPage.getProperty(myStepPage.getString(referenceProperty));
if(!currentProperty.isPage()){
  tools.putParamValue("EmbedPageName", currentProperty.getParentPage().getReference());
} else {
  tools.putParamValue("EmbedPageName", currentProperty.getReference()); 
}</pyStepsJavaSource>

<pyBrowseSQL>SELECT B.* 
FROM (SELECT A.*, ROWNUM RN 
      FROM (SELECT A.AGENID AS "CaseID",
       A.BATCH AS "CauseOfLoss",
       A.USERINPUT AS "AnaylstRemarks",
       B.NAMA_PENERIMA AS "AlasanTerlambat",
       (SELECT COUNT (NOPOLIS)
          FROM POOLDATA.TMP_BATCH_CLAIM_KREDIT
         WHERE A.BATCH = BATCH AND A.AGENID = AGENID)
          AS "ChronologicalOfIncodent",
       (SELECT COUNT (NOPOLIS)
          FROM POOLDATA.TMP_BATCH_CLAIM_KREDIT
         WHERE     A.BATCH = BATCH
               AND A.AGENID = AGENID
               AND TMP_MESSAGE IS NOT NULL)
          AS "City",
       (SELECT COUNT (NOPOLIS)
          FROM POOLDATA.TMP_BATCH_CLAIM_KREDIT
         WHERE     A.BATCH = BATCH
               AND A.AGENID = AGENID
               AND TMP_MESSAGE = 'Sukses Klaim')
          AS "CityID",
       (SELECT COUNT (NOPOLIS)
          FROM POOLDATA.TMP_BATCH_CLAIM_KREDIT
         WHERE     A.BATCH = BATCH
               AND A.AGENID = AGENID
               AND TMP_MESSAGE != 'Sukses Klaim'
               AND TMP_MESSAGE IS NOT NULL)
          AS "ClaimID"
  FROM POOLDATA.TMP_BATCH_CLAIM_KREDIT A, POOLDATA.M_AUTO_CLAIM_PNC B
 WHERE A.AGENID = B.INISIALID
 {ASIS:TemporaryInboxKasirClaimKredit.CaseID}
GROUP BY A.BATCH, A.AGENID, A.USERINPUT,B.NAMA_PENERIMA,TO_DATE(TO_CHAR(A.TGLPROSES,'dd/mm/yyyy'),'dd/mm/yyyy')
ORDER BY A.BATCH DESC ) A 
) B
WHERE RN&gt;={ASIS:Pagination.FirstRow} AND RN&lt;={ASIS:Pagination.LastRow}</pyBrowseSQL>

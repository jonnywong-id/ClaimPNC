<pyStepsJavaSource>if(tools.findPageByHandle(tools.getParamValue("WorkInskey")) != null){
	ClipboardPage pyWorkPage=tools.findPageByHandle(tools.getParamValue("WorkInskey"));
	try {
		    
		//BUG-349859:check for attachment fields which are need to be refreshed 
		ClipboardProperty fields = pyWorkPage.getIfPresent(".pyFields");
		if(fields!=null){
      tools.getParameterPage().putString("LinkRefFrom",tools.getParamValue("WorkInskey"));
		  tools.getParameterPage().putString("CaseID",pyWorkPage.getString("pxInsName"));
	  	tools.getParameterPage().putString("ClassName",pyWorkPage.getString("pxObjClass"));
			java.util.Iterator iter_fields=fields.iterator();
			ClipboardProperty thisField;
			ClipboardPage thisFieldPage;
      String streamTypAttachment="Attachment";
			while(iter_fields.hasNext()){
				thisField = (ClipboardProperty)iter_fields.next();
				thisFieldPage = thisField.getPageValue();
        //Scan through attachment fields and remove corresponding datapage
				if(streamTypAttachment.equals(thisFieldPage.getString("pyStreamName"))){
					tools.getParameterPage().putString("AttachmentCategory",thisFieldPage.getString("pyCategoryName"));
					tools.getParameterPage().putString("AttachmentFieldName",thisFieldPage.getString("pyPropertyName"));
          //remove the datapage to get latest
					tools.removeDataPage("D_AttachmentFieldInfo",tools.getParameterPage());              
				}
			}
		}
	}catch(Exception e){
  }
}</pyStepsJavaSource>

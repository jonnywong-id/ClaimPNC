<pyBrowseSQL>SELECT AGENID as "THEINSURED", NOPOLIS,  case when idpega like '%PNC%' then substr(IDPEGA,20,30) 
else idpega end as "IDPEGA", ACCEPTNO as "EDMNO", NILAIKLAIM as "BRANCHCODE" , NOASURANSI as "CLIENTID", TMP_MESSAGE as "FLAGEDMBATAL",
(select currency from POOLDATA.CURRENCY where id = A.CURRENCY ) as "STATUSBUSINESS",
(select no_ref_bank from gl.t_claim_asuransi_credit@asmd.sinarmas.co.id where no_aksep=a.acceptno) as "WARRANTYNO"
FROM POOLDATA.TMP_BATCH_CLAIM_KREDIT a
WHERE AGENID = {TempInputforreport.City}
AND BATCH = {ASIS:TempInputforreport.CityID}
{ASIS:TempInputforreport.CaseID}</pyBrowseSQL>

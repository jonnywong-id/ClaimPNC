<pyStepsJavaSource>// Set up list page. 
ClipboardPage primaryPage = tools.getPrimaryPage();
String listClassName = primaryPage.getString("pxObjClass");
ClassDefinition listClass = tools.getDatabase().getClassDef(listClassName);	

HashStringMap keys = new HashStringMap();
keys.putString("pxObjClass", listClassName);

List&lt;String&gt; keyList =  listClass.getKeyPropertyList();
for(int i=0;i&lt;keyList.size();i++) {
  String keyName = keyList.get(i);
  String keyValue = primaryPage.getString(keyName);
  keys.putString(keyName, keyValue);  
}

ClipboardPage tempPage = null;
try{
  tempPage = tools.getDatabase().open(keys,false);
}catch(	DatabaseException e){
  oLog.error("Unable to open object with keys:" +keys+ e.getMessage(), e);
}

if(tempPage != null) {    
  tools.getPrimaryPage().addMessage("InstanceAlreadyExists");
  tempPage.removeFromClipboard();
}</pyStepsJavaSource>

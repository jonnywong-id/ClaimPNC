<pyStepsJavaSource>ClipboardPage pgView = myStepPage;
ClipboardPage pg_CurrentPage = tools.findPage(myStepPage.getTopLevelPage().getString(".pzPageToDisplay"));
ParameterPage paramPage = tools.getParameterPage();
ClipboardPage pg_PagingParams = pgView.getProperty(".pyUI.pyUserInteractions.pyPagingParams").getPageValue();

ClipboardProperty cpContent = pgView.getProperty(".pyContent");
ClipboardPage pgContent = null;
if(cpContent!= null) pgContent = cpContent.getPageValue();
ClipboardPage pgPaging = cpContent.getProperty(".pyPaging").getPageValue();

String strPagingEnabled = pg_PagingParams.getString(".pyPagingEnabled");
if(strPagingEnabled != null &amp;&amp; strPagingEnabled.equals("true")) 
{
    String strPageIndex = pg_PagingParams.getString(".pyPageIndex");
	String strPagingWindow = pg_PagingParams.getString(".pyWindowSize");
	String strPageSize = pg_PagingParams.getString(".pyPageSize");
	if(strPageSize.equals("")) {
		pg_PagingParams.putString(".pyPageSize","50");
		strPageSize = "50";
	}
	
	String strTotalResultCount = pg_PagingParams.getString(".pyTotalResultCount");
	String pyReturnTotalResultCount = pg_PagingParams.getString(".pyReturnTotalResultCount");
  	if(StringUtils.isBlank(pyReturnTotalResultCount)) {
      pyReturnTotalResultCount = "true";
    }
  
	String strPagingMode = pg_PagingParams.getString(".pyPageMode");
	

	//Initialize paging parameters
	int nPageIndex = 1;
	int nPagingWindow = 10;
	int nPageSize = 50;
	int nTotalResultCount = 0;
	//Convert string format input parameters to integer data type
	try 
	{
		nPagingWindow = Integer.parseInt(strPagingWindow);

	}
	catch(NumberFormatException nfe) {}
	try 
	{
		nPageSize = Integer.parseInt(strPageSize);

	}
	catch(NumberFormatException nfe) {}
	if(!strPageIndex.equals("")) {
		try {
			nPageIndex = Integer.parseInt(strPageIndex);

		} catch(NumberFormatException nfe) {}
	}
	try 
	{
		nTotalResultCount = Integer.parseInt(strTotalResultCount);

	}
	catch(NumberFormatException nfe) {}
	
	if(pgView.getString(".pyListFlow").equals("true"))
	{
	nTotalResultCount = 0; // for previously saved reports
	}
	//This if condition will be true when a paging request comes for the first time 
	if(nPageIndex == 1) 
	{	
		if(strPagingMode != null &amp;&amp; strPagingMode.equalsIgnoreCase("numeric")) 
		{	//Set first page window max size
			pgContent.putString(".pyMaxRecords", (nPagingWindow * nPageSize)+"");

		}
		else 
		{	
			pgContent.putString(".pyMaxRecords", "0");

		}	

		pgPaging.putString(".pyReturnTotalResultCount", pyReturnTotalResultCount);

	}
	else 
	{	//This code is executed for rest of paging request other than the first time
		int modIndex = nPageIndex % nPagingWindow;
		boolean bPreviousChk = false;
		//Check if the user clicked on previous window
		if(modIndex == 0 &amp;&amp; ((nPageSize * nPageIndex) &lt; (nTotalResultCount)))
			bPreviousChk = true;

		//Check if the user clicked on next window
		boolean bNextChk = false;
		if(modIndex == 1 &amp;&amp; ((nPageIndex * nPageSize) &gt; (nPagingWindow * nPageSize)))
			bNextChk = true;

		//Check if the user entered only pageindex and no other parameters are defined
		boolean bPageIndexChk = false;
		if(nPageIndex &gt; 1 &amp;&amp; nTotalResultCount == 0)
			bPageIndexChk = true;

		//If any of the above conditions are satisfied then set returntotalcount variable to true with new maxrecords
		if(strPagingMode != null &amp;&amp; strPagingMode.equalsIgnoreCase("numeric") &amp;&amp; (bPreviousChk || bNextChk || bPageIndexChk))
		{

			int nMaxRecords = 0;
			if(bNextChk || bPageIndexChk)
				nMaxRecords = ((nPageIndex / nPagingWindow) + 1) * nPageSize * nPagingWindow;
			else
				nMaxRecords = ((nPageIndex / nPagingWindow)) * nPageSize * nPagingWindow;
			pgContent.putString(".pyMaxRecords", nMaxRecords+"");
//					pg_CurrentPage.putString(".pyReturnTotalResultCount", "true");
			pgPaging.putString(".pyReturnTotalResultCount", pyReturnTotalResultCount);
			

		}
		else 
		{

			if(bPageIndexChk ){

				pgContent.putString(".pyMaxRecords", "0");
				pgPaging.putString(".pyReturnTotalResultCount", pyReturnTotalResultCount);
				
			}
			else {

				int nMaxRecords = nPageIndex * nPageSize;
				pgContent.putString(".pyMaxRecords", nMaxRecords+"");
				pgPaging.putString(".pyReturnTotalResultCount", "false");

				
			}
		}
	}
	pgPaging.putString(".pyPageIndex", nPageIndex+"");
	pgPaging.putString(".pyPageSize", nPageSize+"");
	
	
}</pyStepsJavaSource>

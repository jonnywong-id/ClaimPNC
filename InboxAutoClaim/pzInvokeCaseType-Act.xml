<pyStepsJavaSource>String changeProp = myStepPage.getString("pyPropertyName");
if (!changeProp.startsWith(".")) changeProp = StringUtils.concat(StringUtils.ASIS, ".", changeProp);

String newVal = myStepPage.getString("pzNewValue");

/* See note at bottom */
String changePropHashKey = StringUtils.replaceAll(new String(StringUtils.pageNameClean(changeProp)), "_", "pz");
String oldValRef = StringUtils.concat(StringUtils.ASIS, ".pzCaseTypeValues(",changePropHashKey ,")");

tools.getPrimaryPage().putString(oldValRef, newVal);

/* Dear future,
 *
 * 	The StringUtils you see above is not Apache's StringUtils library or any other third-party library, but rather 
 * com.pega.pegarules.pub.util.StringUtils. The method pageNameClean replaces all non-alphanumeric characters in the 
 * string with underscores. In this case, it replaces the leading dot with an underscore, which is presumably why
 * there is a replaceAll that replaces it with a "pz" to make it look better, at least for properties that don't have
 * underscores in their names. Don't ask me why it's done this way. I didn't write it. The replacement of "_" with "pz"
 * is completely unnecessary. Unfortunately though, I can't change it, since it would break backward compatibility.
 *
 * 	- 2014
 */</pyStepsJavaSource>

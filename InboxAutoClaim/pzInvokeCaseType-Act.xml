<pyStepsJavaSource>// Call the activity to open the cover and call the case type, pass in the
// information we have on what changed
StringMap casetype = new HashStringMap();
casetype.putString("pxObjClass", "Rule-Obj-CaseType");
casetype.putString("pyClassName", myStepPage.getClassName());
casetype.putString("pyPurpose", "pyDefault");
try {
	tools.doAction(casetype, myStepPage, null);
	String errorMessage = tools.getParamValue("ErrorMessage");
	if (!errorMessage.equals(""))
	{
		tools.findPage("pyCaseTypeContextOut").removeFromClipboard();
		if (!( errorMessage.equals("CaseTypeNotSpecifiedOnCover") || errorMessage.equals("CaseTypeIsAbstract") ) )
		{
			// some weird error occurred!
			myStepPage.addMessage(errorMessage);
		}
		else
			// no casetype defined on the cover; not an error
			tools.putParamValue("ErrorMessage", "");
	}
} catch (com.pega.pegarules.pub.generator.RuleNotFoundException e) {
	// no casetype defined; not an error
	tools.getStepStatus().backoutWorst();
	tools.findPage("pyCaseTypeContextOut").removeFromClipboard();
}
</pyStepsJavaSource>

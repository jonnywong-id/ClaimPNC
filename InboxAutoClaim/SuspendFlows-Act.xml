<pyStepsJavaSource>String flowType = myStepPage.getString(".pxInvestigativeFlowType");
String errorMessage = myStepPage.getString(".pxErrorMessage");

if (flowType.equals(""))
{
  tools.getPrimaryPage().addMessage("pyCannotSuspendWorkObject");
  return false;
}

// First add the embedded flow page to the work object
String flowName = pega_procom_flow.AddFlow(tools, tools.getPrimaryPage(), flowType, flowType, "", true);

// Now start the flow
tools.putParamValue("ErrorMessage", errorMessage);
pega_procom_flow.StartFlow(flowName, tools.getPrimaryPage(), tools.getParameterPage());

// Avoid back-to-back processing
if (tools.findPage("newAssignPage") != null)
   tools.findPage("newAssignPage").removeFromClipboard();</pyStepsJavaSource>

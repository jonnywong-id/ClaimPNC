<pyRuleName>ASM-FW-GCNMFW-Work-PNC GCNM BrowseClaimSPK_detail_AutoClaim</pyRuleName>
<pyBrowseSQL>SELECT x.*
  FROM (SELECT z.*, ROWNUM rn
          FROM (select a.nopolis AS "City",TO_CHAR(a.TGLPROSES,'DD/MM/YYYY') AS "CityID",a.IDPEGA as "ClaimNo",
a.noakseptasi AS "CaseID", a.nilaiklaim AS "District", a.col_id AS "DistrictID", a.TMP_MESSAGE AS "Country",
(select CURRENCY FROM POOLDATa.CURRENCY where id = a.CURRENCY ) AS "CountryID"
FROM pooldata.TMP_BATCH_AUTO_CLAIM a
where a.inisialid = {TempSearchDetail.CityID}
and batch = {ASIS:TempSearchDetail.City}) z) x
 WHERE rn &gt;= {ASIS:Pagination.FirstRow}  AND rn &lt;=  {ASIS:Pagination.LastRow}</pyBrowseSQL>

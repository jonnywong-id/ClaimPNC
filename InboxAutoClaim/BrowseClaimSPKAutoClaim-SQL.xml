<pyBrowseSQL>SELECT B.* 
FROM (SELECT A.*, ROWNUM RN 
      FROM (SELECT a.INISIALID AS "CaseID",
       a.BATCH AS "CauseOfLoss",
       a.USERINPUT AS "AnaylstRemarks",
       b.NAMA_PENERIMA AS "AlasanTerlambat",
       (SELECT COUNT (NOPOLIS)
          FROM pooldata.TMP_BATCH_AUTO_CLAIM
         WHERE a.BATCH = batch AND a.INISIALID = INISIALID)
          AS "ChronologicalOfIncodent",
       (SELECT COUNT (NOPOLIS)
          FROM pooldata.TMP_BATCH_AUTO_CLAIM
         WHERE     a.BATCH = batch
               AND a.INISIALID = INISIALID
               AND TMP_MESSAGE IS NOT NULL)
          AS "City",
       (SELECT COUNT (NOPOLIS)
          FROM pooldata.TMP_BATCH_AUTO_CLAIM
         WHERE     a.BATCH = batch
               AND a.INISIALID = INISIALID
               AND TMP_MESSAGE = 'Sukses Klaim')
          AS "CityID",
       (SELECT COUNT (NOPOLIS)
          FROM pooldata.TMP_BATCH_AUTO_CLAIM
         WHERE     a.BATCH = batch
               AND a.INISIALID = INISIALID
               AND TMP_MESSAGE != 'Sukses Klaim'
               AND TMP_MESSAGE IS NOT NULL)
          AS "ClaimID"
  FROM pooldata.TMP_BATCH_AUTO_CLAIM a, POOLDATa.M_AUTO_CLAIM_PNC b
 WHERE a.INISIALID = b.INISIALID
{ASIS:TemporaryInboxKasirAutoClaim.CaseID}
GROUP BY a.BATCH, a.INISIALID, a.USERINPUT,b.NAMA_PENERIMA,to_date(to_char(a.TGLPROSES,'dd/mm/yyyy'),'dd/mm/yyyy')
ORDER BY BATCH DESC) A 
) B
WHERE RN&gt;={ASIS:Pagination.FirstRow} AND RN&lt;={ASIS:Pagination.LastRow}</pyBrowseSQL>
